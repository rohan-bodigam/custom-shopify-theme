    "weaves_read": {
      "type": "chapter-weaves-read",
      "blocks": {
        "weave_1": {
          "type": "weave_card",
          "settings": {
            "is_featured": true,
            "kicker": "West Bengal and beyond",
            "title": "MUL COTTON",
            "description": "Mul, or mulmul, is the name for a very fine, soft, lightweight cotton. The word is tied to the muslin tradition of Bengal, where the thinnest yarns were woven into cloth that felt almost weightless. A good mul cotton has a close, even weave, a gentle crinkle after washing and a drape that falls rather than stands. It breathes in heat and layers easily in cooler months. In the house, mul cotton is used for sarees with woven stripe borders, for relaxed kurtas and shirts, for co-ord sets and for children’s clothes, where softness matters most. Look for an even surface, a cloth that softens with wear and borders that are woven in, not printed on.",
            "quote": "Mul is the cloth you stop noticing, which is the point.",
            "link_label": "Shop Mul Cotton",
            "link_url": ""
          }
        },
        "weave_2": {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "Bishnupur, West Bengal",
            "title": "BALUCHARI",
            "description": "Baluchari is Bengal’s narrative silk. The pallu is woven as a set of framed scenes, often from the epics or from old court life, built up thread by thread with an extra weft on a jacquard loom. Bishnupur, a temple town known for its terracotta, is the centre of the craft today. Our Single Thread Baluchari keeps to one colour of figuring weft, so the pictures read like an engraving. Meenakari Baluchari adds small inlays of a second and third colour, the way enamel is set into gold.",
            "quote": "The pallu is a picture book you can wear.",
            "link_label": "Shop Baluchari",
            "link_url": ""
          }
        },
        "weave_3": {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "Bishnupur, West Bengal",
            "title": "SWARNACHARI",
            "description": "Swarnachari is Baluchari’s festive sibling. The same framed scenes run across the pallu, but they are woven in gold or silver zari rather than silk, so the figures catch the light. Our Meenakari Swarnachari sarees add coloured highlights inside the zari, in the manner of enamel work, on deep red, green and blue grounds.",
            "quote": "Baluchari tells the story; Swarnachari lights it up.",
            "link_label": "Shop Swarnachari",
            "link_url": ""
          }
        }
      },
