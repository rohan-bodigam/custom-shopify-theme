    "weaves_read": {
      "type": "chapter-weaves-read",
      "blocks": {
        "weave_1": {
          "type": "weave_card",
          "settings": {
            "is_featured": true,
            "kicker": "Varanasi, Uttar Pradesh",
            "title": "BANARAS",
            "description": "Banaras, or Banarasi, weaving is the great brocade tradition of North India. A Banaras saree is woven in silk, most often katan silk, with patterns built from gold or silver zari. In the kadhua method, each motif is woven separately with its own small bobbin, which keeps the reverse clean and the motif firm, at the cost of weeks of extra work. Designs follow a long vocabulary: the jaal lattice, the bel vine, the kalga paisley and floral butis scattered across the body. Patterns are set up on punched cards above the loom, but the weaver’s eye still decides the tension and the beat. A Banaras piece is heavy, luminous and made to last across generations.",
            "quote": "Gold that is woven in, not put on.",
            "link_label": "Shop Banaras",
            "link_url": ""
          }
        },
        "weave_2": {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "A light fabric for the same palette",
            "title": "CHIFFON",
            "description": "Chiffon is a lightweight, sheer fabric woven in plain weave from very fine, tightly twisted yarns. The twist gives it a slightly rough, grainy hand and a drape that floats. Traditionally made of silk, it is now also made from other fibres, which is why each product page states the fibre. Chiffon works well for sarees and dupattas because it holds a woven or embroidered border without weighing it down. It dyes in clear, soft colours and photographs beautifully. In the house, chiffon is our lighter way to wear the colours and borders of the north: festive without being heavy, and easy to carry for long days and warm evenings.",
            "quote": "Festive, without the weight.",
            "link_label": "Shop Chiffon",
            "link_url": ""
          }
        }
      },
