    "weaves_read": {
      "type": "chapter-weaves-read",
      "blocks": {
        "weave_1": {
          "type": "weave_card",
          "settings": {
            "is_featured": true,
            "kicker": "Mangalagiri, Andhra Pradesh",
            "title": "MANGALAGIRI",
            "description": "Mangalagiri is a handloom cotton tradition from the temple town of the same name near Vijayawada. The cloth is known for being crisp, durable and easy to wear in heat. A Mangalagiri saree usually has a plain, solid body, sometimes with fine checks or stripes, and its best-known feature is the Nizam border: a woven border with small gold zari motifs set against a clean ground. Because the body is so plain, the colour and the border do all the work. The result is a saree that works for the office, for festivals and for travel, and a fabric that is equally good in shirts, kurtas and children’s clothes. It softens with every wash while keeping its shape.",
            "quote": "Plain on purpose, so the border can shine.",
            "link_label": "Shop Mangalagiri",
            "link_url": ""
          }
        },
        "weave_2": {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "Pochampally and the Telugu states",
            "title": "IKKAT",
            "description": "Ikkat is a resist-dyeing technique in which the yarn is tied and dyed before weaving. Sections of thread are bound tightly so they resist the dye, then the bundle is dyed, retied and dyed again to build up colour. When the dyed yarn is set on the loom, the pattern appears in the cloth with its characteristic soft, feathered edges. In single ikkat only one set of threads (warp or weft) is dyed this way, in double ikkat both are. Pochampally in Telangana is famous for its geometric designs: diamonds, stepped flames, and small elephants, parrots and flowers. Ikkat comes in cotton and silk and moves easily from sarees to shirts and co-ord sets.",
            "quote": "The pattern is dyed before it is woven.",
            "link_label": "Shop Ikkat",
            "link_url": ""
          }
        }
      },
