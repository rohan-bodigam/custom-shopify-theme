    "about": {
      "type": "chapter-about",
      "settings": {
        "map_image": "shopify://shop_images/mapWest.jpg",
        "heading": "ABOUT THIS CHAPTER",
        "show_warp_icon": true,
        "katha": "On the banks of the Narmada, a queen once set up looms to give a fort town a living. In the dry country near Kota, weavers learned to make cloth so light it is almost sheer.",
        "about": "This chapter holds two of India's lightest, most elegant cloths, Maheshwari and Kota. Both are made for heat, both are finished with a little gold, and both work at a wedding, in an office or on an ordinary Tuesday.",
        "fact_1_value": "5",
        "fact_1_label": "states",
        "fact_2_value": "Handloom",
        "fact_2_label": "made in small runs",
        "background_color": "#f6f2ea",
