        },
        "region_west": {
          "type": "region",
          "settings": {
            "region_id": "west",
            "svg_filename": "west.svg",
            "chapter_no": "Chapter 02",
            "region_name": "West & Central India",
            "short_name": "West & Central",
            "tagline": "Where Colour Meets Craft",
            "katha": "On the banks of the Narmada, a queen once set up looms to give a fort town a living. In the dry country of Rajasthan, weavers learned to make cotton so light it is nearly sheer. This chapter holds two of India’s lightest and most elegant cloths: Maheshwari and Zari Kota, both made for heat, both finished with a little gold.",
            "weaves": "Maheshwari, Zari Kota, Pure Kota",
            "chapter_link": "shopify://pages/west-central-india",
            "accent_color": "#6b2230",
            "accent_deep": "#6b2230",
            "accent_lite": "#e2a3ae"
          }
        },
        "region_north": {
          "type": "region",
          "settings": {
            "region_id": "north",
            "svg_filename": "north.svg",
            "chapter_no": "Chapter 03",
            "region_name": "North India",
            "short_name": "North",
            "tagline": "Where Heritage Lives in Every Detail",
            "katha": "Varanasi has woven silk and gold for centuries, and its looms still set the standard for the Indian wedding saree. This chapter pairs that weight and richness with its opposite: light chiffon, the sheer, floating cloth that carries the same gold borders at a fraction of the heaviness.",
            "weaves": "Banaras, Chiffon",
            "chapter_link": "shopify://pages/north-india",
            "accent_color": "#b08d57",
            "accent_deep": "#7a5a31",
            "accent_lite": "#d1b17e"
          }
        },
        "region_south": {
          "type": "region",
          "settings": {
            "region_id": "south",
            "svg_filename": "south.svg",
            "chapter_no": "Chapter 04",
            "region_name": "South India",
            "short_name": "South",
            "tagline": "Where Tradition Meets Contemporary Design",
            "katha": "Two Telugu-speaking states, two ways of using colour. In Andhra Pradesh, Mangalagiri weavers make crisp cotton with a gold-flecked border. In Telangana, ikkat weavers tie and dye the yarn before it ever touches a loom. Both are practical, beautiful and easy to wear every day.",
            "weaves": "Mangalagiri, Ikkat, Crape Silk",
            "chapter_link": "shopify://pages/south-india",
