{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign has_slide_blocks = false
  if slide_blocks.size > 0
    assign has_slide_blocks = true
  endif

  assign total_slides = slide_blocks.size
  if total_slides == 0 and section.settings.image != blank
    assign total_slides = 1
    if section.settings.image_2 != blank
      assign total_slides = 2
    endif
  elsif total_slides == 0
    assign total_slides = 3
  endif
-%}

<hero-banner-rotator
  id="Banner-{{ section.id }}"
  class="banner hero-rot banner--{{ section.settings.image_height }}{% unless section.settings.enable_zoom %} no-zoom{% endunless %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | default: 'Hero Carousel' | escape }}"
>
  <!-- Background Rotating Slides -->
  <div class="hero-rot__slides">
    {%- if has_slide_blocks -%}
      {%- for block in slide_blocks -%}
        {%- liquid
          assign slide_loading = 'lazy'
          assign slide_fetchpriority = 'auto'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_fetchpriority = 'high'
          endif
        -%}
        <div
          class="hslide{% if forloop.first %} on{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          style="background-position: {{ block.settings.focal_point }};"
          role="img"
          aria-label="{{ block.settings.alt_text | default: block.settings.image.alt | default: section.settings.heading | escape }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 1100 }}">
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_fetchpriority,
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  sizes: '100vw',
                  class: 'hslide__img'
              }}
            </picture>
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag:
                loading: slide_loading,
                fetchpriority: slide_fetchpriority,
                widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                sizes: '100vw',
                class: 'hslide__img'
            }}
          {%- else -%}
            {%- assign placeholder_idx = forloop.index | modulo: 2 | plus: 1 -%}
            {{ 'lifestyle-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg hslide__img' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- elsif section.settings.image != blank -%}
      <div
        class="hslide on"
        data-slide-index="0"
        role="img"
        aria-label="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
      >
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            class: 'hslide__img'
        }}
      </div>
      {%- if section.settings.image_2 != blank -%}
        <div
          class="hslide"
          data-slide-index="1"
          role="img"
          aria-hidden="true"
          aria-label="{{ section.settings.image_2.alt | default: section.settings.heading | escape }}"
        >
          {{
            section.settings.image_2
            | image_url: width: 3840
            | image_tag:
              loading: 'lazy',
              fetchpriority: 'auto',
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              sizes: '100vw',
              class: 'hslide__img'
          }}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="hslide on" data-slide-index="0" role="img" aria-label="Stories of India 1">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hslide__img' }}
      </div>
      <div class="hslide" data-slide-index="1" role="img" aria-hidden="true" aria-label="Stories of India 2">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg hslide__img' }}
      </div>
      <div class="hslide" data-slide-index="2" role="img" aria-hidden="true" aria-label="Stories of India 3">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hslide__img' }}
      </div>
    {%- endif -%}
  </div>

  <!-- Dual Direction Gradient for Text Contrast -->
  <div class="hero-rot__overlay"></div>

  <!-- Constant Content Overlaid on Left -->
  <div class="wrap hero-in banner__content banner__content--{{ section.settings.desktop_content_position }}">
    <div class="hero-box">
      {%- if section.settings.show_kicker and section.settings.kicker != blank -%}
        <div class="hero-badge-row">
          {%- if section.settings.show_kicker_icon -%}
            <!-- Golden Loom Warp Threads Icon -->
            <svg class="warp-icon" viewBox="0 0 20 24" width="18" height="22" fill="none" aria-hidden="true">
              <line x1="2" y1="8" x2="2" y2="16" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
              <line x1="6" y1="5" x2="6" y2="19" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
              <line x1="10" y1="2" x2="10" y2="22" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
              <line x1="14" y1="5" x2="14" y2="19" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
              <line x1="18" y1="8" x2="18" y2="16" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
            </svg>
          {%- endif -%}
          <span class="hero-kick">{{ section.settings.kicker }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="d1 hero-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="sub hero-desc">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="ctas hero-ctas">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_1 }}"
              {% endif %}
              class="btn {{ section.settings.button_style_1 }}"
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}

          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_2 }}"
              {% endif %}
              class="btn {{ section.settings.button_style_2 }}"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Legacy block fallback if merchant configured content using Dawn blocks
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if section.settings.heading == blank -%}
              <h2 class="d1 hero-title {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if section.settings.text == blank -%}
              <p class="sub hero-desc" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}
          {%- when 'buttons' -%}
            {%- if section.settings.button_label_1 == blank and section.settings.button_label_2 == blank -%}
              <div class="ctas hero-ctas" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a href="{{ block.settings.button_link_1 }}" class="btn light">
                    {{- block.settings.button_label_1 | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a href="{{ block.settings.button_link_2 }}" class="btn line-light">
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Interactive Slide Navigation Dots -->
  {%- if total_slides > 1 -%}
    <div class="hdots" role="tablist" aria-label="Slides">
      {%- for i in (1..total_slides) -%}
        {%- assign zero_index = forloop.index0 -%}
        <button
          type="button"
          role="tab"
          aria-label="Show picture {{ forloop.index }} of {{ total_slides }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          data-hs="{{ zero_index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</hero-banner-rotator>

<script>
  if (!customElements.get('hero-banner-rotator')) {
    customElements.define(
      'hero-banner-rotator',
      class HeroBannerRotator extends HTMLElement {
        constructor() {
          super();
          this.slides = Array.from(this.querySelectorAll('.hslide'));
          this.dots = Array.from(this.querySelectorAll('.hdots button'));
          this.currentIndex = 0;
          this.autoplayTimer = null;
          this.interval = parseInt(this.dataset.interval, 10) || 6000;
          this.autoplayEnabled = this.dataset.autoplay === 'true';
          this.touchStartX = 0;
          this.touchEndX = 0;
        }

        connectedCallback() {
          if (this.slides.length <= 1) return;

          this.dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              this.goTo(index);
              this.restartAutoplay();
            });
          });

          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
          this.addEventListener('focusin', () => this.stopAutoplay());
          this.addEventListener('focusout', () => this.startAutoplay());

          // Touch swipe support on mobile
          this.addEventListener('touchstart', (e) => {
            this.touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          this.addEventListener('touchend', (e) => {
            this.touchEndX = e.changedTouches[0].screenX;
            this.handleSwipe();
          }, { passive: true });

          // Live Theme Editor block selection
          if (window.Shopify && window.Shopify.designMode) {
            this.addEventListener('shopify:block:select', (event) => {
              const blockId = event.detail.blockId;
              const targetIndex = this.slides.findIndex((s) => s.dataset.blockId === blockId);
              if (targetIndex !== -1) {
                this.goTo(targetIndex);
                this.stopAutoplay();
              }
            });

            this.addEventListener('shopify:block:deselect', () => {
              this.startAutoplay();
            });
          }

          if (this.autoplayEnabled) {
            this.startAutoplay();
          }
        }

        disconnectedCallback() {
          this.stopAutoplay();
        }

        handleSwipe() {
          const swipeThreshold = 50;
          const diff = this.touchStartX - this.touchEndX;
          if (Math.abs(diff) > swipeThreshold) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
            this.restartAutoplay();
          }
        }

        goTo(index) {
          if (index < 0 || index >= this.slides.length || index === this.currentIndex) return;

          this.slides[this.currentIndex]?.classList.remove('on');
          this.slides[this.currentIndex]?.setAttribute('aria-hidden', 'true');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].setAttribute('aria-pressed', 'false');
          }

          this.currentIndex = index;
          this.slides[this.currentIndex]?.classList.add('on');
          this.slides[this.currentIndex]?.removeAttribute('aria-hidden');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].setAttribute('aria-pressed', 'true');
          }
        }

        next() {
          const nextIndex = (this.currentIndex + 1) % this.slides.length;
          this.goTo(nextIndex);
        }

        prev() {
          const prevIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
          this.goTo(prevIndex);
        }

        startAutoplay() {
          if (!this.autoplayEnabled || this.slides.length <= 1) return;
          this.stopAutoplay();
          this.autoplayTimer = setInterval(() => this.next(), this.interval);
        }

        stopAutoplay() {
          if (this.autoplayTimer) {
            clearInterval(this.autoplayTimer);
            this.autoplayTimer = null;
          }
        }

        restartAutoplay() {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Kicker / Badge"
    },
    {
      "type": "checkbox",
      "id": "show_kicker",
      "default": true,
      "label": "Show kicker badge"
    },
    {
      "type": "checkbox",
      "id": "show_kicker_icon",
      "default": true,
      "label": "Show loom warp icon"
    },
    {
      "type": "text",
      "id": "kicker",
      "default": "Indian Craft. Everyday Life.",
      "label": "Kicker text"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Stories of India, Woven For You",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large (Display)"
        },
        {
          "value": "hxl",
          "label": "Extra Large"
        }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "default": "Contemporary clothing from India’s handloom traditions, gathered under one house in five regional chapters, and cut for men, women, kids and pets.",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "First Button"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "Explore the Chapters",
      "label": "Button 1 label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "options": [
        {
          "value": "light",
          "label": "Solid Light Pill (Ivory / Crimson)"
        },
        {
          "value": "line-light",
          "label": "Outlined Glass Pill"
        }
      ],
      "default": "light",
      "label": "Button 1 style"
    },
    {
      "type": "header",
      "content": "Second Button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "Shop All",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "options": [
        {
          "value": "line-light",
          "label": "Outlined Glass Pill"
        },
        {
          "value": "light",
          "label": "Solid Light Pill (Ivory / Crimson)"
        }
      ],
      "default": "line-light",
      "label": "Button 2 style"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Auto-rotate slides"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "default": true,
      "label": "Enable Ken Burns zoom animation"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large (Recommended)"
        },
        {
          "value": "full_screen",
          "label": "Full Screen (100vh)"
        }
      ],
      "default": "large",
      "label": "Banner height"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "middle-left",
          "label": "Middle Left (Figma Design)"
        },
        {
          "value": "middle-center",
          "label": "Middle Center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        }
      ],
      "default": "middle-left",
      "label": "Desktop content position"
    },
    {
      "type": "header",
      "content": "Fallback Images (When no Slide blocks are added)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "First fallback image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second fallback image"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Slide image (Mobile - optional)"
        },
        {
          "type": "select",
          "id": "focal_point",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "center top",
              "label": "Top Center"
            },
            {
              "value": "center bottom",
              "label": "Bottom Center"
            },
            {
              "value": "left center",
              "label": "Left Center"
            },
            {
              "value": "right center",
              "label": "Right Center"
            }
          ],
          "default": "center center",
          "label": "Image focal position"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Describe image for accessibility"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading (Legacy)",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Stories of India, Woven For You",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            }
          ],
          "default": "h0",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text (Legacy)",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Contemporary clothing from India’s handloom traditions...",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons (Legacy)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Explore the Chapters",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Shop All",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
