{{ 'section-product-hokk.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image

  # Extract Chapter, Region, Craft from tags/collections
  assign product_chapter = 'Heritage'
  assign product_region = 'South India'
  assign product_craft = 'Handloom'

  for collection in product.collections
    assign col_title = collection.title | downcase
    if col_title contains 'contemporary'
      assign product_chapter = 'Contemporary'
    elsif col_title contains 'kids'
      assign product_chapter = 'Kids'
    elsif col_title contains 'heritage'
      assign product_chapter = 'Heritage'
    endif

    if col_title contains 'south'
      assign product_region = 'South India'
    elsif col_title contains 'east'
      assign product_region = 'East India'
    elsif col_title contains 'west'
      assign product_region = 'West India'
    elsif col_title contains 'north east'
      assign product_region = 'North East'
    elsif col_title contains 'north'
      assign product_region = 'North India'
    endif
  endfor

  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'ikkat'
      assign product_craft = 'Ikkat'
      assign product_region = 'South India'
    elsif tag_lower contains 'mangalgiri'
      assign product_craft = 'Mangalgiri'
      assign product_region = 'South India'
    elsif tag_lower contains 'mul cotton' or tag_lower == 'mul'
      assign product_craft = 'Mul Cotton'
      assign product_region = 'East India'
    elsif tag_lower contains 'maheshwari'
      assign product_craft = 'Maheshwari'
      assign product_region = 'West India'
    elsif tag_lower contains 'chiffon'
      assign product_craft = 'Chiffon Zari'
      assign product_region = 'North India'
    elsif tag_lower contains 'kota'
      assign product_craft = 'Kota Doria'
      assign product_region = 'West India'
    elsif tag_lower contains 'baluchari'
      assign product_craft = 'Baluchari'
      assign product_region = 'East India'
    elsif tag_lower contains 'swarnachari'
      assign product_craft = 'Swarnachari'
      assign product_region = 'East India'
    elsif tag_lower contains 'linen'
      assign product_craft = 'Linen'
      assign product_chapter = 'Contemporary'
    endif
  endfor

  # Fallback craft from title
  assign title_lower = product.title | downcase
  if title_lower contains 'ikkat'
    assign product_craft = 'Ikkat'
    assign product_region = 'South India'
  elsif title_lower contains 'mangalgiri'
    assign product_craft = 'Mangalgiri'
    assign product_region = 'South India'
  elsif title_lower contains 'mul cotton'
    assign product_craft = 'Mul Cotton'
    assign product_region = 'East India'
  elsif title_lower contains 'maheshwari'
    assign product_craft = 'Maheshwari'
    assign product_region = 'West India'
  elsif title_lower contains 'chiffon'
    assign product_craft = 'Chiffon Zari'
    assign product_region = 'North India'
  elsif title_lower contains 'kota'
    assign product_craft = 'Kota Doria'
    assign product_region = 'West India'
  elsif title_lower contains 'linen'
    assign product_craft = 'Linen'
  endif
-%}

<section
  id="ProductSection-{{ section.id }}"
  class="hokk-pdp-section"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="hokk-pdp-wrap">
    {% comment %} Breadcrumbs Navigation {% endcomment %}
    <nav class="hokk-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      <a href="/pages/chapter-{{ product_chapter | downcase }}" id="crumbChapter">{{ product_chapter }}</a>
      <span class="sep">/</span>
      <a href="/pages/chapter-{{ product_region | handleize }}" id="crumbRegion">{{ product_region }}</a>
      <span class="sep">/</span>
      <span class="current">{{ product.title }}</span>
    </nav>

    {% comment %} Main PDP Grid {% endcomment %}
    <div class="hokk-pdp">
      {% comment %} Left Column: Gallery {% endcomment %}
      <div class="hokk-gallery" id="hokkGallery">
        <div class="hokk-thumbs" id="hokkThumbs" role="tablist" aria-label="Product thumbnails">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign default_caption = 'The piece'
                if forloop.index == 2
                  assign default_caption = 'Another angle'
                elsif forloop.index == 3
                  assign default_caption = 'Laid out'
                elsif forloop.index > 3
                  assign default_caption = 'Detail view'
                endif
                assign img_caption = media.alt | default: default_caption
              -%}
              <button
                type="button"
                class="hokk-thumb-btn"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-src="{{ media | image_url: width: 1400 }}"
                data-media-id="{{ media.id }}"
                data-alt="{{ media.alt | default: '' | escape }}"
                data-caption="{{ img_caption | escape }}"
                aria-label="View image {{ forloop.index }} - {{ img_caption | escape }}"
              >
                {{ media | image_url: width: 200, height: 250, crop: 'center' | image_tag: loading: 'lazy', alt: img_caption }}
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="hokk-thumb-btn" aria-current="true">
              {{ 'product-1' | placeholder_svg_tag }}
            </button>
          {%- endif -%}
        </div>

        <div class="hokk-gmain" id="hokkMainFrame">
          {%- if product.featured_media -%}
            {%- assign main_cap = product.featured_media.alt | default: 'The piece' -%}
            <img
              id="hokkMainImg"
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ main_cap | escape }}"
              width="1200"
              height="1500"
              loading="eager"
            >
            <span class="hokk-cap" id="hokkCaption">{{ main_cap }}</span>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
            <span class="hokk-cap" id="hokkCaption">The piece</span>
          {%- endif -%}
        </div>
      </div>

      {% comment %} Right Column: Product Information {% endcomment %}
      <div class="hokk-pinfo">
        {% comment %} Category / Kicker {% endcomment %}
        <a href="/pages/chapter-{{ product_region | handleize }}" class="hokk-kicker" id="pdpKicker">
          <span id="kickerCraft">{{ product_craft }}</span> · <span id="kickerRegion">{{ product_region }}</span>
        </a>

        {% comment %} Title {% endcomment %}
        <h1 class="hokk-title">{{ product.title }}</h1>

        {% comment %} Price & Review Row {% endcomment %}
        <div class="hokk-price-row">
          <span class="hokk-price" id="pdpPrice">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="hokk-price-compare" id="pdpComparePrice">{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span id="pdpCurrentPrice">{{ current_variant.price | money }}</span>
          </span>

          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
            <span class="hokk-savetag" id="pdpSaveTag">Save {{ savings | money }}</span>
          {%- endif -%}

          <span class="hokk-tax-note">Inclusive of taxes</span>

          <a href="#reviews" class="hokk-reviews-note">No reviews yet</a>
        </div>

        {% comment %} Stock Status Indicator {% endcomment %}
        <div class="hokk-stockline {% unless product.available %}out{% else %}{% if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 3 %}low{% endif %}{% endunless %}" id="pdpStockLine">
          <i></i>
          <span id="pdpStockText">
            {%- if product.available -%}
              {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 3 -%}
                Only {{ current_variant.inventory_quantity }} left, made in small runs
              {%- else -%}
                In stock, ships in 2 working days
              {%- endif -%}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
        </div>

        {% comment %} Editorial Lead Paragraph (Parsed dynamically) {% endcomment %}
        <div class="hokk-lead-desc" id="pdpLeadDesc">
          {% comment %} Fallback or immediate rendered content {% endcomment %}
          {{ product.description | strip_html | truncatewords: 65 }}
        </div>

        {% comment %} Artisan Certified Badge {% endcomment %}
        <div class="hokk-cert" id="pdpCert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="10" r="6"/>
            <path d="M9.5 10l1.8 1.8L15 8.2M8.5 15l-1.5 6 5-2.5 5 2.5-1.5-6"/>
          </svg>
          <span id="certText">Artisan Certified · Pochampally, Telangana (and other ikkat centres)</span>
        </div>

        {% comment %} Shopify Product Form {% endcomment %}
        <product-form data-section-id="{{ section.id }}">
          {%- form 'product',
            product,
            id: 'HokkProductForm',
            class: 'hokk-form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" id="HokkVariantId">
            <input type="hidden" name="quantity" value="1" id="HokkQuantityInput">

            {% comment %} Options: Colour {% endcomment %}
            {%- assign color_option = null -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_lower = option.name | downcase -%}
              {%- if opt_lower == 'colour' or opt_lower == 'color' -%}
                {%- assign color_option = option -%}
              {%- endif -%}
            {%- endfor -%}

            <div class="hokk-opt-group" id="groupColour" {% unless color_option %}style="display:none"{% endunless %}>
              <div class="hokk-opt-h">
                <span>Colour: <span id="colName">{{ color_option.selected_value | default: 'Slate' }}</span></span>
              </div>
              <div class="hokk-swatches" id="swatchList">
                {%- if color_option -%}
                  {%- for value in color_option.values -%}
                    <button
                      type="button"
                      class="hokk-swatch"
                      data-value="{{ value | escape }}"
                      aria-label="{{ value | escape }}"
                      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                    ></button>
                  {%- endfor -%}
                {%- else -%}
                  <button type="button" class="hokk-swatch" style="background:#D6B698" aria-label="Slate" aria-pressed="true"></button>
                {%- endif -%}
              </div>
            </div>

            {% comment %} Options: Size {% endcomment %}
            {%- assign size_option = null -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_lower = option.name | downcase -%}
              {%- if opt_lower == 'size' -%}
                {%- assign size_option = option -%}
              {%- endif -%}
            {%- endfor -%}

            <div class="hokk-opt-group" id="groupSize">
              <div class="hokk-opt-h">
                <span>Size</span>
                <button type="button" class="hokk-size-guide-btn" id="openSizeGuideBtn">Size guide</button>
              </div>
              <div class="hokk-sizes" id="sizeList">
                {%- if size_option -%}
                  {%- for value in size_option.values -%}
                    <button
                      type="button"
                      class="hokk-size-btn"
                      data-value="{{ value | escape }}"
                      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                {%- else -%}
                  <button type="button" class="hokk-size-btn" aria-pressed="true">Free size</button>
                {%- endif -%}
              </div>
            </div>

            {% comment %} Buy Row (Quantity + Add to Bag) {% endcomment %}
            <div class="hokk-buyrow">
              <div class="hokk-qty">
                <button type="button" class="hokk-qty-btn" id="qtyMinus" aria-label="Decrease quantity">−</button>
                <span class="hokk-qty-val" id="qtyDisplay">1</span>
                <button type="button" class="hokk-qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
              </div>

              <button
                type="submit"
                name="add"
                class="hokk-add-btn"
                id="HokkSubmitBtn"
                {% unless product.available %}disabled{% endunless %}
              >
                <span id="HokkSubmitText">
                  {%- if product.available -%}
                    Add to Bag
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </span>
                <div class="loading__spinner hidden" aria-hidden="true">
                  {%- render 'loading-spinner' -%}
                </div>
              </button>
            </div>
          {%- endform -%}
        </product-form>

        {% comment %} Reassurance Text {% endcomment %}
        <p class="hokk-reassurance">
          Ships in 2 working days. Free delivery over ₹7,500. 14-day returns on unworn pieces.
        </p>

        {% comment %} Dynamic Specifications Table {% endcomment %}
        <div class="hokk-spec" id="pdpSpecWrap">
          <table class="hokk-spec-table">
            <tbody id="pdpSpecBody">
              <tr><th>SKU</th><td>{{ current_variant.sku | default: 'HOKK-IKK-SAR-109' }}</td></tr>
              <tr><th>Colour</th><td>Slate grey and orange</td></tr>
              <tr><th>Fabric</th><td>Cotton</td></tr>
              <tr><th>Saree Length</th><td>5.5 metres</td></tr>
              <tr><th>Saree Width</th><td>112–117 cm</td></tr>
              <tr><th>Blouse Included</th><td>Yes</td></tr>
              <tr><th>Blouse Length</th><td>90 cm</td></tr>
              <tr><th>Weight Range</th><td>500 g–1 kg</td></tr>
              <tr><th>Care</th><td>Dry clean only</td></tr>
              <tr><th>Region</th><td id="specRegion">{{ product_region }}</td></tr>
            </tbody>
          </table>
        </div>

        {% comment %} Collapsible Accordions {% endcomment %}
        <div class="hokk-acc" id="pdpAccordions">
          {% comment %} 1. The Story {% endcomment %}
          <details id="accStory">
            <summary>The story</summary>
            <div class="in" id="accStoryContent">
              <p>Ikkat comes from Pochampally, Telangana (and other ikkat centres), part of our South India chapter. Woven on pit looms using warp and weft tie-dye precision.</p>
              <p><a class="tlink" href="/pages/chapter-south" id="accChapterLink">Read the South India Chapter</a></p>
            </div>
          </details>

          {% comment %} 2. Fabric & care {% endcomment %}
          <details id="accFabricCare">
            <summary>Fabric &amp; care</summary>
            <div class="in" id="accFabricCareContent">
              <p id="accFabricCareLead">Cotton. Dry clean only.</p>
              <p>Small irregularities in colour and weave are the signature of handwork, not defects.</p>
            </div>
          </details>

          {% comment %} 3. Shipping & returns {% endcomment %}
          <details id="accShipping">
            <summary>Shipping &amp; returns</summary>
            <div class="in" id="accShippingContent">
              <p>Dispatched within 2 working days; 3–6 days to most Indian cities, 7–12 days internationally. Free shipping on orders over ₹7,500, otherwise ₹250.</p>
              <p>Returns within 14 days for unworn pieces with tags. Customised and pet pieces are final sale unless damaged.</p>
            </div>
          </details>

          {% comment %} 4. Size guide {% endcomment %}
          <details id="accSizeGuide">
            <summary>Size guide</summary>
            <div class="in" id="accSizeGuideContent">
              <p>Saree length 5.5 m plus blouse piece where stated; width 46–48 inches.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

{% comment %} Hidden Raw Content Container for the Parser {% endcomment %}
<div id="HokkRawDescription" style="display:none;" aria-hidden="true">
  {{ product.description }}
</div>

{% comment %} Product Variants for Color & Size Switching {% endcomment %}
<script id="HokkVariantsJson" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available }},
        "price": {{ variant.price }},
        "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
        "featured_media_id": {{ variant.featured_media.id | default: 'null' }},
        "featured_image": {{ variant.featured_image | image_url: width: 1400 | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
  (function() {
    'use strict';

    // 1. Swatch Color Palette
    const COLOR_PALETTE = {
      'slate': '#D6B698',
      'grey': '#A09F9D',
      'gray': '#A09F9D',
      'black': '#1E1E1E',
      'white': '#FDFBF7',
