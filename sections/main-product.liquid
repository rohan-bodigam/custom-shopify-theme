      'ice blue': '#A4C3D2',
      'navy': '#1B2A4A',
      'indigo': '#28385E',
      'red': '#8B1E22',
      'maroon': '#5C1D24',
      'wine': '#5C1D24',
      'green': '#2D4B3E',
      'sage': '#7A8063',
      'sage green': '#848C74',
      'olive': '#555D3E',
      'muted olive': '#656D4A',
      'peach': '#F5B89B',
      'peach window': '#F5B89B',
      'coral': '#E07A5F',
      'copper': '#B87333',
      'mustard': '#D4A017',
      'charcoal': '#36454F',
      'crimson': '#6B2230',
      'yellow': '#D4A034',
      'butter yellow': '#E6CF82',
      'gold': '#B08D57',
      'orange': '#C96228',
      'rust': '#9A4B1F',
      'terracotta': '#A84C32',
      'pink': '#D6899E',
      'rose': '#B86B7E',
      'dusty rose': '#BD828F',
      'purple': '#5C3866',
      'violet': '#4E2F60',
      'lavender': '#9683A6',
      'teal': '#28585D',
      'beige': '#D8C7B5',
      'sand': '#D6C6B8',
      'sand beige': '#D5C4B1'
    };

    // 2. Knowledge Map for Craft Clusters, Regions & Stories
    const CRAFT_INFO = {
      'ikkat': {
        cluster: 'Pochampally, Telangana (and other ikkat centres)',
        region: 'South India',
        chapter: 'Heritage',
        story: 'Ikkat is an ancient resist-dyeing technique where yarns are precision-tied and dyed before weaving on the loom. Originating from Pochampally and neighboring Telangana clusters, each motif forms through the careful alignment of warp and weft threads, creating feathered geometric patterns celebrated across South India.'
      },
      'mangalgiri': {
        cluster: 'Mangalagiri, Guntur district, Andhra Pradesh',
        region: 'South India',
        chapter: 'Heritage',
        story: 'Mangalgiri sarees are woven from fine combed cotton yarns on pit looms, renowned for their crisp Nizam borders embellished with geometric zari micro-patterns.'
      },
      'mul cotton': {
        cluster: 'Bengal tradition, woven across several clusters',
        region: 'East India',
        chapter: 'Heritage',
        story: 'Mul cotton is revered for its gossamer-fine count and featherweight drape. Rooted in the weaving heritage of Bengal, the airy plain weave allows cooling ventilation while showcasing delicate hand-block prints and woven borders.'
      },
      'maheshwari': {
        cluster: 'Maheshwar, Madhya Pradesh',
        region: 'West India',
        chapter: 'Heritage',
        story: 'Originating under the royal patronage of Maharani Ahilyabai Holkar in the 18th century, Maheshwari weaving pairs fine silk warps with crisp cotton wefts. Notable for its reversible zari borders inspired by the carvings of Maheshwar Fort.'
      },
      'chiffon zari': {
        cluster: 'Banaras tradition, Uttar Pradesh',
        region: 'North India',
        chapter: 'Heritage',
        story: 'Chiffon Zari combines sheer, floating chiffon fabric with classic Banaras gold-toned zari edging. Hand brush painted with expressive botanical florals, this style bridges courtly elegance and easy modern drape.'
      },
      'kota doria': {
        cluster: 'Kota & Kaithun clusters, Rajasthan',
        region: 'West India',
        chapter: 'Heritage',
        story: 'Kota Doria is distinguished by its unique square-check weave known as khat, made by combining cotton and silk yarns on traditional pit looms for an ultra-lightweight, translucent drape.'
      },
      'baluchari': {
        cluster: 'Bishnupur, Bankura district, West Bengal',
        region: 'East India',
        chapter: 'Heritage',
        story: 'Baluchari weaving is celebrated for its elaborate pictorial pallus depicting mythological scenes and courtly narratives, woven with polished silk and meenakari threads on jacquard looms.'
      },
      'linen': {
        cluster: 'Handcrafted linen weaving clusters',
        region: 'Contemporary',
        chapter: 'Contemporary',
        story: 'Pure handmade linen woven from natural flax fibers provides unmatched breathability, natural cooling, and a softly textured slub hand that softens gracefully with each wear.'
      }
    };

    // Helper: decode HTML entities (like &amp; &nbsp; &#39;)
    function decodeHtmlEntities(str) {
      if (!str) return '';
      const txt = document.createElement('textarea');
      txt.innerHTML = str;
      return txt.value;
    }

    // 3. Robust Content Parser
    function parseProductDescription() {
      const rawEl = document.getElementById('HokkRawDescription');
      if (!rawEl) return;
      const html = rawEl.innerHTML || '';
      if (!html.trim()) return;

      // Extract raw text with structure
      const textWithBreaks = html
        .replace(/<br\s*\/?>/gi, '\n')
        .replace(/<\/p>/gi, '\n\n')
        .replace(/<\/h[1-6]>/gi, '\n\n')
        .replace(/<\/li>/gi, '\n')
        .replace(/<\/tr>/gi, '\n');

      const splitHeaders = [
        /Product Details/i,
        /Product Specifications/i,
        /Design Details/i
      ];

      let splitIdx = -1;
      for (const re of splitHeaders) {
        const match = textWithBreaks.search(re);
        if (match !== -1 && (splitIdx === -1 || match < splitIdx)) {
          splitIdx = match;
        }
      }

      let leadText = '';
      let restText = textWithBreaks;
      if (splitIdx !== -1) {
        leadText = decodeHtmlEntities(textWithBreaks.substring(0, splitIdx).replace(/<[^>]+>/g, '')).trim();
        restText = textWithBreaks.substring(splitIdx);
      } else {
        leadText = decodeHtmlEntities(textWithBreaks.replace(/<[^>]+>/g, '')).trim();
      }

      // Parse lines in restText
      const lines = restText.split('\n');
      const specs = {};
      let activeAcc = null;
      const accContent = { story: [], fabricCare: [], shipping: [], sizeGuide: [] };

      function detectHeading(str) {
        const clean = decodeHtmlEntities(str.replace(/<[^>]+>/g, ''))
          .replace(/[\*\#\_\:\-]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();

        if (/^(the\s+)?story$/i.test(clean)) return 'story';
        if (/^fabric\s*(&|and)\s*care/i.test(clean) || /^choose your linen fabric/i.test(clean)) return 'fabricCare';
        if (/^shipping\s*(&|and)\s*returns?/i.test(clean)) return 'shipping';
        if (/^size\s*guide/i.test(clean) || /^sizing(\s*guide)?/i.test(clean)) return 'sizeGuide';
        if (/^product\s*(details|specifications)/i.test(clean) || /^design\s*details/i.test(clean)) return 'specs';

        return null;
      }

      for (let rawLine of lines) {
        const decodedLine = decodeHtmlEntities(rawLine.replace(/<[^>]+>/g, '')).trim();
        if (!decodedLine) continue;

        const headerType = detectHeading(decodedLine);
        if (headerType) {
          if (headerType === 'specs') {
            activeAcc = null;
          } else {
            activeAcc = headerType;
          }
          continue;
        }

        if (activeAcc && accContent[activeAcc]) {
          accContent[activeAcc].push(decodedLine);
          continue;
        }

        const kvMatch = decodedLine.match(/^([A-Za-z0-9\s\/\-_]+):\s*(.+)$/);
        if (kvMatch) {
          const k = kvMatch[1].trim();
          const v = kvMatch[2].trim();
          if (k && v && k.length < 35) {
            specs[k] = v;
          }
        }
      }

      // Apply Lead text with paragraphs
      if (leadText) {
        const leadEl = document.getElementById('pdpLeadDesc');
        if (leadEl) {
          const paragraphs = leadText.split(/\n{2,}/).map(p => p.trim()).filter(Boolean);
          if (paragraphs.length > 0) {
            leadEl.innerHTML = paragraphs.map(p => `<p>${escapeHtml(p)}</p>`).join('');
          } else {
            leadEl.textContent = leadText;
          }
        }
      }

      // Detect craft & region
      let craftName = specs['Craft'] || specs['Weave'] || specs['Collection'] || '';
      let regionName = specs['Region'] || '';

      if (!craftName) {
        const titleLower = '{{ product.title | downcase }}';
        for (const c of Object.keys(CRAFT_INFO)) {
          if (titleLower.includes(c)) { craftName = c; break; }
        }
      }

      const craftKey = (craftName || '').toLowerCase().trim();
      const matchedCraft = CRAFT_INFO[craftKey] || CRAFT_INFO['ikkat'];

      if (!regionName && matchedCraft) {
        regionName = matchedCraft.region;
      }

      // Update Kicker & Breadcrumb
      if (craftName) {
        const kCraft = document.getElementById('kickerCraft');
        if (kCraft) kCraft.textContent = craftName;
      }
      if (regionName) {
        const kRegion = document.getElementById('kickerRegion');
        if (kRegion) kRegion.textContent = regionName;
        const cRegion = document.getElementById('crumbRegion');
        if (cRegion) cRegion.textContent = regionName;
      }

      // Update Artisan Certified badge
      const certCluster = specs['Artisan Certified'] || specs['Artisan Cluster'] || specs['Cluster'] || matchedCraft.cluster;
      const certEl = document.getElementById('certText');
      if (certEl && certCluster) {
        certEl.textContent = 'Artisan Certified · ' + certCluster;
      }

      // Populate Specifications Table
      const specBody = document.getElementById('pdpSpecBody');
      if (specBody) {
        // Normalize common key aliases
        if (!specs['Colour']) {
          specs['Colour'] = specs['Color'] || specs['Colour Palette'] || specs['Colors'] || '';
        }
        if (!specs['Care'] && specs['Care Instructions']) {
          specs['Care'] = specs['Care Instructions'];
        }
        if (!specs['Blouse Included'] && specs['Blouse']) {
          specs['Blouse Included'] = /included|yes/i.test(specs['Blouse']) ? 'Yes' : specs['Blouse'];
        }
        if (!specs['SKU']) {
          specs['SKU'] = '{{ current_variant.sku | default: "HOKK-IKK-SAR-109" }}';
        }
        if (!specs['Region'] && regionName) {
          specs['Region'] = regionName;
        }

        const desiredOrder = [
          'SKU', 'Colour', 'Fabric', 'Style', 'Collar', 'Sleeves', 'Fit',
          'Saree Length', 'Saree Width', 'Blouse Included', 'Blouse Length',
          'Weight Range', 'Closure', 'Pockets', 'Care', 'Region'
        ];

        // Keys to exclude from table (either internal metadata, design notes, or already displayed)
        const excludedPattern = /^(product name|price|design details|product type|collection|weave|composition|colour palette|color|care instructions|body design|border design|pallu design|design type|motifs|border|pallu)$/i;

        let rowsHtml = '';
        const handledKeys = new Set();

        // Render prioritized keys first
        for (const k of desiredOrder) {
          const foundKey = Object.keys(specs).find(sk => sk.toLowerCase() === k.toLowerCase());
          if (foundKey && specs[foundKey] && specs[foundKey].trim()) {
            rowsHtml += `<tr><th>${escapeHtml(k)}</th><td>${escapeHtml(specs[foundKey])}</td></tr>`;
            handledKeys.add(foundKey.toLowerCase());
          }
        }

        // Render any valid remaining keys that are not excluded
        for (const [k, v] of Object.entries(specs)) {
          if (!handledKeys.has(k.toLowerCase()) && !excludedPattern.test(k) && v && v.trim()) {
            rowsHtml += `<tr><th>${escapeHtml(k)}</th><td>${escapeHtml(v)}</td></tr>`;
          }
        }

        if (rowsHtml) {
          specBody.innerHTML = rowsHtml;
        }
      }

      // Populate Accordions
      // 1. The Story (only show if provided in description)
      const storyAcc = document.getElementById('accStory');
      const storyEl = document.getElementById('accStoryContent');
      if (storyAcc && storyEl) {
        if (accContent.story.length > 0) {
          storyAcc.style.display = '';
          const storyText = accContent.story.join('\n\n');
          const regLink = '/pages/chapter-' + (regionName || 'south-india').toLowerCase().replace(/\s+/g, '-');
          storyEl.innerHTML = `<p>${escapeHtml(storyText)}</p><p><a class="tlink" href="${regLink}">Read the ${escapeHtml(regionName || 'South India')} Chapter</a></p>`;
        } else {
          storyAcc.style.display = 'none';
        }
      }

      // 2. Fabric & care
      const fabEl = document.getElementById('accFabricCareContent');
      if (fabEl) {
        if (accContent.fabricCare.length > 0) {
          fabEl.innerHTML = accContent.fabricCare.map(p => `<p>${escapeHtml(p)}</p>`).join('');
        } else {
          const fabric = specs['Fabric'] || 'Cotton';
          const care = specs['Care'] || specs['Care Instructions'] || 'Dry clean only';
          fabEl.innerHTML = `<p>${escapeHtml(fabric)}. ${escapeHtml(care)}.</p><p>Small irregularities in colour and weave are the signature of handwork, not defects.</p>`;
        }
      }

      // 3. Shipping & returns
      const shipEl = document.getElementById('accShippingContent');
      if (shipEl && accContent.shipping.length > 0) {
        shipEl.innerHTML = accContent.shipping.map(p => `<p>${escapeHtml(p)}</p>`).join('');
      }

      // 4. Size guide
      const sizeEl = document.getElementById('accSizeGuideContent');
      if (sizeEl && accContent.sizeGuide.length > 0) {
        sizeEl.innerHTML = accContent.sizeGuide.map(p => `<p>${escapeHtml(p)}</p>`).join('');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // 4. Gallery & Variant Interactions
    let productVariants = [];
    try {
      const vEl = document.getElementById('HokkVariantsJson');
      if (vEl) productVariants = JSON.parse(vEl.textContent);
    } catch(e) {}

    function filterGalleryByColor(colorName) {
      if (!colorName) return;
      const target = colorName.toLowerCase().trim();
      const thumbs = Array.from(document.querySelectorAll('.hokk-thumb-btn'));
      if (!thumbs.length) return;

      const productTitleEl = document.querySelector('.hokk-title');
      const productTitle = productTitleEl ? productTitleEl.textContent.toLowerCase().trim() : '';

      // 1. Map of variant featured media IDs to detect variant groups
      const allVariantMediaIds = new Map();
      productVariants.forEach(v => {
        if (v.featured_media_id && v.featured_media_id !== 'null' && v.options) {
          const cOpt = v.options[0] ? v.options[0].toLowerCase().trim() : '';
          allVariantMediaIds.set(String(v.featured_media_id), cOpt);
        }
      });

      // Find the featured_media_id for the selected color variant
      const matchingVariant = productVariants.find(v => 
        v.options && v.options.some(opt => opt.toLowerCase().trim() === target)
      );
      const targetMediaId = (matchingVariant && matchingVariant.featured_media_id && matchingVariant.featured_media_id !== 'null') 
        ? String(matchingVariant.featured_media_id) 
        : null;

      // 2. Identify thumbnails for this color using 3 tiers:
      let matchedThumbs = [];

      // Tier 1: Match by Image ALT Text
      // Match exact color name, or check if alt includes the full color name (e.g. "Peach Window")
      // Explicitly ignore alt text that is just the generic product title (e.g. "Windowlight")
      const altMatches = thumbs.filter(btn => {
        const alt = (btn.dataset.alt || '').toLowerCase().trim();
        if (!alt || alt === productTitle) return false;
        return alt === target || alt.includes(target);
      });

      if (altMatches.length > 0) {
        matchedThumbs = altMatches;
      }

      // Tier 2: Match by Variant Featured Media ID + Sequential Group
      // If no specific alt text matches, group images starting from this variant's media
      // up to the next variant's media
      if (matchedThumbs.length === 0 && targetMediaId) {
        const startIdx = thumbs.findIndex(btn => String(btn.dataset.mediaId) === targetMediaId);
        if (startIdx !== -1) {
          matchedThumbs.push(thumbs[startIdx]);
          for (let i = startIdx + 1; i < thumbs.length; i++) {
            const nextMediaId = String(thumbs[i].dataset.mediaId);
            const nextVariantColor = allVariantMediaIds.get(nextMediaId);
            if (nextVariantColor && nextVariantColor !== target) {
              break; // Stop at next color variant's image
            }
            matchedThumbs.push(thumbs[i]);
            if (matchedThumbs.length >= 4) break;
          }
        }
      }

      // Tier 3: Fallback for products without variant images
      if (matchedThumbs.length === 0) {
        matchedThumbs = thumbs.slice(0, 4);
      }

      // 3. ENFORCE STRICT LIMIT: Show AT MOST 4 thumbnails on the left, hide all others!
      const finalVisibleThumbs = matchedThumbs.slice(0, 4);

      thumbs.forEach(btn => {
        if (finalVisibleThumbs.includes(btn)) {
          btn.style.display = '';
        } else {
          btn.style.display = 'none';
        }
      });

      // 4. Automatically activate the first matching image of this color
      if (finalVisibleThumbs.length > 0) {
        finalVisibleThumbs[0].click();
      } else if (matchingVariant && matchingVariant.featured_image) {
        const mainImg = document.getElementById('hokkMainImg');
        const mainCap = document.getElementById('hokkCaption');
        if (mainImg) {
          mainImg.style.opacity = '0.4';
          setTimeout(() => {
            mainImg.src = matchingVariant.featured_image;
            mainImg.style.opacity = '1';
          }, 100);
          if (mainCap) mainCap.textContent = colorName;
        }
      }
    }

    function updateActiveVariant() {
      const activeSwatch = document.querySelector('.hokk-swatch[aria-pressed="true"]');
      const activeSize = document.querySelector('.hokk-size-btn[aria-pressed="true"]');
      const colorVal = activeSwatch ? activeSwatch.dataset.value : null;
      const sizeVal = activeSize ? activeSize.dataset.value : null;

      const found = productVariants.find(v => {
        let match = true;
        if (colorVal && (!v.options || !v.options.includes(colorVal))) match = false;
        if (sizeVal && (!v.options || !v.options.includes(sizeVal))) match = false;
        return match;
      });

      if (found) {
        const varInput = document.getElementById('HokkVariantId');
        if (varInput) varInput.value = found.id;

        const submitBtn = document.getElementById('HokkSubmitBtn');
        const submitText = document.getElementById('HokkSubmitText');
        const stockText = document.getElementById('pdpStockText');
        const stockLine = document.getElementById('pdpStockLine');

        if (submitBtn && submitText) {
          if (found.available) {
            submitBtn.disabled = false;
            submitText.textContent = 'Add to Bag';
            if (stockLine) stockLine.className = 'hokk-stockline';
            if (stockText) stockText.textContent = 'In stock, ships in 2 working days';
          } else {
            submitBtn.disabled = true;
            submitText.textContent = 'Sold out';
            if (stockLine) stockLine.className = 'hokk-stockline out';
            if (stockText) stockText.textContent = 'Sold out';
          }
        }
      }
    }

    function initGallery() {
      const thumbs = document.querySelectorAll('.hokk-thumb-btn');
      const mainImg = document.getElementById('hokkMainImg');
      const mainCap = document.getElementById('hokkCaption');

      thumbs.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbs.forEach(b => {
            b.setAttribute('aria-selected', 'false');
            b.setAttribute('aria-current', 'false');
          });
          btn.setAttribute('aria-selected', 'true');
          btn.setAttribute('aria-current', 'true');

          const newSrc = btn.dataset.src;
          const newCap = btn.dataset.caption;
          if (mainImg && newSrc) {
            mainImg.style.opacity = '0.4';
            setTimeout(() => {
              mainImg.src = newSrc;
              mainImg.style.opacity = '1';
            }, 100);
          }
          if (mainCap && newCap) {
            mainCap.textContent = newCap;
          }
        });
      });
    }

    // 5. Quantity, Swatch & Size Controls
    function initControls() {
      const qMinus = document.getElementById('qtyMinus');
      const qPlus = document.getElementById('qtyPlus');
      const qVal = document.getElementById('qtyDisplay');
      const qInput = document.getElementById('HokkQuantityInput');
      let qty = 1;

      if (qMinus && qPlus && qVal && qInput) {
        qMinus.addEventListener('click', () => {
          if (qty > 1) {
            qty--;
            qVal.textContent = qty;
            qInput.value = qty;
          }
        });
        qPlus.addEventListener('click', () => {
          qty++;
          qVal.textContent = qty;
          qInput.value = qty;
        });
      }

      // Swatches color matching and image filtering
      const swatches = document.querySelectorAll('.hokk-swatch');
      const colName = document.getElementById('colName');
      swatches.forEach(sw => {
        const val = (sw.dataset.value || '').toLowerCase().trim();
        for (const [cName, cHex] of Object.entries(COLOR_PALETTE)) {
          if (val.includes(cName)) {
            sw.style.backgroundColor = cHex;
            break;
          }
        }
        sw.addEventListener('click', () => {
          swatches.forEach(s => s.setAttribute('aria-pressed', 'false'));
          sw.setAttribute('aria-pressed', 'true');
          const colorVal = sw.dataset.value;
          if (colName && colorVal) {
            colName.textContent = colorVal;
          }
          filterGalleryByColor(colorVal);
          updateActiveVariant();
        });
      });

      // Sizes buttons
      const sizeBtns = document.querySelectorAll('.hokk-size-btn');
      sizeBtns.forEach(sb => {
        sb.addEventListener('click', () => {
          sizeBtns.forEach(s => s.setAttribute('aria-pressed', 'false'));
          sb.setAttribute('aria-pressed', 'true');
          updateActiveVariant();
        });
      });

      // Size Guide link opens accordion
      const sgBtn = document.getElementById('openSizeGuideBtn');
      const accSg = document.getElementById('accSizeGuide');
      if (sgBtn && accSg) {
        sgBtn.addEventListener('click', (e) => {
          e.preventDefault();
          accSg.open = true;
          accSg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }

      // Initialize gallery for the default selected color
      const initialSwatch = document.querySelector('.hokk-swatch[aria-pressed="true"]');
      if (initialSwatch && initialSwatch.dataset.value) {
        filterGalleryByColor(initialSwatch.dataset.value);
      } else {
        // Fallback for products without color options: show only first 4 thumbnails
        const thumbs = document.querySelectorAll('.hokk-thumb-btn');
        thumbs.forEach((btn, idx) => {
          if (idx >= 4) btn.style.display = 'none';
        });
      }
    }

    // Initialize upon DOM readiness
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        parseProductDescription();
        initGallery();
        initControls();
      });
    } else {
      parseProductDescription();
      initGallery();
      initControls();
    }
  })();
</script>

