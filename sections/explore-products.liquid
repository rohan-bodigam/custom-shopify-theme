          "limit": 24
        },
        {
          "type": "header",
          "content": "Group 2 (Optional)"
        },
        {
          "type": "text",
          "id": "group_2_heading",
          "label": "Group 2 Subheading",
          "default": "More for her"
        },
        {
          "type": "collection_list",
          "id": "collections_2",
          "label": "Select Collections (Group 2)",
          "limit": 24
        }
      ]
    },
    {
      "type": "card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab Name",
          "default": "Women",
          "info": "Name of the tab this card appears in (e.g. Women, Men, Kids, Pets)"
        },
        {
          "type": "text",
          "id": "group_heading",
          "label": "Group Subheading (Optional)",
