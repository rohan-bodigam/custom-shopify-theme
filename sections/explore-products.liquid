  ],
  "presets": [
    {
      "name": "Explore Products (Tabs)",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Women",
            "tab_id": "Women",
            "group_1_heading": "Sarees, by weave",
            "group_2_heading": "More for her"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Men",
            "tab_id": "Men",
            "group_1_heading": ""
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Kids",
            "tab_id": "Kids",
            "group_1_heading": ""
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Pets",
            "tab_id": "Pet",
            "group_1_heading": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
