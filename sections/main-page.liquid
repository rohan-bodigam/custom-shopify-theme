{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'section-thank-you.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_thank_you = false
  if section.settings.layout_type == 'thank_you'
    assign is_thank_you = true
  elsif section.settings.layout_type == 'auto'
    if page.handle contains 'thank' or page.handle contains 'order'
      assign is_thank_you = true
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ThankYou-{{ section.id }} {
    --ty-bg: {{ section.settings.bg_color | default: '#FAF6F0' }};
    --ty-text: {{ section.settings.text_color | default: '#171717' }};
    --ty-ink: {{ section.settings.text_color | default: '#171717' }};
    --ty-crimson: {{ section.settings.accent_crimson | default: '#5C1D24' }};
    --ty-dot: {{ section.settings.badge_dot_color | default: '#6B2230' }};
    --ty-border: {{ section.settings.border_color | default: '#D6C6B8' }};
    --ty-muted: #4A4240;
  }
{%- endstyle -%}

{%- if is_thank_you -%}
  <div id="ThankYou-{{ section.id }}" class="thank-you-hero section-{{ section.id }}-padding">
    <div class="thank-you-hero__wrap">
      <div class="thank-you-hero__grid">
        <!-- LEFT COLUMN: Content -->
        <div class="thank-you-hero__content">
          {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
            <div class="thank-you-hero__badge">
              <span class="thank-you-hero__badge-dot" aria-hidden="true"></span>
              <span class="thank-you-hero__badge-text">{{ section.settings.badge_text | escape }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h1 class="thank-you-hero__title">
              {{ section.settings.heading }}
            </h1>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <p class="thank-you-hero__subheading">
              {{ section.settings.subheading | escape }}
            </p>
          {%- endif -%}

          {%- if section.settings.show_action and section.settings.action_text != blank -%}
            <div class="thank-you-hero__action-wrap">
              <a href="{{ section.settings.action_url | default: '#story' }}" class="thank-you-hero__action-link">
                <span class="thank-you-hero__action-text">{{ section.settings.action_text | escape }}</span>
                <span class="thank-you-hero__action-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M19 12l-7 7-7-7"/>
                  </svg>
                </span>
              </a>
            </div>
          {%- endif -%}
        </div>

        <!-- RIGHT COLUMN: Visual Composite -->
        <div class="thank-you-hero__visual">
          <div class="thank-you-hero__arch-container">
            <!-- Decorative offset frame line -->
            {%- if section.settings.show_decorative_frame -%}
              <div class="thank-you-hero__arch-frame" aria-hidden="true"></div>
            {%- endif -%}

            <!-- Main Arch Window -->
            <div class="thank-you-hero__arch-window">
              {%- if section.settings.main_image != blank -%}
                {{
                  section.settings.main_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'thank-you-hero__arch-img',
                    alt: section.settings.heading | default: 'House of Kala Katha Family',
                    loading: 'eager',
                    fetchpriority: 'high'
                }}
              {%- else -%}
                <img
                  src="{{ 'thank-you-family.jpg' | asset_url }}"
                  alt="House of Kala Katha - Stories of India"
                  class="thank-you-hero__arch-img"
                  loading="eager"
                  fetchpriority="high"
                  width="420"
                  height="512"
                >
              {%- endif -%}
            </div>

            <!-- Overlapping Circular Stamp (Top Right) -->
            {%- if section.settings.show_seal -%}
              <div class="thank-you-hero__seal-wrap" aria-label="{{ section.settings.seal_text | default: 'Stories of India • Woven for You' | escape }}">
                <svg viewBox="0 0 160 160" class="thank-you-hero__seal-svg{% if section.settings.enable_seal_rotation %} rotate-slow{% endif %}" aria-hidden="true">
                  <defs>
                    <path id="thank-you-seal-circle-{{ section.id }}" d="M 80, 80 m -58, 0 a 58,58 0 1,1 116,0 a 58,58 0 1,1 -116,0" />
                  </defs>
                  <circle cx="80" cy="80" r="76" class="thank-you-hero__seal-bg" />
                  <text class="thank-you-hero__seal-text">
                    <textPath href="#thank-you-seal-circle-{{ section.id }}" startOffset="50%" text-anchor="middle">
                      {{ section.settings.seal_text | default: '• STORIES OF INDIA • WOVEN FOR YOU •' }}
                    </textPath>
                  </text>
                </svg>

                <div class="thank-you-hero__seal-center">
                  {%- if section.settings.seal_image != blank -%}
                    {{
                      section.settings.seal_image
                      | image_url: width: 120
                      | image_tag: class: 'thank-you-hero__seal-logo', alt: 'Monogram'
                    }}
                  {%- else -%}
                    <!-- House of Kala Katha Monogram (Letter K + Loom Shuttle + Warp) -->
                    <svg viewBox="0 0 54 44" class="thank-you-hero__seal-logo-svg" fill="none" stroke="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke-width="1.8">
                      <!-- Vertical Warp Threads -->
                      <line x1="20" y1="6" x2="20" y2="38" stroke="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke-width="1.4" opacity="0.6"/>
                      <line x1="26" y1="6" x2="26" y2="38" stroke="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke-width="1.4" opacity="0.6"/>
                      <line x1="32" y1="6" x2="32" y2="38" stroke="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke-width="1.4" opacity="0.6"/>
                      <!-- Horizontal Shuttle -->
                      <rect x="8" y="19" width="38" height="6" rx="3" fill="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke="none"/>
                      <circle cx="27" cy="22" r="1.5" fill="#FAF6F0"/>
                      <!-- Monogram Stem & Arms -->
                      <path d="M14 8v28M14 22l18-14M14 22l20 16" stroke="{{ section.settings.accent_crimson | default: '#6B2230' }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            <!-- Overlapping Floating Photo Badge (Bottom Left) -->
            {%- if section.settings.show_floating_badge -%}
              <div class="thank-you-hero__floating-badge">
                {%- if section.settings.floating_image != blank -%}
                  {{
                    section.settings.floating_image
                    | image_url: width: 400
                    | image_tag:
                      class: 'thank-you-hero__floating-img',
                      alt: 'Artisan weaving on loom',
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <img
                    src="{{ 'thank-you-loom.jpg' | asset_url }}"
                    alt="Artisan handloom weaving"
                    class="thank-you-hero__floating-img"
                    loading="lazy"
                    width="136"
                    height="136"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Additional Customizable Blocks below hero -->
      {%- if section.blocks.size > 0 -%}
        <div id="story" class="thank-you-hero__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'founder_note' -%}
                <div class="thank-you-hero__block thank-you-hero__block--founder-note" {{ block.shopify_attributes }}>
                  {%- if block.settings.kicker != blank -%}
                    <span class="thank-you-hero__block-kicker">{{ block.settings.kicker | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h2 class="thank-you-hero__block-title">{{ block.settings.title | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="thank-you-hero__block-text">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.author != blank -%}
                    <p style="margin-top: 18px; font-weight: 600; font-family: var(--f-ui, sans-serif); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ty-crimson, #6B2230);">
                      {{ block.settings.author | escape }}
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'buttons' -%}
                <div class="thank-you-hero__block thank-you-hero__block-buttons" {{ block.shopify_attributes }}>
                  {%- if block.settings.btn1_label != blank -%}
                    <a href="{{ block.settings.btn1_link | default: routes.all_products_collection_url }}" class="thank-you-hero__btn thank-you-hero__btn--primary">
                      {{ block.settings.btn1_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.btn2_label != blank -%}
                    <a href="{{ block.settings.btn2_link | default: '/blogs/journal' }}" class="thank-you-hero__btn thank-you-hero__btn--secondary">
                      {{ block.settings.btn2_label | escape }}
                    </a>
                  {%- endif -%}
                </div>

              {%- when 'rich_text' -%}
                <div class="thank-you-hero__block thank-you-hero__story-wrap rte" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h2 class="h2">{{ block.settings.title | escape }}</h2>
                  {%- endif -%}
                  {{ block.settings.text }}
                </div>

              {%- when 'custom_liquid' -%}
                <div class="thank-you-hero__block" {{ block.shopify_attributes }}>
                  {{ block.settings.custom_liquid }}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- elsif section.settings.show_page_content and page.content != blank -%}
        <div id="story" class="thank-you-hero__story-wrap rte">
          {{ page.content }}
        </div>
      {%- endif -%}
    </div>
  </div>

{%- else -%}
  <!-- STANDARD PAGE LAYOUT (Default Dawn) -->
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page / Thank You Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Mode"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Page Layout Style",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (Thank You design for thank-you pages, standard for others)"
        },
        {
          "value": "thank_you",
          "label": "Thank You Hero Layout (Matches reference screenshot)"
        },
        {
          "value": "standard",
          "label": "Standard Page Layout"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent_crimson",
      "label": "Crimson Title Color",
      "default": "#5C1D24"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border & Frame Line Color",
      "default": "#D6C6B8"
    },
    {
      "type": "header",
      "content": "Status Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Status Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "ORDER CONFIRMED"
    },
    {
      "type": "color",
      "id": "badge_dot_color",
      "label": "Badge Dot Color",
      "default": "#6B2230"
    },
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Main Heading (supports <br> for line breaks)",
      "default": "THANK<br>YOU."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading / Dek",
      "default": "With one choice, you have become part of a much larger story. Here is what it set in motion."
    },
    {
      "type": "header",
      "content": "Action Link (Scroll / CTA)"
    },
    {
      "type": "checkbox",
      "id": "show_action",
      "label": "Show Action Link",
      "default": true
    },
    {
      "type": "text",
      "id": "action_text",
      "label": "Action Link Text",
      "default": "See what your choice made possible"
    },
    {
      "type": "url",
      "id": "action_url",
      "label": "Action Link URL / Anchor",
      "info": "Set to #story to smooth-scroll to content below, or link to another page."
    },
    {
      "type": "header",
      "content": "Main Arch Image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Arch Image (Family / Handloom Portrait)"
    },
    {
      "type": "checkbox",
      "id": "show_decorative_frame",
      "label": "Show Offset Decorative Frame Line",
      "default": true
    },
    {
      "type": "header",
      "content": "Top-Right Circular Seal"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show Circular Seal Stamp",
      "default": true
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Seal Circular Text",
      "default": "• STORIES OF INDIA • WOVEN FOR YOU •"
    },
    {
      "type": "image_picker",
      "id": "seal_image",
      "label": "Seal Custom Monogram / Logo (Optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_seal_rotation",
      "label": "Enable Slow Rotating Animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom-Left Floating Badge"
    },
    {
      "type": "checkbox",
      "id": "show_floating_badge",
      "label": "Show Floating Loom Photo Badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "floating_image",
      "label": "Floating Photo (Artisan / Loom Weaving)"
    },
    {
      "type": "header",
      "content": "Page Content & Story"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show Standard Page Content Below Hero",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "founder_note",
      "name": "Founder's Note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker / Pre-heading",
          "default": "A NOTE FROM OUR FOUNDER"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Woven for You"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Thank you for choosing a piece from House of Kala Katha.</p><p>What you have ordered passed through many hands before it reached ours: someone who grew or gathered the fibre, someone who spun or dyed it, and a weaver who spent days, sometimes weeks, turning it into cloth. We started this house because we wanted those hands to be seen, and because we believe India’s textiles belong in everyday wardrobes, not only in wedding trunks.</p><p>Wear it often. Handloom softens and deepens with use, and it is happiest when it is lived in.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author / Signature",
          "default": "House of Kala Katha"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Action Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "btn1_label",
          "label": "Primary Button Label",
          "default": "Continue Shopping"
        },
        {
          "type": "url",
          "id": "btn1_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "btn2_label",
          "label": "Secondary Button Label",
          "default": "Read the Journal"
        },
        {
          "type": "url",
          "id": "btn2_link",
          "label": "Secondary Button Link"
        }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Our Story"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share more about your orders, weavers or brand story.</p>"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid Code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thank You / Page",
      "settings": {
        "layout_type": "thank_you"
      }
    }
  ]
}
{% endschema %}
