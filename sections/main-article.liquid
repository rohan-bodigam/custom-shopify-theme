{%- liquid
  # Reading time calculation
  assign words = article.content | strip_html | split: ' ' | size
  assign read_time = words | divided_by: 200 | at_least: 1

  # Category detection for breadcrumbs
  assign category_tag = ''
  for tag in article.tags
    assign tag_lower = tag | downcase
    unless tag_lower contains 'india' or tag_lower contains 'west' or tag_lower contains 'east' or tag_lower contains 'south' or tag_lower contains 'north'
      assign category_tag = tag
      break
    endunless
  endfor
  if category_tag == blank
    assign category_tag = section.settings.default_category | default: 'Weaves'
  endif

  # Chapter tag and link detection
  assign chapter_name = ''
  assign chapter_link = ''
  for tag in article.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'west' or tag_lower contains 'central'
      assign chapter_name = 'West & Central India'
      assign chapter_link = '/pages/west-central-india'
    elsif tag_lower contains 'north east' or tag_lower contains 'northeast'
      assign chapter_name = 'North East India'
      assign chapter_link = '/pages/north-east-india'
    elsif tag_lower contains 'east'
      assign chapter_name = 'East India'
      assign chapter_link = '/pages/east-india'
    elsif tag_lower contains 'south'
      assign chapter_name = 'South India'
      assign chapter_link = '/pages/south-india'
    elsif tag_lower contains 'north'
      assign chapter_name = 'North India'
      assign chapter_link = '/pages/north-india'
    endif
  endfor

  if chapter_name == blank
    assign chapter_name = section.settings.default_chapter_name | default: 'West & Central India'
    assign chapter_link = section.settings.default_chapter_url | default: '/pages/culture'
  endif

  # Pre-assign alt text for cover image
  assign cover_alt = article.image.alt | default: article.title | escape
-%}

{%- style -%}
  #MainArticle-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background | default: '#F7F3EE' }};
    --art-heading: {{ section.settings.heading_color | default: '#171717' }};
    --art-text: {{ section.settings.text_color | default: '#373330' }};
    --art-muted: {{ section.settings.muted_color | default: '#57534E' }};
    --art-accent: {{ section.settings.accent_color | default: '#6B2230' }};
    --art-gold: {{ section.settings.quote_border_color | default: '#C4A482' }};
    --art-radius: {{ section.settings.image_border_radius | default: 12 }}px;
  }

  .article-single {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .article-single__container {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding-left: clamp(20px, 4.5vw, 40px);
    padding-right: clamp(20px, 4.5vw, 40px);
    box-sizing: border-box;
  }

  /* Breadcrumbs */
  .article-single__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.88rem;
    color: #78716C;
    margin-bottom: 22px;
    line-height: 1.4;
  }

  .article-single__crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-single__crumbs a:hover {
    color: var(--art-heading, #171717);
    text-decoration: underline;
  }

  .article-single__crumbs span[aria-current="page"] {
    color: var(--art-heading, #171717);
  }

  /* Article Header */
  .article-single__header {
    margin-bottom: 28px;
  }

  .article-single__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(2.3rem, 4.5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0.02em;
    color: var(--art-heading, #171717);
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  .article-single__lede {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--art-muted, #57534E);
    margin: 0 0 16px 0;
  }

  .article-single__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.92rem;
    color: var(--art-muted, #57534E);
  }

  .article-single__chapter-link {
    color: var(--art-accent, #6B2230);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .article-single__chapter-link:hover {
    opacity: 0.8;
  }

  /* Cover Image */
  .article-single__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--art-radius, 12px);
    overflow: hidden;
    background-color: #EAE3D9;
    box-shadow: 0 10px 32px -4px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.03);
    margin: 28px 0 36px 0;
  }

  .article-single__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-single__cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #EFE9E2;
  }

  .article-single__cover-placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.35;
  }

  /* Editorial Prose Content */
  .article-prose {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--art-text, #373330);
  }

  .article-prose p {
    margin: 0 0 1.6em 0;
  }

  /* Drop Cap for first letter */
  {%- if section.settings.enable_drop_cap -%}
    .article-prose > p:first-of-type::first-letter,
    .article-prose p:first-child::first-letter {
      font-family: var(--f-edit, 'Forum', Georgia, serif);
      font-size: 4rem;
      line-height: 0.82;
      float: left;
      margin: 6px 12px 0 0;
      color: var(--art-accent, #6B2230);
      font-weight: 400;
    }
  {%- endif -%}

  /* Pull-Quote / Blockquote */
  .article-prose blockquote {
    margin: 36px 0;
    padding: 8px 0 8px 24px;
    border-left: 2.5px solid var(--art-gold, #C4A482);
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(1.3rem, 1.8vw, 1.55rem);
    line-height: 1.45;
    color: var(--art-heading, #171717);
    font-style: normal;
  }

  .article-prose blockquote p {
    margin: 0;
  }

  .article-prose h2,
  .article-prose h3 {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-weight: 400;
    line-height: 1.25;
    color: var(--art-heading, #171717);
    margin: 40px 0 16px 0;
  }

  .article-prose h2 {
    font-size: clamp(1.7rem, 2.4vw, 2.1rem);
  }

  .article-prose h3 {
    font-size: clamp(1.4rem, 1.8vw, 1.65rem);
  }

  .article-prose img {
    border-radius: var(--art-radius, 12px);
    max-width: 100%;
    height: auto;
    margin: 28px 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .article-prose a {
    color: var(--art-accent, #6B2230);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Back to Journal Footer Link */
  .article-single__footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #E6DFD5;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .article-single__back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--art-accent, #6B2230);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .article-single__back-btn:hover {
    transform: translateX(-4px);
  }

  /* Responsive Mobile */
  @media screen and (max-width: 768px) {
    .article-single__title {
      font-size: clamp(1.9rem, 6.5vw, 2.4rem);
    }

    .article-prose {
      font-size: 1rem;
      line-height: 1.75;
    }

    .article-prose > p:first-of-type::first-letter,
    .article-prose p:first-child::first-letter {
      font-size: 3.4rem;
      margin: 4px 10px 0 0;
    }
  }
{%- endstyle -%}

<article
  id="MainArticle-{{ section.id }}"
  class="article-single"
  data-section-id="{{ section.id }}"
>
  <div class="article-single__container">

    {% comment %} Breadcrumbs {% endcomment %}
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="article-single__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Home' | escape }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ blog.url | default: '/blogs/journal' }}">{{ blog.title | default: 'Journal' | escape }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ category_tag | escape }}</span>
      </nav>
    {%- endif -%}

    {% comment %} Article Header {% endcomment %}
    <header class="article-single__header">
      <h1 class="article-single__title">
        {{ article.title | escape }}
      </h1>

      {% comment %} Lede / Excerpt {% endcomment %}
      {%- if article.excerpt != blank -%}
        <p class="article-single__lede">
          {{ article.excerpt | strip_html }}
        </p>
      {%- elsif section.settings.show_demo_lede -%}
        <p class="article-single__lede">
          {{ section.settings.demo_lede | default: 'The tiny square checks of Kota Doria are not printed. They are made by the way the cloth is woven.' | escape }}
        </p>
      {%- endif -%}

      {% comment %} Meta: Date · Read Time · Chapter Link {% endcomment %}
      <div class="article-single__meta">
        {%- if section.settings.show_date -%}
          <span>{{ article.published_at | date: '%-d %B %Y' }}</span>
        {%- endif -%}

        {%- if section.settings.show_read_time -%}
          <span>{% if section.settings.show_date %} · {% endif %}{{ read_time }} min read</span>
        {%- endif -%}

        {%- if section.settings.show_chapter and chapter_name != blank -%}
          <span>· <a href="{{ chapter_link }}" class="article-single__chapter-link">{{ chapter_name | escape }}</a></span>
        {%- endif -%}
      </div>
    </header>

    {% comment %} Featured Cover Image {% endcomment %}
    <div class="article-single__cover">
      {%- if article.image != blank -%}
        {{
          article.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            widths: '600, 900, 1200, 1600',
            alt: cover_alt,
            class: 'article-single__cover-img'
        }}
      {%- else -%}
        <div class="article-single__cover-placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {% comment %} Article Prose Content {% endcomment %}
    <div class="article-prose">
      {%- if article.content != blank and article.content != empty -%}
        {{ article.content }}
      {%- else -%}
        {% comment %} Preview content matching the screenshot {% endcomment %}
        <p>Kota Doria, also called Kota Masuria, is woven in and around Kaithoon, a village near Kota in Rajasthan. It is easiest to recognise by its checks: a grid of small squares, called khats, spread across the whole cloth.</p>
        <p>The squares are formed by the weave itself. Cotton and silk threads are interlaced on a loom with a wide-set reed, which leaves tiny open spaces between them. That is why Kota Doria is so light and airy, and why it feels cool against the skin even in the Rajasthan summer.</p>
        <blockquote>Light enough to forget, bright enough to remember.</blockquote>
        <p>Zari Kota adds a thread of metallic zari to the border and sometimes the body. The cloth stays light, but picks up a quiet shine, which is why it is a favourite for daytime weddings and festive occasions.</p>
        <p>When you buy Kota Doria, hold it up to the light. You should be able to see a clear grid of small squares and a loose, open structure. A printed check on ordinary cloth looks flat and has no air in it.</p>
      {%- endif -%}
    </div>

    {% comment %} Back to Journal Navigation {% endcomment %}
    <footer class="article-single__footer">
      <a href="{{ blog.url | default: '/blogs/journal' }}" class="article-single__back-btn">
        ← {{ section.settings.back_label | default: 'Back to all stories' | escape }}
      </a>
    </footer>

  </div>
</article>

{% schema %}
{
  "name": "Single Article Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs & Category"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "default_category",
      "label": "Default category label",
      "default": "Weaves",
      "info": "Used in breadcrumbs if article has no category tag."
    },
    {
      "type": "header",
      "content": "Metadata"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show estimated read time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_chapter",
      "label": "Show chapter link",
      "default": true
    },
    {
      "type": "text",
      "id": "default_chapter_name",
      "label": "Default chapter label",
      "default": "West & Central India"
    },
    {
      "type": "url",
      "id": "default_chapter_url",
      "label": "Default chapter link"
    },
    {
      "type": "header",
      "content": "Editorial Styling"
    },
    {
      "type": "checkbox",
      "id": "enable_drop_cap",
      "label": "Enable large drop cap for first paragraph",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Drop cap & link accent color",
      "default": "#6B2230"
    },
    {
      "type": "color",
      "id": "quote_border_color",
      "label": "Pull-quote gold border color",
      "default": "#C4A482"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#373330"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted / lede color",
      "default": "#57534E"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "Back to all stories"
    },
    {
      "type": "header",
      "content": "Preview Demo Helper"
    },
    {
      "type": "checkbox",
      "id": "show_demo_lede",
      "label": "Show demo lede if article has no excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "demo_lede",
      "label": "Demo lede text",
      "default": "The tiny square checks of Kota Doria are not printed. They are made by the way the cloth is woven."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ]
}
{% endschema %}
