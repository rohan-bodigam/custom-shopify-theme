{%- comment -%}
  Cart footer is integrated directly into main-cart-items for the luxury 2-column bag layout.
  Hidden element kept for compatibility.
{%- endcomment -%}
<div
  class="hidden"
  id="main-cart-footer"
  data-id="{{ section.id }}"
  style="display: none !important;"
>
  <div class="js-contents"></div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper hidden",
  "settings": [],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
