{{ 'section-chapter.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Automatic default fallback based on page handle if setting is left blank
  assign current_handle = page.handle

  assign default_p1 = 'The Ganga and Brahmaputra meet the sea in the world’s largest delta. Warm, wet air favours fine cotton, and for centuries Bengal’s weavers worked near river ports, so cloth moved quickly from loom to market and from there across the world.'
  assign default_p2 = 'Fine cotton asks for patience. Yarn that is spun thin is fragile, and a weaver in a humid climate has a real advantage: damp air keeps the thread from snapping. Many of the traditional centres sit close to water for exactly this reason.'
  assign default_p3 = 'Today, mul cotton is woven and finished in several parts of the country, but its reputation still points east. It is the soft, plain-spoken cloth behind summer sarees, kurtas and shirts, and the base for stripes, checks and woven borders.'

  if current_handle == 'west-central-india'
    assign default_p1 = 'Between the Thar desert and the Vindhya hills runs the Narmada river. Kaithoon, near Kota, sits where the Chambal river flows through southeastern Rajasthan. Maheshwar stands directly on the sacred Narmada in Madhya Pradesh.'
    assign default_p2 = 'Both places rely on light, breathable weaves developed to withstand ferocious summer heat. The square-grid structure of Kota Doria, called khat, provides natural ventilation.'
    assign default_p3 = 'Today, Maheshwari and Kota Doria are treasured across India for their featherlight presence, subtle lustre and rich history of royal patronage.'
  elsif current_handle == 'south-india'
    assign default_p1 = 'From the Kaveri delta to the Deccan plateau, South India’s weaving centres developed around sacred temple corridors.'
    assign default_p2 = 'Water rich in minerals from rivers like the Bhavani and Kaveri was crucial for dyeing yarn in deep, fast shades of madder, turmeric and indigo.'
    assign default_p3 = 'Generations of weaver communities settled in agraharams and dedicated streets around temple complexes, where cloth was woven as daily ritual.'
  elsif current_handle == 'north-india'
    assign default_p1 = 'Northern India’s textile landscape is marked by extreme seasonal contrasts. In the Kashmir valley, cold winds demanded fine pashmina and sheep wool spun into warm shawls.'
    assign default_p2 = 'Across Uttar Pradesh, courtly centres like Lucknow refined the art of shadow work and white-on-white embroidery (chikankari) on airy mulmul.'
    assign default_p3 = 'The plains along the Yamuna and Ganga served as trade hubs where Himalayan wool met Gangetic cotton.'
  elsif current_handle == 'north-east-india'
    assign default_p1 = 'Flanked by the eastern Himalayas and fed by the Brahmaputra, the North East has a unique temperate and sub-tropical climate where indigenous silk moths thrive.'
    assign default_p2 = 'Wild silks like Muga (golden silk) and Eri (peace silk) are cultivated in outdoor forests and woven on domestic looms in nearly every rural homestead.'
    assign default_p3 = 'The landscape’s rivers, hills and dense bamboo groves directly inspire the bold, angular motifs and durable weaves of the eight states.'
  endif

  assign heading = section.settings.heading | default: 'The landscape behind the loom'
  assign p1 = section.settings.paragraph_1 | default: default_p1
  assign p2 = section.settings.paragraph_2 | default: default_p2
  assign p3 = section.settings.paragraph_3 | default: default_p3
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ChapterLandscape-{{ section.id }} {
    --landscape-bg: {{ section.settings.background_color }};
  }
{%- endstyle -%}

<section
  id="ChapterLandscape-{{ section.id }}"
  class="chapter-landscape-section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
>
  <div class="chapter-landscape__container">
    <div class="chapter-landscape__grid{% if section.settings.image_position_mobile == 'above_text' %} chapter-landscape__grid--media-above{% endif %}">
      <div class="chapter-landscape__content">
        {%- if heading != blank -%}
          <h2 class="chapter-landscape__heading">{{ heading | escape }}</h2>
        {%- endif -%}

        <div class="chapter-landscape__prose">
          {%- if p1 != blank -%}
            <p>{{ p1 | escape }}</p>
          {%- endif -%}
          {%- if p2 != blank -%}
            <p>{{ p2 | escape }}</p>
          {%- endif -%}
          {%- if p3 != blank -%}
            <p>{{ p3 | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="chapter-landscape__media-wrap">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400',
              alt: section.settings.image.alt | default: heading | escape
          }}
        {%- else -%}
          <div class="chapter-landscape__placeholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chapter Landscape",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Landscape / Weaver Image"
    },
    {
      "type": "header",
      "content": "Story Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The landscape behind the loom"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "info": "Leave blank to auto-detect based on region"
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "info": "Leave blank to auto-detect based on region"
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "info": "Leave blank to auto-detect based on region"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image position on mobile",
      "options": [
        { "value": "below_text", "label": "Below text" },
        { "value": "above_text", "label": "Above text" }
      ],
      "default": "below_text"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Chapter Landscape"
    }
  ]
}
{% endschema %}
