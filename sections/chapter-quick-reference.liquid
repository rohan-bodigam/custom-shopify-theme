{{ 'section-chapter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_col_1 = false
  if section.settings.col_1_label != blank
    assign show_col_1 = true
  endif

  assign show_col_2 = false
  if section.settings.col_2_label != blank
    assign show_col_2 = true
  endif

  assign show_col_3 = false
  if section.settings.col_3_label != blank
    assign show_col_3 = true
  endif

  assign show_col_4 = false
  if section.settings.col_4_label != blank
    assign show_col_4 = true
  endif

  assign show_col_5 = false
  if section.settings.col_5_label != blank
    assign show_col_5 = true
  endif

  assign show_col_6 = false
  if section.settings.col_6_label != blank
    assign show_col_6 = true
  endif

  assign col_count = 0
  if show_col_1
    assign col_count = col_count | plus: 1
  endif
  if show_col_2
    assign col_count = col_count | plus: 1
  endif
  if show_col_3
    assign col_count = col_count | plus: 1
  endif
  if show_col_4
    assign col_count = col_count | plus: 1
  endif
  if show_col_5
    assign col_count = col_count | plus: 1
  endif
  if show_col_6
    assign col_count = col_count | plus: 1
  endif

  # Fallback if all column labels were left blank
  if col_count == 0
    assign show_col_1 = true
    assign show_col_2 = true
    assign show_col_3 = true
    assign col_count = 3
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ChapterRef-{{ section.id }} {
    --ref-bg: {{ section.settings.background_color }};
    --ref-card-bg: {{ section.settings.card_background_color }};
    --ref-th-bg: {{ section.settings.header_background_color }};
    --ref-border-color: {{ section.settings.border_color }};
  }
{%- endstyle -%}

<section
  id="ChapterRef-{{ section.id }}"
  class="chapter-reference-section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
>
  <div class="chapter-reference__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="chapter-reference__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="chapter-reference__card">
      <div class="chapter-reference__table-wrap">
        <table
          class="chapter-reference__table{% if col_count <= 3 %} chapter-reference__table--compact{% endif %}"
          data-columns="{{ col_count }}"
        >
          <thead>
            <tr>
              {%- if show_col_1 -%}
                <th scope="col">{{ section.settings.col_1_label | escape }}</th>
              {%- endif -%}
              {%- if show_col_2 -%}
                <th scope="col">{{ section.settings.col_2_label | escape }}</th>
              {%- endif -%}
              {%- if show_col_3 -%}
                <th scope="col">{{ section.settings.col_3_label | escape }}</th>
              {%- endif -%}
              {%- if show_col_4 -%}
                <th scope="col">{{ section.settings.col_4_label | escape }}</th>
              {%- endif -%}
              {%- if show_col_5 -%}
                <th scope="col">{{ section.settings.col_5_label | escape }}</th>
              {%- endif -%}
              {%- if show_col_6 -%}
                <th scope="col">{{ section.settings.col_6_label | escape }}</th>
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- liquid
                assign val_1 = block.settings.col_1 | default: block.settings.craft
                assign val_2 = block.settings.col_2 | default: block.settings.place
                assign val_3 = block.settings.col_3 | default: block.settings.technique
                assign val_4 = block.settings.col_4 | default: block.settings.material
                assign val_5 = block.settings.col_5 | default: block.settings.look
                assign val_6 = block.settings.col_6
              -%}
              <tr {{ block.shopify_attributes }}>
                {%- if show_col_1 -%}
                  <td>{{ val_1 | escape }}</td>
                {%- endif -%}
                {%- if show_col_2 -%}
                  <td>{{ val_2 | escape }}</td>
                {%- endif -%}
                {%- if show_col_3 -%}
                  <td>{{ val_3 | escape }}</td>
                {%- endif -%}
                {%- if show_col_4 -%}
                  <td>{{ val_4 | escape }}</td>
                {%- endif -%}
                {%- if show_col_5 -%}
                  <td>{{ val_5 | escape }}</td>
                {%- endif -%}
                {%- if show_col_6 -%}
                  <td>{{ val_6 | escape }}</td>
                {%- endif -%}
              </tr>
            {%- else -%}
              {% comment %} Fallback row if no blocks exist {% endcomment %}
              <tr>
                {%- if show_col_1 -%}<td>Mul Cotton</td>{%- endif -%}
                {%- if show_col_2 -%}<td>Bengal tradition, woven across several clusters</td>{%- endif -%}
                {%- if show_col_3 -%}<td>Plain or lightly patterned weave on handloom</td>{%- endif -%}
                {%- if show_col_4 -%}<td>Very fine soft cotton</td>{%- endif -%}
                {%- if show_col_5 -%}<td>Light, slightly crinkled hand and a soft drape</td>{%- endif -%}
                {%- if show_col_6 -%}<td></td>{%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chapter Quick Reference",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick reference"
    },
    {
      "type": "header",
      "content": "Table Columns",
      "info": "Only columns with a header label will be displayed. Leave a column label blank to completely hide it."
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Column 1 header",
      "default": "Craft"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Column 2 header",
      "default": "Place",
      "info": "Leave blank to hide this column"
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Column 3 header",
      "default": "Technique",
      "info": "Leave blank to hide this column"
    },
    {
      "type": "text",
      "id": "col_4_label",
      "label": "Column 4 header",
      "default": "Material",
      "info": "Leave blank to hide this column"
    },
    {
      "type": "text",
      "id": "col_5_label",
      "label": "Column 5 header",
      "default": "Look",
      "info": "Leave blank to hide this column"
    },
    {
      "type": "text",
      "id": "col_6_label",
      "label": "Column 6 header",
      "info": "Optional: leave blank to hide"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#F6F2EA"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "header_background_color",
      "label": "Table header row background",
      "default": "#F7F4EE"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E8DFD5"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "table_row",
      "name": "Table Row",
      "settings": [
        {
          "type": "text",
          "id": "craft",
          "label": "Column 1 value (e.g. Craft / Name)",
          "default": "Mul Cotton"
        },
        {
          "type": "textarea",
          "id": "place",
          "label": "Column 2 value (e.g. Place / Traditional Use)",
          "default": "Bengal tradition, woven across several clusters"
        },
        {
          "type": "textarea",
          "id": "technique",
          "label": "Column 3 value (e.g. Technique / Contemporary application)",
          "default": "Plain or lightly patterned weave on handloom"
        },
        {
          "type": "textarea",
          "id": "material",
          "label": "Column 4 value (e.g. Material)",
          "default": "Very fine soft cotton"
        },
        {
          "type": "textarea",
          "id": "look",
          "label": "Column 5 value (e.g. Look / Details)",
          "default": "Light, slightly crinkled hand and a soft drape"
        },
        {
          "type": "textarea",
          "id": "col_6",
          "label": "Column 6 value (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
