          "settings": {
            "craft": "Baluchari",
            "place": "Bishnupur, Bankura district, West Bengal",
            "technique": "Jacquard handloom, figured pallu and border",
            "material": "Mulberry silk",
            "look": "Story pallus: scenes woven into the silk"
          }
        },
        {
          "type": "table_row",
          "settings": {
