{%- liquid
  assign target_blog = section.settings.blog | default: blog
  if target_blog == blank and article.blog != blank
    assign target_blog = article.blog
  endif
  if target_blog == blank
    assign target_blog = blogs['journal'] | default: blogs['news'] | default: blogs.first
  endif

  assign current_article_id = article.id
  assign articles_limit = section.settings.articles_to_show | default: 3
-%}

{%- style -%}
  #JournalStories-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background | default: '#F7F3EE' }};
    --j-heading: {{ section.settings.heading_color | default: '#171717' }};
    --j-text: {{ section.settings.text_color | default: '#57534E' }};
    --j-kicker: {{ section.settings.accent_color | default: '#9A3B46' }};
    --j-card-radius: {{ section.settings.card_border_radius | default: 10 }}px;
  }

  .journal-stories-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .journal-stories-sec__wrap {
    width: 100%;
    max-width: var(--page-width, 1340px);
    margin: 0 auto;
    padding-left: clamp(20px, 4.5vw, 60px);
    padding-right: clamp(20px, 4.5vw, 60px);
    box-sizing: border-box;
    position: relative;
  }

  .journal-stories-sec__header {
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }

  .journal-stories-sec__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--j-heading, #171717);
    margin: 0;
  }

  .journal-stories-sec__lede {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--j-text, #57534E);
    margin: 8px 0 0 0;
  }

  .journal-stories-sec__thread {
    position: absolute;
    right: 2%;
    top: 36%;
    width: clamp(240px, 35vw, 420px);
    height: auto;
    pointer-events: none;
    z-index: 1;
    opacity: 0.65;
  }

  /* Grid of Stories */
  .journal-stories-sec__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: '3' }}, 1fr);
    gap: clamp(28px, 3vw, 36px) clamp(20px, 2.2vw, 28px);
    position: relative;
    z-index: 2;
  }

  /* Journal Card Styles */
  .journal-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
  }

  .journal-card__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--j-card-radius, 10px);
    overflow: hidden;
    background-color: #EAE3D9;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    position: relative;
  }

  .journal-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journal-card:hover .journal-card__img {
    transform: scale(1.04);
  }

  .journal-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #EFE9E2;
  }

  .journal-card__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.35;
  }

  .journal-card__body {
    padding: 14px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .journal-card__kicker {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--j-kicker, #9A3B46);
    margin: 0 0 2px 0;
  }

  .journal-card__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(1.25rem, 1.5vw, 1.45rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--j-heading, #171717);
    margin: 0 0 4px 0;
    transition: color 0.2s ease;
  }

  .journal-card:hover .journal-card__title {
    color: #6B2230;
  }

  .journal-card__excerpt {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--j-text, #57534E);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-card__meta {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.82rem;
    color: #78716C;
    margin-top: 6px;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .journal-stories-sec__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 820px) {
    .journal-stories-sec__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{%- endstyle -%}

<section
  id="JournalStories-{{ section.id }}"
  class="journal-stories-sec"
  data-section-id="{{ section.id }}"
>
  <div class="journal-stories-sec__wrap">
    {%- if section.settings.show_thread_accent -%}
      <svg class="journal-stories-sec__thread" viewBox="0 0 500 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0,75 C160,105 320,40 500,10" stroke="#9A3B46" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />
      </svg>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="journal-stories-sec__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="journal-stories-sec__title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="journal-stories-sec__lede">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      # Count eligible articles
      assign display_count = 0
      if target_blog != blank and target_blog.articles.size > 0
        for art in target_blog.articles
          if current_article_id != blank and art.id == current_article_id
            continue
          endif
          assign display_count = display_count | plus: 1
        endfor
      endif
    -%}

    {%- if display_count > 0 -%}
      <div class="journal-stories-sec__grid">
        {%- assign rendered_so_far = 0 -%}
        {%- for art in target_blog.articles -%}
          {%- if current_article_id != blank and art.id == current_article_id -%}
            {%- continue -%}
          {%- endif -%}

          {%- render 'journal-card',
            article: art,
            show_tags: section.settings.show_tags,
            show_excerpt: section.settings.show_excerpt,
            excerpt_words: section.settings.excerpt_words,
            show_date: section.settings.show_date,
            show_read_time: section.settings.show_read_time,
            card_radius: section.settings.card_border_radius
          -%}

          {%- assign rendered_so_far = rendered_so_far | plus: 1 -%}
          {%- if rendered_so_far >= articles_limit -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- elsif section.settings.show_placeholder_cards -%}
      {% comment %} 3 Sample Handloom Stories matching House of Kala Katha design {% endcomment %}
      <div class="journal-stories-sec__grid">
        {%- render 'journal-card', sample_index: 1, card_radius: section.settings.card_border_radius -%}
        {%- render 'journal-card', sample_index: 2, card_radius: section.settings.card_border_radius -%}
        {%- render 'journal-card', sample_index: 3, card_radius: section.settings.card_border_radius -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Journal Stories Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All stories"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog to fetch stories from",
      "info": "Leave blank to use current journal/blog automatically."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Number of stories to show",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_thread_accent",
      "label": "Show red thread accent line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_cards",
      "label": "Show preview placeholder cards if blog has no other stories",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show category / region tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt text",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "min": 15,
      "max": 45,
      "step": 5,
      "label": "Excerpt word count",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show estimated read time",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors & Cards"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#57534E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Kicker / accent color",
      "default": "#9A3B46"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card image corner radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Journal Stories Grid",
      "settings": {
        "heading": "All stories",
        "articles_to_show": 6
      }
    },
    {
      "name": "More Stories (Single Article)",
      "settings": {
        "heading": "More stories",
        "articles_to_show": 3
      }
    }
  ]
}
{% endschema %}

