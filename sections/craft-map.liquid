{%- comment -%} Determine first active block {%- endcomment -%}
{%- assign first_block = section.blocks.first -%}

<section class="sec craft-map-sec section-{{ section.id }}-padding{% if section.settings.color_scheme == 'alt' %} alt{% endif %}" id="craftmap-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.show_warp -%}
          <span class="warp" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="d2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <p class="lede">{{ section.settings.lede | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="map-wrap">
      <!-- Left Column: Ornate Framed Plate & SVG Map -->
      <div>
        <div class="plate map-in" id="plate-{{ section.id }}">
          <svg viewBox="0 0 900 944" role="group" aria-label="Textile map of India showing the five chapters">
            <defs>
              {%- if section.settings.custom_map_image != blank -%}
                <image id="tmimg-{{ section.id }}" href="{{ section.settings.custom_map_image | image_url: width: 1200 }}" width="900" height="944"/>
              {%- else -%}
                <image id="tmimg-{{ section.id }}" href="{{ 'craft-map-india.webp' | asset_url }}" width="900" height="944"/>
              {%- endif -%}

              {%- comment -%} Generate ClipPaths for Each Block {%- endcomment -%}
              {%- for block in section.blocks -%}
                {%- assign reg_path = '' -%}
                {%- case block.settings.region_id -%}
                  {%- when 'north' -%}
                    {%- assign reg_path = north_path -%}
                  {%- when 'west' -%}
                    {%- assign reg_path = west_path -%}
                  {%- when 'east' -%}
                    {%- assign reg_path = east_path -%}
                  {%- when 'northeast' -%}
                    {%- assign reg_path = northeast_path -%}
                  {%- when 'south' -%}
                    {%- assign reg_path = south_path -%}
                {%- endcase -%}
                {%- if reg_path != blank -%}
                  <clipPath id="cl-{{ section.id }}-{{ block.settings.region_id }}">
                    <path d="{{ reg_path }}"/>
                  </clipPath>
                {%- endif -%}
              {%- endfor -%}

              <!-- SVG Lift Shadow Filter -->
              <filter id="lift-{{ section.id }}" x="-10%" y="-10%" width="120%" height="130%">
                <feDropShadow dx="0" dy="12" stdDeviation="9" flood-color="#1c0c0f" flood-opacity=".5"/>
              </filter>

              <!-- SVG Depth Shadow Filter -->
              <filter id="depth-{{ section.id }}" x="-6%" y="-6%" width="112%" height="116%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="2" result="b1"/>
                <feOffset in="b1" dy="2" result="o1"/>
                <feFlood class="sh1" result="f1"/>
                <feComposite in="f1" in2="o1" operator="in" result="s1"/>
                <feGaussianBlur in="SourceAlpha" stdDeviation="14" result="b2"/>
                <feOffset in="b2" dy="16" result="o2"/>
                <feFlood class="sh2" result="f2"/>
                <feComposite in="f2" in2="o2" operator="in" result="s2"/>
                <feMerge>
                  <feMergeNode in="s2"/>
                  <feMergeNode in="s1"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>

            <!-- Base Map Image with Depth Shadow -->
            <g class="base" filter="url(#depth-{{ section.id }})">
              {%- if section.settings.custom_map_image != blank -%}
                <image href="{{ section.settings.custom_map_image | image_url: width: 1200 }}" width="900" height="944"/>
              {%- else -%}
                <image href="{{ 'north.svg' | asset_url }}" width="900" height="944"/>
                <image href="{{ 'west.svg' | asset_url }}" width="900" height="944"/>
                <image href="{{ 'east.svg' | asset_url }}" width="900" height="944"/>
                <image href="{{ 'south.svg' | asset_url }}" width="900" height="944"/>
                <image href="{{ 'northeast.svg' | asset_url }}" width="900" height="944"/>
              {%- endif -%}
            </g>

            <!-- Region Lift-out Layers -->
            {%- for block in section.blocks -%}
              {%- assign reg_path = '' -%}
              {%- assign default_svg = '' -%}
              {%- case block.settings.region_id -%}
                {%- when 'north' -%}
                  {%- assign reg_path = north_path -%}
                  {%- assign default_svg = 'north.svg' -%}
                {%- when 'west' -%}
                  {%- assign reg_path = west_path -%}
                  {%- assign default_svg = 'west.svg' -%}
                {%- when 'east' -%}
                  {%- assign reg_path = east_path -%}
                  {%- assign default_svg = 'east.svg' -%}
                {%- when 'northeast' -%}
                  {%- assign reg_path = northeast_path -%}
                  {%- assign default_svg = 'northeast.svg' -%}
                {%- when 'south' -%}
                  {%- assign reg_path = south_path -%}
                  {%- assign default_svg = 'south.svg' -%}
              {%- endcase -%}

              {%- assign active_svg = block.settings.svg_filename | default: default_svg -%}

              {%- if reg_path != blank -%}
                <g class="rgn{% if forloop.first %} sel{% endif %}" data-r="{{ block.settings.region_id }}" data-block-id="{{ block.id }}" tabindex="0" role="button" aria-label="{{ block.settings.region_name | escape }}" style="--i:{{ forloop.index0 }};">
                  <g class="liftw" filter="url(#lift-{{ section.id }})">
                    {%- if block.settings.region_image != blank -%}
                      <g clip-path="url(#cl-{{ section.id }}-{{ block.settings.region_id }})">
                        <image href="{{ block.settings.region_image | image_url: width: 1200 }}" width="900" height="944" preserveAspectRatio="none"/>
                      </g>
                    {%- elsif active_svg != blank -%}
                      <image href="{{ active_svg | asset_url }}" width="900" height="944"/>
                    {%- else -%}
                      <g clip-path="url(#cl-{{ section.id }}-{{ block.settings.region_id }})">
                        <use href="#tmimg-{{ section.id }}"/>
                      </g>
                    {%- endif -%}
                  </g>
                  <path class="hit" d="{{ reg_path }}"/>
                  <path class="rim" d="{{ reg_path }}"/>
                </g>
              {%- endif -%}
            {%- endfor -%}

            <!-- Anchor Pill Tags -->
            {%- for block in section.blocks -%}
              {%- assign tag_x = 0 -%}
              {%- assign tag_y = 0 -%}
              {%- case block.settings.region_id -%}
                {%- when 'north' -%}
                  {%- assign tag_x = 308.5 -%}
                  {%- assign tag_y = 186.3 -%}
                {%- when 'west' -%}
                  {%- assign tag_x = 234.0 -%}
                  {%- assign tag_y = 430.5 -%}
                {%- when 'east' -%}
                  {%- assign tag_x = 529.1 -%}
                  {%- assign tag_y = 436.7 -%}
                {%- when 'northeast' -%}
                  {%- assign tag_x = 775.7 -%}
                  {%- assign tag_y = 339.5 -%}
                {%- when 'south' -%}
                  {%- assign tag_x = 328.3 -%}
                  {%- assign tag_y = 688.5 -%}
              {%- endcase -%}

              {%- assign short_label = block.settings.short_name | default: block.settings.region_name | upcase -%}
              {%- assign len = short_label.size -%}
              {%- assign tag_w = len | times: 10.2 | plus: 34 -%}
              {%- assign tag_half_w = tag_w | divided_by: 2.0 -%}
              {%- assign rect_x = tag_half_w | times: -1 -%}
              {%- assign circle_cx = rect_x | plus: 14 -%}

              <g class="tag{% if forloop.first %} sel{% endif %}" data-r="{{ block.settings.region_id }}" data-block-id="{{ block.id }}" transform="translate({{ tag_x }} {{ tag_y }})">
                <rect x="{{ rect_x }}" y="-15" width="{{ tag_w }}" height="30" rx="15"/>
                <circle cx="{{ circle_cx }}" cy="0" r="4.5" fill="{{ block.settings.accent_color | default: '#6B2230' }}" stroke="#fff" stroke-width="1.2"/>
                <text x="7" y="5" text-anchor="middle">{{ short_label }}</text>
              </g>
            {%- endfor -%}
          </svg>
        </div>
        {%- if section.settings.map_note != blank -%}
          <p class="map-note">{{ section.settings.map_note | escape }}</p>
        {%- endif -%}
      </div>

      <!-- Right Column: Region Buttons List & Katha Story Panel -->
      <div>
        <ul class="rlist" aria-label="Regions">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <button 
                type="button" 
                data-r="{{ block.settings.region_id }}" 
                data-block-id="{{ block.id }}" 
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" 
                style="--c:{{ block.settings.accent_deep | default: block.settings.accent_color | default: '#5E634B' }};"
              >
                <span class="dot" style="background:{{ block.settings.accent_color | default: '#7A8063' }}"></span>
                <span class="nm">{{ block.settings.region_name | escape }}</span>
                <span class="ct">
                  {%- if block.settings.weaves != blank -%}
                    {{ block.settings.weaves | escape }}
                  {%- else -%}
                    Revealing soon
                  {%- endif -%}
                </span>
              </button>
            </li>
          {%- endfor -%}
        </ul>

        <!-- Katha Panel (Story, Tagline, Chips, and Button) -->
        <div 
          class="katha" 
          id="katha-{{ section.id }}" 
          aria-live="polite"
          style="--c:{{ first_block.settings.accent_color | default: '#7A8063' }};--c-deep:{{ first_block.settings.accent_deep | default: '#5E634B' }};--c-lite:{{ first_block.settings.accent_lite | default: '#B9BE9E' }};"
        >
          {%- if first_block -%}
            <span class="kicker" style="color:var(--c-deep)">{{ first_block.settings.chapter_no | default: 'Chapter 01' | escape }}</span>
            <h3>{{ first_block.settings.region_name | escape }}</h3>
            {%- if first_block.settings.tagline != blank -%}
              <p class="tl">{{ first_block.settings.tagline | escape }}</p>
            {%- endif -%}
            {%- if first_block.settings.katha != blank -%}
              <p class="st">{{ first_block.settings.katha | escape }}</p>
            {%- endif -%}

            {%- assign weave_array = first_block.settings.weaves | split: ',' -%}
            {%- if weave_array.size > 0 and first_block.settings.weaves != blank -%}
              <div class="chips">
                {%- for weave in weave_array -%}
                  {%- assign w_clean = weave | strip -%}
                  {%- if w_clean != blank -%}
                    {%- capture weave_url -%}
                      {%- if first_block.settings.chapter_link != blank -%}
                        {{ first_block.settings.chapter_link }}?weave={{ w_clean | url_encode }}
                      {%- else -%}
                        {{ routes.all_products_collection_url }}?filter.p.m.custom.weave={{ w_clean | url_encode }}
                      {%- endif -%}
                    {%- endcapture -%}
                    <a class="chip" href="{{ weave_url }}">{{ w_clean | escape }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- capture chapter_btn_url -%}
              {%- if first_block.settings.chapter_link != blank -%}
                {{ first_block.settings.chapter_link }}
              {%- else -%}
                {{ routes.all_products_collection_url }}
              {%- endif -%}
            {%- endcapture -%}
            <a class="btn" href="{{ chapter_btn_url }}">
              Open the {{ first_block.settings.short_name | default: first_block.settings.region_name | escape }} Chapter
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JSON Data for Dynamic Interaction -->
<script type="application/json" id="CraftMapData-{{ section.id }}">
  {
    {%- for block in section.blocks -%}
      {%- assign weave_array = block.settings.weaves | split: ',' -%}
      "{{ block.settings.region_id }}": {
        "id": {{ block.settings.region_id | json }},
        "blockId": {{ block.id | json }},
        "no": {{ block.settings.chapter_no | default: '' | json }},
        "name": {{ block.settings.region_name | json }},
        "short": {{ block.settings.short_name | default: block.settings.region_name | json }},
        "tagline": {{ block.settings.tagline | default: '' | json }},
        "katha": {{ block.settings.katha | default: '' | json }},
        "weaves": [
          {%- for w in weave_array -%}
            {%- assign w_clean = w | strip -%}
            {%- if w_clean != blank -%}
              {{ w_clean | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        ],
        "url": {{ block.settings.chapter_link | default: routes.all_products_collection_url | json }},
        "acc": {{ block.settings.accent_color | default: '#6B2230' | json }},
        "deep": {{ block.settings.accent_deep | default: '#6B2230' | json }},
        "lite": {{ block.settings.accent_lite | default: '#E2A3AE' | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

<script>
  (function() {
    function initCraftMap(sectionId) {
      const root = document.getElementById('craftmap-' + sectionId);
      if (!root) return;
      const plate = document.getElementById('plate-' + sectionId);
      const katha = document.getElementById('katha-' + sectionId);
      const dataScript = document.getElementById('CraftMapData-' + sectionId);
      if (!plate || !katha || !dataScript) return;

      let mapData = {};
      try {
        mapData = JSON.parse(dataScript.textContent);
      } catch (e) {
        console.error('Craft Map data parse error', e);
        return;
      }

      const allRegions = root.querySelectorAll('.rgn, .tag');
      const allButtons = root.querySelectorAll('.rlist button');

      function selectRegion(id, userAction) {
        const c = mapData[id];
        if (!c) return;

        allRegions.forEach(function(el) {
          el.classList.toggle('sel', el.dataset.r === id);
        });

        allButtons.forEach(function(b) {
          b.setAttribute('aria-pressed', b.dataset.r === id ? 'true' : 'false');
        });

        if (userAction) {
          plate.classList.add('map-dim');
        }

        katha.style.setProperty('--c', c.acc);
        katha.style.setProperty('--c-deep', c.deep);
        katha.style.setProperty('--c-lite', c.lite);

        let chipsHtml = '';
        if (c.weaves && c.weaves.length > 0) {
          chipsHtml = '<div class="chips">' + c.weaves.map(function(w) {
            const cleanW = w.trim();
            const href = c.url ? (c.url + (c.url.indexOf('?') > -1 ? '&' : '?') + 'weave=' + encodeURIComponent(cleanW)) : '#';
            return '<a class="chip" href="' + href + '">' + escapeHtml(cleanW) + '</a>';
          }).join('') + '</div>';
        }

        const buttonHtml = '<a class="btn" href="' + (c.url || '#') + '">Open the ' + escapeHtml(c.short) + ' Chapter</a>';

        katha.innerHTML = '<span class="kicker" style="color:var(--c-deep)">' + escapeHtml(c.no) + '</span>' +
          '<h3>' + escapeHtml(c.name) + '</h3>' +
          (c.tagline ? '<p class="tl">' + escapeHtml(c.tagline) + '</p>' : '') +
          (c.katha ? '<p class="st">' + escapeHtml(c.katha) + '</p>' : '') +
          chipsHtml +
          buttonHtml;

        katha.classList.remove('fade');
        void katha.offsetWidth;
        katha.classList.add('fade');
      }

      function setHot(id, on) {
        root.querySelectorAll('[data-r="' + id + '"]').forEach(function(e) {
          e.classList.toggle('hot', on);
        });
      }

      function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      // Event bindings
      root.querySelectorAll('.rgn, .rlist button, .tag').forEach(function(el) {
        el.addEventListener('click', function() {
          selectRegion(el.dataset.r, true);
        });
        el.addEventListener('mouseenter', function() {
          setHot(el.dataset.r, true);
        });
        el.addEventListener('mouseleave', function() {
          setHot(el.dataset.r, false);
        });
        el.addEventListener('focus', function() {
          setHot(el.dataset.r, true);
        });
        el.addEventListener('blur', function() {
          setHot(el.dataset.r, false);
        });

        if (el.classList.contains('rgn')) {
          el.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              selectRegion(el.dataset.r, true);
            }
          });
        }
      });

      // Shopify Theme Editor Integration
      document.addEventListener('shopify:block:select', function(e) {
        if (e.detail && e.detail.sectionId === sectionId) {
          const selectedBlockId = e.detail.blockId;
          const targetBtn = root.querySelector('.rlist button[data-block-id="' + selectedBlockId + '"]');
          if (targetBtn && targetBtn.dataset.r) {
            selectRegion(targetBtn.dataset.r, true);
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initCraftMap({{ section.id | json }});
      });
    } else {
      initCraftMap({{ section.id | json }});
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId) {
        initCraftMap(e.detail.sectionId);
      }
    });
  })();
</script>

