{%- style -%}
  #WeavesWays-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background | default: 'transparent' }};
    --ways-title-color: {{ section.settings.heading_color | default: '#171717' }};
    --ways-card-bg: {{ section.settings.card_background | default: '#FFFFFF' }};
    --ways-card-title-color: {{ section.settings.card_title_color | default: '#171717' }};
    --ways-sub-color: {{ section.settings.subtitle_color | default: '#78716C' }};
    --ways-bullet-color: {{ section.settings.bullet_text_color | default: '#57534E' }};
    --ways-accent-color: {{ section.settings.accent_border_color | default: '#C4A482' }};
    --ways-radius: {{ section.settings.card_border_radius | default: 16 }}px;
    --ways-cols-desk: {{ section.settings.columns_desktop | default: '3' }};
  }

  .weaves-ways {
    position: relative;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .weaves-ways__wrap {
    width: 100%;
    max-width: var(--page-width, 1340px);
    margin: 0 auto;
    padding-left: clamp(24px, 5vw, 64px);
    padding-right: clamp(24px, 5vw, 64px);
    box-sizing: border-box;
    position: relative;
  }

  .weaves-ways__header {
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .weaves-ways__header.text-center {
    text-align: center;
  }

  .weaves-ways__header.text-left {
    text-align: left;
  }

  .weaves-ways__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(2rem, 3.6vw, 2.65rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--ways-title-color, #171717);
    margin: 0;
  }

  .weaves-ways__subheading {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.98rem;
    color: var(--ways-sub-color, #78716C);
    margin-top: 8px;
    line-height: 1.5;
  }

  .weaves-ways__grid {
    display: grid;
    grid-template-columns: repeat(var(--ways-cols-desk, 3), 1fr);
    gap: clamp(20px, 2.5vw, 28px);
    position: relative;
    z-index: 2;
  }

  .weaves-ways__card {
    background-color: var(--ways-card-bg, #FFFFFF);
    border-radius: var(--ways-radius, 16px);
    padding: clamp(28px, 3vw, 36px) clamp(24px, 2.6vw, 32px);
    box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.05), 0 2px 8px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .weaves-ways__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 38px -6px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.04);
  }

  .weaves-ways__card--accent {
    border-top: 3.5px solid var(--ways-accent-color, #C4A482);
  }

  .weaves-ways__card-title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(1.4rem, 1.8vw, 1.65rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--ways-card-title-color, #171717);
    margin: 0 0 10px;
  }

  .weaves-ways__card-sub {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ways-sub-color, #78716C);
    margin: 0 0 18px;
  }

  .weaves-ways__bullets {
    margin: 0;
    padding-left: 20px;
    list-style-type: disc;
    color: var(--ways-bullet-color, #57534E);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .weaves-ways__bullets li {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: clamp(0.9rem, 1.05vw, 0.95rem);
    line-height: 1.55;
    color: var(--ways-bullet-color, #57534E);
  }

  .weaves-ways__thread-accent {
    position: absolute;
    top: 38%;
    left: 36%;
    width: 260px;
    height: 240px;
    pointer-events: none;
    z-index: 3;
    opacity: 0.75;
  }

  @media screen and (max-width: 900px) {
    .weaves-ways__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .weaves-ways__thread-accent {
      display: none;
    }
  }
{%- endstyle -%}

<section
  id="WeavesWays-{{ section.id }}"
  class="weaves-ways"
  data-section-id="{{ section.id }}"
>
  <div class="weaves-ways__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="weaves-ways__header text-{{ section.settings.heading_alignment | default: 'left' }}">
        <h2 class="weaves-ways__title">
          {{ section.settings.heading | escape }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="weaves-ways__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} {%- if section.settings.show_thread_accent -%}
      <svg class="weaves-ways__thread-accent" viewBox="0 0 260 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0,0 C90,60 170,140 260,240" stroke="#9A3B46" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
      </svg>
    {%- endif -%} {% endcomment %}

    <div class="weaves-ways__grid">
      {%- for block in section.blocks -%}
        <div class="weaves-ways__card{% if section.settings.show_top_border %} weaves-ways__card--accent{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="weaves-ways__card-title">
              {{ block.settings.title | escape }}
            </h3>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <p class="weaves-ways__card-sub">
              {{ block.settings.subtitle | escape }}
            </p>
          {%- endif -%}

          {%- if block.settings.bullet_points != blank -%}
            {%- assign raw_bullets = block.settings.bullet_points | newline_to_br | split: '<br />' -%}
            <ul class="weaves-ways__bullets">
              {%- for point in raw_bullets -%}
                {%- assign trimmed_point = point | strip -%}
                {%- if trimmed_point != blank -%}
                  <li>{{ trimmed_point }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ways to Work",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three ways to work with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Optional)"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "3",
          "label": "3 Columns"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top accent border line on cards",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_border_color",
      "label": "Top border accent color",
      "default": "#C4A482"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_thread_accent",
      "label": "Show diagonal red thread accent line",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Section heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle text color",
      "default": "#78716C"
    },
    {
      "type": "color",
      "id": "bullet_text_color",
      "label": "Bullet points text color",
      "default": "#57534E"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "way_card",
      "name": "Track Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Weavers & artisans"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "For clusters, cooperatives and independent makers."
        },
        {
          "type": "textarea",
          "id": "bullet_points",
          "label": "Bullet Points (one per line)",
          "default": "Fair, agreed pricing paid on delivery milestones\nYour name and cluster credited on every piece\nDesign support for contemporary products\nAdvance on yarn for confirmed runs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Ways to Work",
      "blocks": [
        {
          "type": "way_card",
          "settings": {
            "title": "Weavers & artisans",
            "subtitle": "For clusters, cooperatives and independent makers.",
            "bullet_points": "Fair, agreed pricing paid on delivery milestones\nYour name and cluster credited on every piece\nDesign support for contemporary products\nAdvance on yarn for confirmed runs"
          }
        },
        {
          "type": "way_card",
          "settings": {
            "title": "Designers & creators",
            "subtitle": "For designers, stylists, photographers and writers.",
            "bullet_points": "Capsule collaborations with a chosen chapter\nAccess to our maker network and sampling\nJournal features and shared storytelling\nRevenue share on collaboration pieces"
          }
        },
        {
          "type": "way_card",
          "settings": {
            "title": "Brands & institutions",
            "subtitle": "For hospitality, retail, museums and education.",
            "bullet_points": "Commissioned textiles for interiors and uniforms\nExhibitions and craft residencies\nCorporate and wedding gifting programmes\nWorkshops for students and teams"
          }
        }
      ]
    }
  ]
}
{% endschema %}
