{%- liquid
  assign hero_img = section.settings.image
  assign hero_alt = hero_img.alt | default: section.settings.heading | escape
-%}

{%- style -%}
  #WeavesHero-{{ section.id }} {
    --weaves-hero-bg: {{ section.settings.background_color | default: '#5C1E2D' }};
    --weaves-hero-text: {{ section.settings.text_color | default: '#F7F3EE' }};
    --weaves-btn-bg: {{ section.settings.button_bg_color | default: '#FFFFFF' }};
    --weaves-btn-text: {{ section.settings.button_text_color | default: '#5C1E2D' }};
    --weaves-min-h-desk: {{ section.settings.min_height_desktop | default: 540 }}px;
    --weaves-min-h-mob: {{ section.settings.min_height_mobile | default: 340 }}px;
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }

  .weaves-hero {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    min-height: var(--weaves-min-h-desk, 540px);
    background-color: var(--weaves-hero-bg, #5C1E2D);
    color: var(--weaves-hero-text, #F7F3EE);
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .weaves-hero__txt {
    padding: clamp(48px, 6vw, 84px) clamp(24px, 4vw, 54px) clamp(48px, 6vw, 76px) max(clamp(20px, 4.5vw, 60px), calc((100vw - var(--page-width, 1340px))/2 + clamp(20px, 4.5vw, 60px)));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .weaves-hero__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.88rem;
    color: rgba(247, 243, 238, 0.75);
    line-height: 1.4;
    margin-bottom: 2px;
  }

  .weaves-hero__crumbs a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .weaves-hero__crumbs a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .weaves-hero__crumbs .sep {
    opacity: 0.5;
  }

  .weaves-hero__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(38.4px, 6vw, 66.6px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0.02em;
    color: var(--weaves-hero-text, #F7F3EE);
    margin: 0;
    text-transform: uppercase;
  }

  .weaves-hero__desc {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: clamp(18.4px, 1.8vw, 16.6px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(247, 243, 238, 0.88);
    margin: 0;
    max-width: 52ch;
  }

  .weaves-hero__action {
    margin-top: 8px;
  }

  .weaves-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 34px;
    border-radius: 999px;
    background-color: var(--weaves-btn-bg, #FFFFFF);
    color: var(--weaves-btn-text, #5C1E2D);
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  .weaves-hero__btn:hover {
    transform: translateY(-2px);
    background-color: #F7F3EE;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.26);
  }

  .weaves-hero__pic {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    overflow: hidden;
  }

  .weaves-hero__pic--blend::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--weaves-hero-bg, #5C1E2D) 0%, rgba(92, 30, 45, 0.6) 12%, rgba(0, 0, 0, 0) 32%);
    pointer-events: none;
    z-index: 1;
  }

  .weaves-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .weaves-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .weaves-hero__placeholder .placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.2;
  }

  /* Responsive Mobile */
  @media screen and (max-width: 900px) {
    .weaves-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .weaves-hero__pic {
      min-height: var(--weaves-min-h-mob, 340px);
      order: -1;
    }

    .weaves-hero__pic--blend::before {
      background: linear-gradient(0deg, var(--weaves-hero-bg, #5C1E2D) 0%, rgba(92, 30, 45, 0.5) 15%, rgba(0, 0, 0, 0) 45%);
    }

    .weaves-hero__txt {
      padding: 36px clamp(20px, 4.5vw, 36px) 52px;
      gap: 16px;
    }

    .weaves-hero__title {
      font-size: clamp(2rem, 7vw, 3rem);
    }
  }
{%- endstyle -%}

<section
  id="WeavesHero-{{ section.id }}"
  class="weaves-hero"
  data-section-id="{{ section.id }}"
>
  <div class="weaves-hero__txt">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="weaves-hero__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Home' | escape }}</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{{ section.settings.page_label | default: 'Weavers' | escape }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="weaves-hero__title">
        {{ section.settings.heading | escape }}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="weaves-hero__desc">
        {{ section.settings.description | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="weaves-hero__action">
        <a
          href="{{ section.settings.button_link | default: '/pages/contact' }}"
          class="weaves-hero__btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <div class="weaves-hero__pic{% if section.settings.enable_gradient_blend %} weaves-hero__pic--blend{% endif %}" role="img" aria-label="{{ section.settings.heading | escape }}">
    {%- if hero_img != blank -%}
      {{
        hero_img
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 800, 1000, 1200, 1400, 1600',
          alt: hero_alt,
          class: 'weaves-hero__img'
      }}
    {%- else -%}
      <div class="weaves-hero__placeholder" role="img" aria-label="{{ section.settings.heading | escape }}">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Weaves Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home link label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "page_label",
      "label": "Current page label",
      "default": "Weavers"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LOOKING FOR A COLLABORATION? LET'S CREATE SOMETHING TOGETHER."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We work directly with weavers, printers and embroiderers across our five chapters, and with designers and institutions who share that commitment."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start a Conversation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured image"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_blend",
      "label": "Enable soft gradient blend into background",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#5C1E2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#5C1E2D"
    },
    {
      "type": "header",
      "content": "Section Dimensions"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Desktop min height",
      "default": 540
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 240,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Mobile min height",
      "default": 340
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Weaves Hero"
    }
  ]
}
{% endschema %}

