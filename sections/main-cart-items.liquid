{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<cart-items
  class="isolate{% if cart == empty %} is-empty{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="cart-page-wrap">
    <!-- Empty Cart View -->
    <div class="cart__empty-state{% if cart != empty %} hidden{% endif %}">
      <div class="cart-empty-inner">
        <h1 class="cart-empty-title">Your bag is empty</h1>
        <p class="cart-empty-subtitle">Start with a chapter, or go straight to the pieces.</p>
        <div class="cart-empty-actions">
          <a href="{{ routes.all_products_collection_url }}" class="bag-btn">Shop All</a>
          <a href="/pages/chapters" class="bag-btn bag-btn--ghost">Explore the Chapters</a>
        </div>
      </div>
    </div>

    <!-- Active Cart View -->
    <div class="cart__active-state{% if cart == empty %} hidden{% endif %}">
      <h1 class="cart-page-heading">YOUR BAG</h1>

      <form action="{{ routes.cart_url }}" class="cart__contents" method="post" id="cart">
        <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
          <div class="js-contents">
            <div class="bag-grid">
              
              <!-- Left Column: Line Items -->
              <div class="bag-items-col">
                <div class="bag-line-items">
                  {%- for item in cart.items -%}
                    <div class="bag-line cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                      
                      <!-- Thumbnail -->
                      <a href="{{ item.url }}" class="bag-line__img-wrap" tabindex="-1" aria-hidden="true">
                        {%- if item.image -%}
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            alt="{{ item.image.alt | escape }}"
                            class="bag-line__img"
                            loading="lazy"
                            width="96"
                            height="{{ 96 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'bag-line__img placeholder-svg' }}
                        {%- endif -%}
                      </a>

                      <!-- Details -->
                      <div class="bag-line__info">
                        <h3 class="bag-line__title">
                          <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                        </h3>

                        <!-- Meta: Weave · Colour · Size -->
                        <div class="bag-line__meta">
                          {%- liquid
                            assign meta_tokens = ''
                            if item.product.metafields.custom.weave != blank
                              assign meta_tokens = item.product.metafields.custom.weave.value | default: item.product.metafields.custom.weave
                            endif

                            for option in item.options_with_values
                              if meta_tokens == ''
                                assign meta_tokens = option.value
                              else
                                assign meta_tokens = meta_tokens | append: ' · ' | append: option.value
                              endif
                            endfor
                          -%}
                          {%- if meta_tokens != '' -%}
                            {{ meta_tokens }}
                          {%- elsif item.product.has_only_default_variant == false -%}
                            {{ item.variant.title }}
                          {%- endif -%}
                        </div>

                        <!-- Pill Quantity Selector + Remove Link -->
                        <div class="bag-line__actions">
                          <quantity-input class="bag-qty-pill">
                            <button
                              class="bag-qty-btn bag-qty-btn--minus"
                              name="minus"
                              type="button"
                              aria-label="Decrease quantity for {{ item.product.title | escape }}"
                            >
                              −
                            </button>
                            <input
                              class="bag-qty-input"
                              data-quantity-variant-id="{{ item.variant.id }}"
                              data-quantity-line-key="{{ item.key }}"
                              type="number"
                              name="updates[]"
                              value="{{ item.quantity }}"
                              data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                              min="0"
                              data-min="{{ item.variant.quantity_rule.min }}"
                              {% if item.variant.quantity_rule.max != null %}
                                max="{{ item.variant.quantity_rule.max }}"
                              {% endif %}
                              step="{{ item.variant.quantity_rule.increment }}"
                              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                              id="Quantity-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                            <button
                              class="bag-qty-btn bag-qty-btn--plus"
                              name="plus"
                              type="button"
                              aria-label="Increase quantity for {{ item.product.title | escape }}"
                            >
                              +
                            </button>
                          </quantity-input>

                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            class="bag-line__remove-wrap"
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="bag-line__remove-link"
                              aria-label="Remove {{ item.title | escape }}"
                            >
                              Remove
                            </a>
                          </cart-remove-button>
                        </div>

                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                        </div>
                      </div>

                      <!-- Price -->
                      <div class="bag-line__price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <s class="bag-line__price--old">{{ item.original_line_price | money }}</s>
                          <span class="bag-line__price--final">{{ item.final_line_price | money }}</span>
                        {%- else -%}
                          <span>{{ item.original_line_price | money }}</span>
                        {%- endif -%}
                      </div>

                    </div>
                  {%- endfor -%}
                </div>

                {%- if settings.show_cart_note -%}
                  <div class="bag-order-note-wrap">
                    <label for="Cart-note" class="bag-order-note-label">Gift message or order note</label>
                    <textarea
                      class="bag-order-note-textarea"
                      name="note"
                      form="cart"
                      id="Cart-note"
                      rows="3"
                      placeholder="Optional. We write gift messages by hand on the card."
                    >{{ cart.note }}</textarea>
                    <p class="bag-order-note-hint">Discount codes are applied at checkout.</p>
                  </div>
                {%- endif -%}
              </div>

              <!-- Right Column: Order Summary Card -->
              <div class="bag-summary-col">
                <aside class="bag-summary-card">
                  <h2 class="bag-summary-title">Order summary</h2>
                  
                  <!-- Subtotal Row -->
                  <div class="bag-summary-row">
                    <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
                    <span>{{ cart.items_subtotal_price | money }}</span>
                  </div>

                  <!-- Shipping Row -->
                  {%- assign free_shipping_threshold = 750000 -%}
                  {%- assign shipping_fee = 25000 -%}
                  {%- if cart.total_price >= free_shipping_threshold -%}
                    {%- assign shipping_fee = 0 -%}
                  {%- endif -%}
                  <div class="bag-summary-row">
                    <span>Shipping</span>
                    <span>{% if shipping_fee == 0 %}Free{% else %}{{ shipping_fee | money }}{% endif %}</span>
                  </div>

                  <!-- Total Row -->
                  {%- assign bag_total = cart.total_price | plus: shipping_fee -%}
                  <div class="bag-summary-row bag-summary-row--total">
                    <span>Total</span>
                    <span>{{ bag_total | money }}</span>
                  </div>

                  <p class="bag-summary-tax-note">Taxes included. Shipping is confirmed at checkout.</p>

                  {%- if cart.total_price < free_shipping_threshold -%}
                    {%- assign diff = free_shipping_threshold | minus: cart.total_price -%}
                    <p class="bag-summary-shipping-threshold">Add {{ diff | money }} more for free shipping.</p>
                  {%- else -%}
                    <p class="bag-summary-shipping-threshold bag-summary-shipping-threshold--unlocked">You have qualified for free shipping.</p>
                  {%- endif -%}

                  <!-- Checkout Button -->
                  <button
                    type="submit"
                    id="checkout"
                    class="bag-checkout-btn"
                    name="checkout"
                    {% if cart == empty %}disabled{% endif %}
                    form="cart"
                  >
                    Checkout
                  </button>

                  <!-- Continue Shopping Link -->
                  <a href="{{ routes.all_products_collection_url }}" class="bag-continue-link">
                    Continue Shopping
                  </a>
                </aside>
              </div>

            </div>
          </div>
        </div>

        <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
        <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
          {{ 'accessibility.loading' | t }}
        </p>
      </form>
    </div>
  </div>
</cart-items>

{% schema %}
{
  "name": "Bag Items",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
