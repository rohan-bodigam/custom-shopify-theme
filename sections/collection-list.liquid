{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Section-{{ section.id }} {
    --cgrid-cols-desktop: {{ section.settings.columns_desktop }};
    --ctile-min-height: {{ section.settings.card_min_height }}px;
    {% if section.settings.section_bg != blank %}
      background-color: {{ section.settings.section_bg }};
    {% endif %}
  }
{%- endstyle -%}

<section
  id="Section-{{ section.id }}"
  class="sec tight shopby-sec color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | escape }}"
  {% endif %}
>
  <div class="wrap page-width">
    {%- unless section.settings.title == blank and section.settings.lede == blank -%}
      <div class="sec-head">
        <div>
          {%- if section.settings.show_warp -%}
            <span class="warp" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i>
            </span>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="{{ section.settings.heading_size }}{% if section.settings.heading_uppercase %} uppercase{% endif %}">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}

          {%- if section.settings.lede != blank -%}
            <p class="lede">{{ section.settings.lede }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a class="tlink" href="{{ section.settings.view_all_link }}">
            {{- section.settings.view_all_label | default: 'Shop All' -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <div class="cgrid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_collection = block.settings.collection

            # 1. LINK: When a Shopify collection is selected, directly point to it!
            # Otherwise fall back to manual block link, then /collections/all
            assign card_url = routes.all_products_collection_url
            if card_collection != blank
              assign card_url = card_collection.url
            elsif block.settings.link != blank
              assign card_url = block.settings.link
            endif

            # 2. TITLE: Custom title override or collection title
            assign card_title = block.settings.title
            if card_title == blank and card_collection != blank
              assign card_title = card_collection.title
            elsif card_title == blank
              assign card_title = 'Collection'
            endif

            # 3. DESCRIPTION: Custom description override or collection description
            assign card_desc = block.settings.description
            if card_desc == blank and card_collection != blank and card_collection.description != blank
              assign card_desc = card_collection.description | strip_html | truncatewords: 18
            endif

            # 4. PIECE COUNT: Custom count or collection product count
            assign card_count = block.settings.count_label
            if card_count == blank and card_collection != blank
              assign card_count = card_collection.all_products_count | append: ' pieces'
            endif

            # 5. FOCAL POSITION
            assign card_focal = block.settings.focal_point
            if card_focal == blank
              assign card_focal = 'center 30%'
            endif
            assign image_style = 'object-position: ' | append: card_focal | append: '; background-position: ' | append: card_focal | append: ';'

            # 6. FALLBACK ASSET FILENAME
            assign downcase_title = card_title | downcase
            assign fallback_name = 'mega-heritage.webp'
            if downcase_title contains 'contemporary'
              assign fallback_name = 'mega-contemporary.webp'
            elsif downcase_title contains 'men'
              assign fallback_name = 'mega-men.webp'
            elsif downcase_title contains 'women'
              assign fallback_name = 'mega-women.webp'
            elsif downcase_title contains 'kid'
              assign fallback_name = 'mega-kids.webp'
            elsif downcase_title contains 'pet'
              assign fallback_name = 'mega-pet.webp'
            endif

            if block.settings.fallback_image != blank
              assign fallback_name = block.settings.fallback_image
            endif
          -%}

          <a class="ctile" href="{{ card_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'im',
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1500',
                  alt: card_title,
                  style: image_style
              }}
            {%- elsif card_collection != blank and card_collection.featured_image != blank -%}
              {{
                card_collection.featured_image
                | image_url: width: 1200
                | image_tag:
                  class: 'im',
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1500',
                  alt: card_title,
                  style: image_style
              }}
            {%- else -%}
              <img
                class="im"
                src="{{ fallback_name | asset_url }}"
                alt="{{ card_title | escape }}"
                loading="lazy"
                width="1200"
                height="800"
                style="{{ image_style }}"
              >
            {%- endif -%}

            <div class="b">
              <h3>{{ card_title }}</h3>
              {%- if card_desc != blank -%}
                <p>{{ card_desc }}</p>
              {%- endif -%}
              {%- if block.settings.show_count and card_count != blank -%}
                <span class="go">
                  {{ card_count }}
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {% comment %} Default 6 collection cards if no blocks are configured {% endcomment %}
        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-heritage.webp' | asset_url }}" alt="Heritage" loading="lazy" width="1200" height="800" style="object-position: center 30%;">
          <div class="b">
            <h3>Heritage</h3>
            <p>Sarees and sets from the five regional chapters.</p>
            <span class="go">768 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>

        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-contemporary.webp' | asset_url }}" alt="Contemporary" loading="lazy" width="1200" height="800" style="object-position: 58% 40%;">
          <div class="b">
            <h3>Contemporary</h3>
            <p>Many looms, one wardrobe: ikkat, chiffon, mul cotton and Banaras, cut for how you live now.</p>
            <span class="go">60 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>

        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-men.webp' | asset_url }}" alt="Men" loading="lazy" width="1200" height="800" style="object-position: 55% 30%;">
          <div class="b">
            <h3>Men</h3>
            <p>Shirts, jackets and bundis in handwoven cloth.</p>
            <span class="go">40 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>

        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-women.webp' | asset_url }}" alt="Women" loading="lazy" width="1200" height="800" style="object-position: 64% 40%;">
          <div class="b">
            <h3>Women</h3>
            <p>Sarees, dresses and brocade, from many looms.</p>
            <span class="go">788 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>

        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-kids.webp' | asset_url }}" alt="Kids" loading="lazy" width="1200" height="800" style="object-position: 55% 40%;">
          <div class="b">
            <h3>Kids</h3>
            <p>Sibling sets and festive lehengas, soft on skin.</p>
            <span class="go">10 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>

        <a class="ctile" href="{{ routes.all_products_collection_url }}">
          <img class="im" src="{{ 'mega-pet.webp' | asset_url }}" alt="Pets" loading="lazy" width="1200" height="800" style="object-position: 22% 40%;">
          <div class="b">
            <h3>Pets</h3>
            <p>Coats, capes and bandanas from many looms, for the family member who sheds.</p>
            <span class="go">10 pieces <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 15,
  "settings": [
    {
      "type": "header",
      "content": "Heading & Content"
    },
    {
      "type": "checkbox",
      "id": "show_warp",
      "label": "Show loom warp icon",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "d1",
          "label": "Large (d1)"
        },
        {
          "value": "d2",
          "label": "Medium (d2)"
        },
        {
          "value": "h2",
          "label": "Small (h2)"
        }
      ],
      "default": "d2"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lead text / Subtitle",
      "default": "Six ways into the house. Choose one to see everything in it."
    },
    {
      "type": "header",
      "content": "View All Link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'Shop All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_min_height",
      "min": 240,
      "max": 460,
      "step": 10,
      "unit": "px",
      "label": "Card min height (desktop)",
      "default": 340
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors & Custom Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Custom background (optional)"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Anchor ID",
      "default": "shopby",
      "info": "Useful for #shopby jump links"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection",
          "info": "When selected, the card link automatically points to this collection."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card background image",
          "info": "Upload custom image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme asset image filename",
          "info": "E.g. mega-heritage.webp, mega-contemporary.webp, mega-men.webp, mega-women.webp, mega-kids.webp, mega-pet.webp"
        },
        {
          "type": "text",
          "id": "focal_point",
          "label": "Image focal position",
          "default": "center 30%",
          "info": "CSS position, e.g. center 30%, 58% 40%, 55% 30%, 64% 40%, 55% 40%, 22% 40%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "info": "Leave blank to use the selected collection's title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Leave blank to use the selected collection's description"
        },
        {
          "type": "text",
          "id": "count_label",
          "label": "Piece count label",
          "info": "Leave blank to automatically display the collection's product count (e.g. '60 pieces')"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show count and arrow",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link override",
          "info": "Optional. Automatically links to the selected collection above if left blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection",
      "blocks": [
        {
          "type": "featured_collection",
          "settings": {
            "title": "Heritage",
            "description": "Sarees and sets from the five regional chapters.",
            "count_label": "788 pieces",
            "fallback_image": "mega-heritage.webp",
            "focal_point": "center 30%"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Contemporary",
            "description": "Many looms, one wardrobe: ikkat, chiffon, mul cotton and Banaras, cut for how you live now.",
            "count_label": "60 pieces",
            "fallback_image": "mega-contemporary.webp",
            "focal_point": "58% 40%"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Men",
            "description": "Shirts, jackets and bundis in handwoven cloth.",
            "count_label": "40 pieces",
            "fallback_image": "mega-men.webp",
            "focal_point": "55% 30%"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Women",
            "description": "Sarees, dresses and brocade, from many looms.",
            "count_label": "788 pieces",
            "fallback_image": "mega-women.webp",
            "focal_point": "64% 40%"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Kids",
            "description": "Sibling sets and festive lehengas, soft on skin.",
            "count_label": "10 pieces",
            "fallback_image": "mega-kids.webp",
            "focal_point": "55% 40%"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Pets",
            "description": "Coats, capes and bandanas from many looms, for the family member who sheds.",
            "count_label": "10 pieces",
            "fallback_image": "mega-pet.webp",
            "focal_point": "22% 40%"
          }
        }
      ]
    }
  ]
}
{% endschema %}
