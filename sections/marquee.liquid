{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign border_alpha = section.settings.border_opacity | divided_by: 100.0
  assign border_color = section.settings.border_color | color_modify: 'alpha', border_alpha
-%}

{%- capture marquee_items -%}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.is_soon -%}
        <span class="msoon" {{ block.shopify_attributes }}>
          {{- block.settings.text | escape }}
          {% if block.settings.status_text != blank %}
            <small>{{ block.settings.status_text | escape }}</small>
          {% endif -%}
          <b aria-hidden="true"></b>
        </span>
      {%- elsif block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span>
            {{- block.settings.text | escape -}}
            <b aria-hidden="true"></b>
          </span>
        </a>
      {%- else -%}
        <span {{ block.shopify_attributes }}>
          {{- block.settings.text | escape -}}
          <b aria-hidden="true"></b>
        </span>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign default_weaves = 'Mangalagiri,Banaras,Maheshwari,Ikkat,Baluchari,Zari Kota,Pure Kota,Swarnachari,Mul Cotton,Crape Silk,Chiffon' | split: ',' -%}
    {%- assign default_soon = 'Muga,Kanchipuram,Bandhani' | split: ',' -%}
    {%- for weave in default_weaves -%}
      <a href="{{ routes.all_products_collection_url }}">
        <span>
          {{- weave | escape -}}
          <b aria-hidden="true"></b>
        </span>
      </a>
    {%- endfor -%}
    {%- for soon in default_soon -%}
      <span class="msoon">
        {{- soon | escape }}
        <small>revealing soon</small>
        <b aria-hidden="true"></b>
      </span>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  id="Marquee-{{ section.id }}"
  class="marquee{% if section.settings.direction == 'right' %} marquee--reverse{% endif %}{% if section.settings.pause_on_hover %} marquee--pause{% endif %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Weaves in the house' | escape }}"
  style="
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-bg: {{ section.settings.background_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-diamond: {{ section.settings.diamond_color }};
    --marquee-border: {{ border_color }};
    --marquee-hover: {{ section.settings.hover_color }};
    --marquee-font-size: {{ section.settings.font_size }}px;
    --marquee-padding-y: {{ section.settings.padding_vertical }}px;
    --marquee-gap: {{ section.settings.item_gap }}px;
  "
>
  <div class="track">
    <div class="track__part">
      {{ marquee_items }}
      {{ marquee_items }}
    </div>
    <div class="track__part" aria-hidden="true">
      {{ marquee_items }}
      {{ marquee_items }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee Strip",
  "tag": "section",
  "class": "section-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Animation Settings"
