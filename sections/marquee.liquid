    {
      "type": "range",
      "id": "item_gap",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between text & diamond",
      "default": 26
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Weaves in the house"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "weave",
      "name": "Weave Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Weave name / text",
          "default": "Mangalagiri"
        },
        {
          "type": "url",
