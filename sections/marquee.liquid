        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause animation on hover / focus",
      "default": true
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#6B2230"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F2E6DA"
    },
    {
      "type": "color",
      "id": "diamond_color",
      "label": "Diamond bullet color",
      "default": "#D1B17E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D1B17E"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Border opacity",
      "default": 35
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Link hover color",
      "default": "#B08D57"
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
