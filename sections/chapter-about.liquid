{{ 'section-chapter.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Automatic default fallback based on page handle if setting is left blank
  assign current_handle = page.handle

  assign default_katha = 'Bengal’s river delta gave India its finest cotton. Muslin so sheer it was once said to be woven air came from these waters, and the habit of wearing soft, breathable cotton never left. Our East chapter begins with the cloth that carries that habit forward: mul cotton, light enough for a Kolkata summer and strong enough for daily wear.'
  assign default_about = 'East India is humid, green and full of rivers, and its textile life grew around that climate. Cotton that breathes, spun fine and woven loosely, was the obvious answer. Mul cotton is the everyday descendant of that tradition. It is not a showy cloth. It is the one people reach for first, because it is soft on the skin, drapes without weight and gets better after every wash.'
  assign default_f1_val = '4'
  assign default_f1_lab = 'states'
  assign default_f2_val = 'Handloom'
  assign default_f2_lab = 'made in small runs'

  if current_handle == 'west-central-india'
    assign default_katha = 'On the banks of the Narmada, a queen once set up looms to give a fort town a living. In the dry country of Rajasthan, weavers learned to make cotton so light it is nearly sheer. This chapter holds two of India’s lightest and most elegant cloths: Maheshwari and Zari Kota, both made for heat, both finished with a little gold.'
    assign default_about = 'West and Central India hold some of the country’s most refined everyday textiles. Maheshwari comes from the temple and fort town of Maheshwar in Madhya Pradesh. Kota Doria comes from Kaithoon and its neighbouring villages near Kota in Rajasthan.'
    assign default_f1_val = '5'
  elsif current_handle == 'south-india'
    assign default_katha = 'Temples shaped the South’s weavers, giving them sacred patterns, auspicious dyes and generations of dedicated trade. From the heavy silks of Kanchipuram to the featherlight cottons of Mangalagiri, cloth here has always carried both ritual and life.'
    assign default_about = 'South India’s textile geography spans deep coastal soil, river deltas and temple towns where whole streets remain dedicated to the loom. Patterns carry temple towers, checks and sacred borders passed from parent to child.'
    assign default_f1_val = '5'
  elsif current_handle == 'north-india'
    assign default_katha = 'The courts of the north required splendour, and its winters demanded warmth. From the delicate needlework of Lucknow’s chikankari to the warm wools of Kashmir, northern textiles blend royal patronage with climate resilience.'
    assign default_about = 'From the valleys of the Himalayas to the plains of the Ganges, northern cloth has evolved through court culture and changing seasons.'
    assign default_f1_val = '4'
  elsif current_handle == 'north-east-india'
    assign default_katha = 'In the green valleys and mist-laden hills of the North East, the loom is an extension of home. Here, wild silks like Muga and Eri are spun and backstrap looms produce bold geometric motifs that identify clans and tribes.'
    assign default_about = 'North East India treats weaving not merely as a trade, but as a domestic art practiced across generations of women. The cloth is durable, textured and intimately tied to nature.'
    assign default_f1_val = '7'
  endif

  assign heading = section.settings.heading | default: 'ABOUT THIS CHAPTER'
  assign katha = section.settings.katha | default: default_katha
  assign about = section.settings.about | default: default_about
  assign f1_val = section.settings.fact_1_value | default: default_f1_val
  assign f1_lab = section.settings.fact_1_label | default: default_f1_lab
  assign f2_val = section.settings.fact_2_value | default: default_f2_val
  assign f2_lab = section.settings.fact_2_label | default: default_f2_lab
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ChapterAbout-{{ section.id }} {
    --about-bg: {{ section.settings.background_color }};
    --warp-accent: {{ section.settings.warp_icon_color }};
  }
{%- endstyle -%}

<section
  id="ChapterAbout-{{ section.id }}"
  class="chapter-about-section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
>
  <div class="chapter-about__container">
    <div class="chapter-about__grid">
      <div class="chapter-about__media-wrap">
        {%- if section.settings.map_image != blank -%}
          {{
            section.settings.map_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400',
              alt: section.settings.map_image.alt | default: heading | escape
          }}
        {%- else -%}
          <div class="chapter-about__placeholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="chapter-about__content">
        {%- if section.settings.show_warp_icon -%}
          <div class="chapter-about__warp" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i>
          </div>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="chapter-about__heading">{{ heading | escape }}</h2>
        {%- endif -%}

        <div class="chapter-about__prose">
          {%- if katha != blank -%}
            <p>{{ katha | escape }}</p>
          {%- endif -%}
          {%- if about != blank -%}
            <p>{{ about | escape }}</p>
          {%- endif -%}
        </div>

        {%- if f1_val != blank or f2_val != blank -%}
          <div class="chapter-about__divider" aria-hidden="true"></div>

          <div class="chapter-about__facts">
            {%- if f1_val != blank -%}
              <div class="chapter-about__fact">
                <span class="chapter-about__fact-value">{{ f1_val | escape }}</span>
                {%- if f1_lab != blank -%}
                  <span class="chapter-about__fact-label">{{ f1_lab | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if f2_val != blank -%}
              <div class="chapter-about__fact">
                <span class="chapter-about__fact-value">{{ f2_val | escape }}</span>
                {%- if f2_lab != blank -%}
                  <span class="chapter-about__fact-label">{{ f2_lab | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chapter About",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Textile Map / Artwork"
    },
    {
      "type": "header",
      "content": "Story & Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ABOUT THIS CHAPTER"
    },
    {
      "type": "checkbox",
      "id": "show_warp_icon",
      "label": "Show vertical warp motif",
      "default": true
    },
    {
      "type": "textarea",
      "id": "katha",
      "label": "Story paragraph 1",
      "info": "Leave blank to auto-detect based on region"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "Story paragraph 2",
      "info": "Leave blank to auto-detect based on region"
    },
    {
      "type": "header",
      "content": "Facts & Statistics"
    },
    {
      "type": "text",
      "id": "fact_1_value",
      "label": "Fact 1 value / number",
      "info": "Leave blank to auto-detect (e.g. 4)"
    },
    {
      "type": "text",
      "id": "fact_1_label",
      "label": "Fact 1 label",
      "default": "states"
    },
    {
      "type": "text",
      "id": "fact_2_value",
      "label": "Fact 2 value / title",
      "default": "Handloom"
    },
    {
      "type": "text",
      "id": "fact_2_label",
      "label": "Fact 2 label",
      "default": "made in small runs"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#F6F2EA"
    },
    {
      "type": "color",
      "id": "warp_icon_color",
      "label": "Warp motif accent color",
      "default": "#B08D57"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Chapter About"
    }
  ]
}
{% endschema %}
