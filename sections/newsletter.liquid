{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Section-{{ section.id }} {
    {% if section.settings.custom_bg != blank %}
      --news-bg: {{ section.settings.custom_bg }};
    {% elsif section.settings.background_style == 'maroon' %}
      --news-bg: #3a1219;
    {% elsif section.settings.background_style == 'dark' %}
      --news-bg: #171717;
    {% endif %}
  }
{%- endstyle -%}

<section
  id="Section-{{ section.id }}"
  class="sec dark newsletter-sec section-{{ section.id }}-padding{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="wrap news">
    <div class="news-left">
      {%- if section.settings.show_warp -%}
        <span class="warp" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="d2{% if section.settings.heading_font == 'edit' %} edit-font{% endif %}{% if section.settings.heading_uppercase %} uppercase{% endif %}">
          {{ section.settings.title | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.lede != blank -%}
        <p class="lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    <div class="news-form-wrap">
      {%- form 'customer',
        class: 'newsletter-form js-newsletter-form',
        id: 'NewsletterForm',
        data-success-msg: section.settings.success_message
      -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="inrow">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
            {{- section.settings.email_placeholder | default: 'Your email address' | escape -}}
          </label>
          <input
            class="inp"
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder | default: 'Your email address' | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
          <button class="btn light" type="submit" name="commit">
            {{- section.settings.button_label | default: 'Subscribe' | escape -}}
          </button>
        </div>

        <div
          class="form-feedback form-feedback-js"
          role="alert"
          aria-live="polite"
        ></div>

        {%- if form.posted_successfully? -%}
          <div class="form-feedback is-success" role="status">
            {{ section.settings.success_message | default: 'You’re on the list. The next letter arrives at the start of the month.' }}
          </div>
        {%- elsif form.errors -%}
          <div class="form-feedback is-error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        {%- if section.settings.disclaimer != blank -%}
          <div class="disclaimer">
            {{ section.settings.disclaimer }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initNewsletterForm(sectionId) {
      const sectionEl = document.querySelector('[data-section-id="' + sectionId + '"]');
      if (!sectionEl) return;
      const form = sectionEl.querySelector('.js-newsletter-form');
      if (!form) return;

      const input = form.querySelector('input[type="email"]');
      const feedback = form.querySelector('.form-feedback-js');
      const submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', function(e) {
        if (!input || !input.value.trim() || !/^\S+@\S+\.\S+$/.test(input.value)) {
          e.preventDefault();
          if (input) {
            input.classList.add('is-invalid');
            input.focus();
          }
          if (feedback) {
            feedback.className = 'form-feedback form-feedback-js is-error';
            feedback.textContent = 'Please enter a valid email address.';
          }
          return;
        }

        // Seamless AJAX submission to Shopify
        e.preventDefault();
        input.classList.remove('is-invalid');

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.7';
        }

        const formData = new FormData(form);

        fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'text/html'
          }
        })
        .then(function(res) {
          if (feedback) {
            feedback.className = 'form-feedback form-feedback-js is-success';
            const successMsg = form.dataset.successMsg || 'You’re on the list. The next letter arrives at the start of the month.';
            feedback.textContent = successMsg;
          }
          form.reset();
        })
        .catch(function(err) {
          // If fetch fails, fallback to native post
          form.submit();
        })
        .finally(function() {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '';
          }
        });
      });

      if (input) {
        input.addEventListener('input', function() {
          input.classList.remove('is-invalid');
          if (feedback && feedback.classList.contains('is-error')) {
            feedback.className = 'form-feedback form-feedback-js';
            feedback.textContent = '';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initNewsletterForm({{ section.id | json }});
      });
    } else {
      initNewsletterForm({{ section.id | json }});
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === {{ section.id | json }}) {
        initNewsletterForm({{ section.id | json }});
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_warp",
      "label": "Show warp threads icon",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Letters from the loom"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading typography",
      "options": [
        {
          "value": "display",
          "label": "Cinzel (Display Serif - Default)"
        },
        {
          "value": "edit",
          "label": "Forum (Editorial Serif)"
        }
      ],
      "default": "display"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Subtitle / Lede",
      "default": "One letter a month: a new chapter drop, a maker we met, and a textile worth knowing. No daily sales emails."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You’re on the list. The next letter arrives at the start of the month."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "<p>By subscribing you agree to receive marketing emails from House of Kala Katha. You can unsubscribe with one click from any letter. See our <a href=\"#/policy/privacy\">privacy policy</a>.</p>"
    },
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "options": [
        {
          "value": "gradient",
          "label": "Signature Maroon Gradient (Default)"
        },
        {
          "value": "maroon",
          "label": "Solid Dark Maroon"
        },
        {
          "value": "dark",
          "label": "Solid Dark Ink"
        }
      ],
      "default": "gradient"
    },
    {
      "type": "color_background",
      "id": "custom_bg",
      "label": "Custom background gradient/color",
      "info": "Overrides background style preset if selected"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "presets": [
    {
      "name": "Newsletter (Letters from the Loom)",
      "settings": {
        "title": "Letters from the loom",
        "heading_font": "display",
        "heading_uppercase": true,
        "lede": "One letter a month: a new chapter drop, a maker we met, and a textile worth knowing. No daily sales emails.",
        "button_label": "Subscribe",
        "background_style": "gradient"
      }
    }
  ]
}
{% endschema %}
