{{ 'section-chapter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --weaves-read-bg: {{ section.settings.background_color }};
    --weaves-read-card-bg: {{ section.settings.card_background }};
    --weaves-read-link: {{ section.settings.link_color }};
  }
{%- endstyle -%}

<div class="chapter-weaves-read-section section-{{ section.id }}-padding">
  <div class="chapter-weaves-read__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="chapter-weaves-read__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="chapter-weaves-read__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="chapter-weaves-read__lede">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="chapter-weaves-read__grid">
      {%- for block in section.blocks -%}
        <div class="chapter-weaves-read__card{% if block.settings.is_featured %} chapter-weaves-read__card--featured{% endif %}{% if block.settings.image != blank %} has-media{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="chapter-weaves-read__media-wrap">
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  alt: block.settings.title | default: section.settings.heading | escape
              }}
            </div>
          {%- endif -%}

          <div class="chapter-weaves-read__content">
            <div class="chapter-weaves-read__body-top">
              {%- if block.settings.kicker != blank -%}
                <div class="chapter-weaves-read__kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="chapter-weaves-read__heading">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="chapter-weaves-read__desc">
                  {{ block.settings.description | newline_to_br }}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.quote != blank or block.settings.link_label != blank -%}
              <div class="chapter-weaves-read__body-bottom">
                <div class="chapter-weaves-read__divider"></div>
                {%- if block.settings.quote != blank -%}
                  <div class="chapter-weaves-read__quote">&ldquo;{{ block.settings.quote | remove: '“' | remove: '”' | remove: '"' }}&rdquo;</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a href="{{ block.settings.link_url | default: '#' }}" class="chapter-weaves-read__link">
                    {{ block.settings.link_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Chapter Weaves In-Depth",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "THE WEAVES"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subtitle",
      "default": "Where each craft comes from, how it is made and how to recognise it."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F6F2EA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link & Accent Color",
      "default": "#6B2230"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "weave_card",
      "name": "Weave Story Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Featured full-width card",
          "default": false,
          "info": "Displays full width with side-by-side image and story"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Origin / Location Kicker",
          "default": "West Bengal and beyond"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Weave Name",
          "default": "MUL COTTON"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Mul, or mulmul, is the name for a very fine, soft, lightweight cotton. The word is tied to the muslin tradition of Bengal, where the thinnest yarns were woven into cloth that felt almost weightless."
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote / Catchphrase",
          "default": "Mul is the cloth you stop noticing, which is the point."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Text",
          "default": "Shop Mul Cotton"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chapter Weaves In-Depth",
      "blocks": [
        {
          "type": "weave_card",
          "settings": {
            "is_featured": true,
            "kicker": "West Bengal and beyond",
            "title": "MUL COTTON",
            "description": "Mul, or mulmul, is the name for a very fine, soft, lightweight cotton. The word is tied to the muslin tradition of Bengal, where the thinnest yarns were woven into cloth that felt almost weightless. A good mul cotton has a close, even weave, a gentle crinkle after washing and a drape that falls rather than stands. It breathes in heat and layers easily in cooler months. In the house, mul cotton is used for sarees with woven stripe borders, for relaxed kurtas and shirts, for co-ord sets and for children’s clothes, where softness matters most. Look for an even surface, a cloth that softens with wear and borders that are woven in, not printed on.",
            "quote": "Mul is the cloth you stop noticing, which is the point.",
            "link_label": "Shop Mul Cotton",
            "link_url": ""
          }
        },
        {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "Bishnupur, West Bengal",
            "title": "BALUCHARI",
            "description": "Baluchari is Bengal’s narrative silk. The pallu is woven as a set of framed scenes, often from the epics or from old court life, built up thread by thread with an extra weft on a jacquard loom. Bishnupur, a temple town known for its terracotta, is the centre of the craft today. Our Single Thread Baluchari keeps to one colour of figuring weft, so the pictures read like an engraving. Meenakari Baluchari adds small inlays of a second and third colour, the way enamel is set into gold.",
            "quote": "The pallu is a picture book you can wear.",
            "link_label": "Shop Baluchari",
            "link_url": ""
          }
        },
        {
          "type": "weave_card",
          "settings": {
            "is_featured": false,
            "kicker": "Bishnupur, West Bengal",
            "title": "SWARNACHARI",
            "description": "Swarnachari is Baluchari’s festive sibling. The same framed scenes run across the pallu, but they are woven in gold or silver zari rather than silk, so the figures catch the light. Our Meenakari Swarnachari sarees add coloured highlights inside the zari, in the manner of enamel work, on deep red, green and blue grounds.",
            "quote": "Baluchari tells the story; Swarnachari lights it up.",
            "link_label": "Shop Swarnachari",
            "link_url": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
