{{ 'section-collection-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#EDE3D9'
  assign text_color = section.settings.text_color | default: '#171717'
  assign min_height = section.settings.min_height | default: 520

  assign hero_image_url = ''
  if collection.image != blank
    assign hero_image_url = collection.image | image_url: width: 1400
  elsif section.settings.image != blank
    assign hero_image_url = section.settings.image | image_url: width: 1400
  else
    assign hero_image_url = 'mega-heritage.webp' | asset_url
  endif

  assign banner_tagline = collection.metafields.custom.tagline
  if banner_tagline == blank
    assign banner_tagline = section.settings.tagline
  endif

  assign banner_desc = section.settings.custom_description
  if banner_desc == blank
    assign banner_desc = collection.description
  endif
-%}

{%- style -%}
  #CollectionBanner-{{ section.id }} {
    --phero-bg: {{ bg_color }};
    --phero-ink: {{ text_color }};
    min-height: {{ min_height }}px;
  }
{%- endstyle -%}

<section
  id="CollectionBanner-{{ section.id }}"
  class="collection-phero light"
  data-section-id="{{ section.id }}"
>
  <div class="txt">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="crumbs-sep" aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">Shop</a>
        <span class="crumbs-sep" aria-hidden="true">/</span>
        <span class="crumbs-current">{{ collection.title | escape }}</span>
      </nav>
    {%- endif -%}

    <h1 class="d1 collection-banner__title">
      {{- collection.title | escape -}}
    </h1>

    {%- if banner_tagline != blank -%}
      <p class="tagline collection-banner__tagline">
        {{- banner_tagline | escape -}}
      </p>
    {%- endif -%}

    {%- if section.settings.show_collection_description and banner_desc != blank -%}
      <div class="lede collection-banner__description rte">
        {{ banner_desc }}
      </div>
    {%- endif -%}
  </div>

  <div
    class="pic"
    style="background-image: url('{{ hero_image_url }}');"
    role="img"
    aria-label="{{ collection.title | escape }}"
  ></div>
</section>

{% schema %}
{
  "name": "Collection Banner",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumb navigation"
    },
    {
      "type": "text",
      "id": "tagline",
      "default": "Five chapters, one house",
      "label": "Tagline",
      "info": "Falls back to collection metafield 'custom.tagline' if present"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom description override (optional)",
      "info": "Overrides collection description if provided"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback / default banner image",
      "info": "Used when the collection does not have its own featured image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EDE3D9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 700,
      "step": 20,
      "default": 520,
      "unit": "px",
      "label": "Minimum banner height"
    }
  ]
}
{% endschema %}
