{%- liquid
  assign show_featured = section.settings.show_featured_article
  assign feat_article = section.settings.featured_article | default: blog.articles.first
  assign feat_id = feat_article.id
  assign articles_per_page = section.settings.articles_per_page | default: 9
-%}

{%- style -%}
  #MainBlog-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background | default: '#F7F3EE' }};
    --j-heading: {{ section.settings.heading_color | default: '#171717' }};
    --j-text: {{ section.settings.text_color | default: '#57534E' }};
    --j-kicker: {{ section.settings.accent_color | default: '#9A3B46' }};
    --j-card-bg: {{ section.settings.card_background | default: '#FFFFFF' }};
    --j-card-radius: {{ section.settings.card_border_radius | default: 12 }}px;
  }

  .journal-page {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .journal-page__wrap {
    width: 100%;
    max-width: var(--page-width, 1340px);
    margin: 0 auto;
    padding-left: clamp(20px, 4.5vw, 60px);
    padding-right: clamp(20px, 4.5vw, 60px);
    box-sizing: border-box;
  }

  /* Breadcrumbs */
  .journal-page__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.88rem;
    color: #78716C;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .journal-page__crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .journal-page__crumbs a:hover {
    color: var(--j-heading, #171717);
    text-decoration: underline;
  }

  .journal-page__crumbs span[aria-current="page"] {
    color: var(--j-heading, #171717);
    font-weight: 500;
  }

  /* Header */
  .journal-page__head {
    margin-bottom: clamp(32px, 4.5vw, 48px);
  }

  .journal-page__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(38.4px, 6vw, 73.6px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--j-heading, #171717);
    margin: 0 0 12px 0;
  }

  .journal-page__lede {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: clamp(18.4px, 1.8vw, 21.6px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--j-text, #57534E);
    margin: 0;
    max-width: 68ch;
  }

  /* Featured Article Card (2-column hero) */
  .journal-feat {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    text-decoration: none;
    color: inherit;
    background-color: var(--j-card-bg, #FFFFFF);
    border-radius: calc(var(--j-card-radius, 12px) + 4px);
    padding: clamp(20px, 3.2vw, 38px);
    margin-bottom: clamp(48px, 6vw, 72px);
    box-shadow: 0 10px 32px -4px rgba(0, 0, 0, 0.06), 0 4px 12px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .journal-feat:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 44px -6px rgba(0, 0, 0, 0.1), 0 6px 16px rgba(0, 0, 0, 0.04);
  }

  .journal-feat__media {
    aspect-ratio: 16 / 11;
    border-radius: var(--j-card-radius, 12px);
    overflow: hidden;
    background-color: #EFE9E2;
    width: 100%;
  }

  .journal-feat__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journal-feat:hover .journal-feat__img {
    transform: scale(1.03);
  }

  .journal-feat__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #EAE3D9;
  }

  .journal-feat__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.35;
  }

  .journal-feat__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .journal-feat__kicker {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 12.8px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--j-kicker, #9A3B46);
    margin: 0;
  }

  .journal-feat__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(28.8px, 3.6vw, 43.2px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--j-heading, #171717);
    margin: 0;
    transition: color 0.2s ease;
  }

  .journal-feat:hover .journal-feat__title {
    color: #6B2230;
  }

  .journal-feat__excerpt {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--j-text, #57534E);
    margin: 4px 0 0 0;
  }

  .journal-feat__meta {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 13.76px;
    color: #78716C;
    margin-top: 10px;
  }

  /* All Stories Section */
  .journal-stories {
    position: relative;
  }

  .journal-stories__header {
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }

  .journal-stories__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: clamp(25.6px, 3vw, 35.2px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--j-heading, #171717);
    margin: 0;
  }

  .journal-stories__thread {
    position: absolute;
    right: 2%;
    top: 38%;
    width: clamp(240px, 35vw, 420px);
    height: auto;
    pointer-events: none;
    z-index: 1;
    opacity: 0.75;
  }

  /* Grid of Stories */
  .journal-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: '3' }}, 1fr);
    gap: clamp(28px, 3vw, 36px) clamp(20px, 2.2vw, 28px);
    position: relative;
    z-index: 2;
  }

  /* Individual Journal Card - Clean unboxed editorial style matching screenshot */
  .journal-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
  }

  .journal-card__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--j-card-radius, 10px);
    overflow: hidden;
    background-color: #EAE3D9;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    position: relative;
  }

  .journal-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journal-card:hover .journal-card__img {
    transform: scale(1.04);
  }

  .journal-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #EFE9E2;
  }

  .journal-card__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.35;
  }

  .journal-card__body {
    padding: 14px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .journal-card__kicker {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 12.8px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--j-kicker, #9A3B46);
    margin: 0 0 2px 0;
  }

  .journal-card__title {
    font-family: var(--f-edit, 'Forum', Georgia, serif);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--j-heading, #171717);
    margin: 0 0 4px 0;
    transition: color 0.2s ease;
  }

  .journal-card:hover .journal-card__title {
    color: #6B2230;
  }

  .journal-card__excerpt {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--j-text, #57534E);
    margin: 2px 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-card__meta {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 13.76px;
    color: #78716C;
    margin-top: auto;
    padding-top: 10px;
  }

  /* Empty State */
  .journal-empty {
    padding: 60px 20px;
    text-align: center;
    background-color: var(--j-card-bg, #FFFFFF);
    border-radius: var(--j-card-radius, 12px);
    border: 1px dashed #D6C6B8;
  }

  .journal-empty p {
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    color: var(--j-text, #57534E);
    font-size: 1rem;
    margin: 0;
  }

  /* Pagination */
  .journal-pagination {
    margin-top: clamp(48px, 6vw, 64px);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-family: var(--f-ui, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 0.95rem;
  }

  .journal-pagination__link,
  .journal-pagination__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .journal-pagination__link {
    color: var(--j-heading, #171717);
    background-color: var(--j-card-bg, #FFFFFF);
    border: 1px solid #E5DFD7;
  }

  .journal-pagination__link:hover {
    border-color: #6B2230;
    color: #6B2230;
  }

  .journal-pagination__current {
    background-color: #6B2230;
    color: #FFFFFF;
    font-weight: 500;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .journal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 820px) {
    .journal-feat {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .journal-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{%- endstyle -%}

<section
  id="MainBlog-{{ section.id }}"
  class="journal-page"
  data-section-id="{{ section.id }}"
>
  <div class="journal-page__wrap">

    {% comment %} Breadcrumbs {% endcomment %}
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="journal-page__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Home' | escape }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ blog.title | escape }}</span>
      </nav>
    {%- endif -%}

    {% comment %} Page Header {% endcomment %}
    <header class="journal-page__head">
      <h1 class="journal-page__title">
        {{ section.settings.heading | default: blog.title | escape }}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="journal-page__lede">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}
    </header>

    {%- paginate blog.articles by articles_per_page -%}

      {% comment %} Featured Story Card (shown on page 1) {% endcomment %}
      {%- if show_featured and paginate.current_page == 1 and feat_article != blank -%}
        {%- liquid
          assign feat_words = feat_article.content | strip_html | split: ' ' | size
          assign feat_read_time = feat_words | divided_by: 200 | at_least: 1
          assign feat_kicker = section.settings.featured_kicker | default: 'Featured'

          # Kicker construction with tags
          assign feat_tag_text = ''
          if feat_article.tags.size > 0
            assign feat_tag_text = feat_article.tags | first
            if feat_article.tags.size > 1
              assign feat_tag_text = feat_tag_text | append: ' · ' | append: feat_article.tags[1]
            endif
          endif
        -%}
        <a href="{{ feat_article.url }}" class="journal-feat" aria-label="{{ feat_article.title | escape }}">
          <div class="journal-feat__media">
            {%- if feat_article.image != blank -%}
              {%- assign feat_alt = feat_article.image.alt | default: feat_article.title | escape -%}
              {{
                feat_article.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  widths: '500, 800, 1100, 1400',
                  alt: feat_alt,
                  class: 'journal-feat__img'
              }}
            {%- else -%}
              <div class="journal-feat__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          <div class="journal-feat__body">
            <span class="journal-feat__kicker">
              {{ feat_kicker | escape }}{% if feat_tag_text != blank %} · {{ feat_tag_text | escape }}{% endif %}
            </span>

            <h2 class="journal-feat__title">
              {{ feat_article.title | escape }}
            </h2>

            <p class="journal-feat__excerpt">
              {%- if feat_article.excerpt != blank -%}
                {{ feat_article.excerpt | strip_html | truncatewords: 35 }}
              {%- else -%}
                {{ feat_article.content | strip_html | truncatewords: 35 }}
              {%- endif -%}
            </p>

            <div class="journal-feat__meta">
              {{ feat_article.published_at | date: '%B %d, %Y' }} · {{ feat_read_time }} min read
            </div>
          </div>
        </a>
      {%- endif -%}

      {% comment %} All Stories Section {% endcomment %}
      <div class="journal-stories">
        {%- if section.settings.show_thread_accent -%}
          <svg class="journal-stories__thread" viewBox="0 0 500 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0,75 C160,105 320,40 500,10" stroke="#9A3B46" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />
          </svg>
        {%- endif -%}

        {%- if section.settings.grid_heading != blank -%}
          <div class="journal-stories__header">
            <h2 class="journal-stories__title">
              {{ section.settings.grid_heading | escape }}
            </h2>
          </div>
        {%- endif -%}

        {%- liquid
          assign remaining_count = 0
          for article in blog.articles
            if show_featured and paginate.current_page == 1 and article.id == feat_id and section.settings.exclude_featured_from_grid
              continue
            endif
            assign remaining_count = remaining_count | plus: 1
          endfor
        -%}

        {%- if remaining_count > 0 -%}
          <div class="journal-grid">
            {%- for article in blog.articles -%}
              {% comment %} Skip featured article on page 1 if enabled to prevent duplication {% endcomment %}
              {%- if show_featured and paginate.current_page == 1 and article.id == feat_id and section.settings.exclude_featured_from_grid -%}
                {%- continue -%}
              {%- endif -%}

              {%- render 'journal-card',
                article: article,
                show_tags: section.settings.show_tags,
                show_excerpt: section.settings.show_excerpt,
                excerpt_words: section.settings.excerpt_words,
                show_date: section.settings.show_date,
                show_read_time: section.settings.show_read_time,
                card_radius: section.settings.card_border_radius
              -%}
            {%- endfor -%}
          </div>

          {% comment %} Pagination Controls {% endcomment %}
          {%- if paginate.pages > 1 -%}
            <nav class="journal-pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="journal-pagination__link" aria-label="Previous page">
                  ← Prev
                </a>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="journal-pagination__link">
                    {{ part.title }}
                  </a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span class="journal-pagination__current" aria-current="page">
                      {{ part.title }}
                    </span>
                  {%- else -%}
                    <span class="journal-pagination__link" style="opacity: 0.5; cursor: default;">
                      {{ part.title }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="journal-pagination__link" aria-label="Next page">
                  Next →
                </a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- elsif section.settings.show_placeholder_cards -%}
          {% comment %} Exact preview cards matching House of Kala Katha design {% endcomment %}
          <div class="journal-grid">
            {%- render 'journal-card', sample_index: 1, card_radius: section.settings.card_border_radius -%}
            {%- render 'journal-card', sample_index: 2, card_radius: section.settings.card_border_radius -%}
            {%- render 'journal-card', sample_index: 3, card_radius: section.settings.card_border_radius -%}
          </div>

        {%- else -%}
          <div class="journal-empty">
            <p>No stories have been published yet in this journal. Check back soon!</p>
          </div>
        {%- endif -%}
      </div>

    {%- endpaginate -%}

  </div>
</section>

{% schema %}
{
  "name": "Journal Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home breadcrumb label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Lede",
      "default": "Notes from looms, dye yards and workshops, and guides to reading the textiles you wear."
    },
    {
      "type": "header",
      "content": "Featured Story Card"
    },
    {
      "type": "checkbox",
      "id": "show_featured_article",
      "label": "Show featured story card on first page",
      "default": true
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article (leave empty to use newest story)"
    },
    {
      "type": "text",
      "id": "featured_kicker",
      "label": "Featured kicker badge",
      "default": "Featured"
    },
    {
      "type": "checkbox",
      "id": "exclude_featured_from_grid",
      "label": "Exclude featured story from All stories grid",
      "default": true,
      "info": "Prevents the featured story from being duplicated in the grid below on page 1."
    },
    {
      "type": "header",
      "content": "All Stories Grid"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_cards",
      "label": "Show preview placeholder cards if blog has fewer stories",
      "default": true,
      "info": "Displays sample handloom stories in the grid until you publish more blog posts."
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "All stories"
    },
    {
      "type": "checkbox",
      "id": "show_thread_accent",
      "label": "Show red thread accent line",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Stories per page",
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags / category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt text",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "min": 15,
      "max": 45,
      "step": 5,
      "label": "Excerpt word count",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show estimated read time",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Cards"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#57534E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Kicker / accent color",
      "default": "#9A3B46"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
