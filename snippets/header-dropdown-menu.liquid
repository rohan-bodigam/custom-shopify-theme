{% doc %}
  Renders the header menu in the dropdown style with House of Kala Katha luxury card design.

  @param {object} [section] - The current header section context.

  @example
  {% render 'header-dropdown-menu' %}
{% enddoc %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- assign menu_links = section.settings.menu.links -%}
    {%- if menu_links == blank or menu_links.size == 0 -%}
      {%- assign menu_links = linklists['main-menu'].links -%}
    {%- endif -%}

    {%- for link in menu_links -%}
      {%- assign link_title_downcase = link.title | downcase | strip -%}
      {%- assign is_chapters = false -%}
      {%- if link_title_downcase contains 'chapter' or link.handle == 'chapters' -%}
        {%- assign is_chapters = true -%}
      {%- endif -%}

      <li>
        {%- if is_chapters -%}
          {% render 'header-chapters-mega', section: section, link: link %}
        {%- elsif link.links != blank -%}
          <header-menu class="header-menu--dropdown">
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu mega-menu--dropdown">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                aria-expanded="false"
              >
                <span{%- if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                <svg viewBox="0 0 10 6" class="header__chevron icon-caret" fill="none" stroke="currentColor">
                  <path d="M1 1L5 5L9 1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="mega-menu__content mega-menu__content--dropdown color-{{ section.settings.menu_color_scheme | default: 'scheme-1' }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="chapters-dropdown-inner" style="text-align: left;">
                  <div class="chapters-dropdown-header" style="display: flex; justify-content: flex-start; text-align: left;">
                    {%- assign heading_url = link.url -%}
                    {%- if heading_url == blank or heading_url == '#' -%}
                      {%- if link_title_downcase contains 'collection' -%}
                        {%- assign heading_url = '/collections' -%}
                      {%- elsif link_title_downcase contains 'shop' -%}
                        {%- assign heading_url = '/collections/all' -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- if heading_url != blank and heading_url != '#' -%}
                      <a href="{{ heading_url }}" class="mega-heading-link" style="display: inline-flex; justify-content: flex-start; text-align: left;">
                        <span class="mega-dot mega-dot--crimson"></span>ALL {{ link.title | upcase }}
                      </a>
                    {%- else -%}
                      <span class="mega-heading-link" style="display: inline-flex; justify-content: flex-start; text-align: left; cursor: default;">
                        <span class="mega-dot mega-dot--crimson"></span>ALL {{ link.title | upcase }}
                      </span>
                    {%- endif -%}
                  </div>
                  <ul class="mega-list mega-list--regions" role="list">
                    {%- for childlink in link.links -%}
                      {%- assign child_title_down = childlink.title | downcase -%}
                      {%- assign is_soon = false -%}
                      {%- if child_title_down contains 'soon' -%}
                        {%- assign is_soon = true -%}
                      {%- endif -%}
                      {%- assign clean_title = childlink.title | remove: '(Soon)' | remove: 'Soon' | remove: '(soon)' | remove: 'soon' | strip -%}
                      
                      {%- comment -%} Determine artisanal craft dot color {%- endcomment -%}
                      {%- assign dot_color = '#7A8063' -%}
                      {%- if child_title_down contains 'north east' or child_title_down contains 'northeast' -%}
                        {%- assign dot_color = '#8A2B3D' -%}
                      {%- elsif child_title_down contains 'east' -%}
                        {%- assign dot_color = '#7A8063' -%}
                      {%- elsif child_title_down contains 'west' or child_title_down contains 'central' -%}
                        {%- assign dot_color = '#6B2230' -%}
                      {%- elsif child_title_down contains 'north' -%}
                        {%- assign dot_color = '#B08D57' -%}
                      {%- elsif child_title_down contains 'south' -%}
                        {%- assign dot_color = '#2D4F3B' -%}
                      {%- elsif child_title_down contains 'women' -%}
                        {%- assign dot_color = '#8A2B3D' -%}
                      {%- elsif child_title_down contains 'men' -%}
                        {%- assign dot_color = '#7A8063' -%}
                      {%- elsif child_title_down contains 'heritage' -%}
                        {%- assign dot_color = '#6B2230' -%}
                      {%- elsif child_title_down contains 'contemporary' -%}
                        {%- assign dot_color = '#B08D57' -%}
                      {%- elsif child_title_down contains 'kid' -%}
                        {%- assign dot_color = '#2D4F3B' -%}
                      {%- elsif child_title_down contains 'pet' -%}
                        {%- assign dot_color = '#B08D57' -%}
                      {%- else -%}
                        {%- assign color_index = forloop.index0 | modulo: 5 -%}
                        {%- case color_index -%}
                          {%- when 0 -%}
                            {%- assign dot_color = '#7A8063' -%}
                          {%- when 1 -%}
                            {%- assign dot_color = '#6B2230' -%}
                          {%- when 2 -%}
                            {%- assign dot_color = '#B08D57' -%}
                          {%- when 3 -%}
                            {%- assign dot_color = '#2D4F3B' -%}
                          {%- when 4 -%}
                            {%- assign dot_color = '#8A2B3D' -%}
                        {%- endcase -%}
                      {%- endif -%}

                      {%- comment -%} Format word capitalization {%- endcomment -%}
                      {%- assign words = clean_title | split: ' ' -%}
                      {%- capture formatted_title -%}
                        {%- for w in words -%}
                          {%- assign w_low = w | downcase -%}
                          {%- if w_low == 'and' or w_low == '&' or w_low == 'of' or w_low == 'in' -%}
                            {{ w_low }}
                          {%- else -%}
                            {{ w_low | capitalize }}
                          {%- endif -%}
                          {%- unless forloop.last %} {% endunless -%}
                        {%- endfor -%}
                      {%- endcapture -%}

                      {%- if child_title_down contains 'view all' or child_title_down contains 'all ' -%}
                        <li class="mega-view-all">
                          <a href="{{ childlink.url }}" class="mega-all-link">{{ formatted_title | strip | escape }}</a>
                        </li>
                      {%- else -%}
                        <li>
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{{ childlink.url }}"
                            class="mega-region-link{% if childlink.current %} mega-region-link--active{% endif %}"
                            {% if childlink.current %}aria-current="page"{% endif %}
                          >
                            <span class="mega-dot" style="background: {{ dot_color }};"></span>
                            <span class="mega-region-name">{{ formatted_title | strip | escape }}</span>
                            {%- if is_soon -%}<span class="mega-ct-soon">Soon</span>{%- endif -%}
                          </a>
                          {%- if childlink.links != blank -%}
                            <ul class="mega-sublist" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li>
                                  <a
                                    id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                    href="{{ grandchildlink.url }}"
                                    class="mega-sublink{% if grandchildlink.current %} mega-sublink--active{% endif %}"
                                    {% if grandchildlink.current %}aria-current="page"{% endif %}
                                  >
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset{% if link.current %} header__active-menu-item{% endif %}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span>{{ link.title | escape }}</span>
          </a>
        {%- endif -%}
      </li>
    {%- else -%}
      <!-- Fallback preview ONLY if the merchant hasn't created any menu links yet -->
      <li>
        {% render 'header-chapters-mega', section: section %}
      </li>
      <li>
        <a id="HeaderMenu-culture" href="/pages/culture" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Culture</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-shop" href="/collections/all" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Shop</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-journal" href="/blogs/journal" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Journal</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-weavers" href="/pages/weavers" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Weavers</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-services" href="/pages/services" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Services</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-about" href="/pages/about" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>About</span>
        </a>
      </li>
      <li>
        <a id="HeaderMenu-contact" href="/pages/contact" class="header__menu-item list-menu__item link link--text focus-inset">
          <span>Contact</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</nav>
