{% doc %}
  Renders the House of Kala Katha Chapters 3-column Mega Menu dynamically.
  All chapter and collection items are dynamically fetched from Shopify Admin navigation menus.

  @param {object} section - The current header section context.
  @param {object} [link] - The Chapters link from the main menu (optional).
{% enddoc %}

{%- liquid
  # 1. Determine chapters links:
  # Check if child links exist under the main menu's 'Chapters' item in Admin, or a menu with handle 'chapters'
  assign chapters_links = blank
  if link and link.links != blank
    assign chapters_links = link.links
  elsif linklists['chapters'].links.size > 0
    assign chapters_links = linklists['chapters'].links
  endif

  # 2. Determine collections links:
  # Check if a menu with handle 'collections' exists in Admin
  assign collections_links = blank
  if linklists['collections'].links.size > 0
    assign collections_links = linklists['collections'].links
  endif
-%}

<header-menu>
  <details id="Details-HeaderMenu-chapters" class="mega-menu mega-menu--chapters">
    <summary
      id="HeaderMenu-chapters"
      class="header__menu-item list-menu__item link focus-inset"
      aria-expanded="false"
    >
      <span class="header__menu-pill-text">{{ link.title | default: 'Chapters' | escape }}</span>
      <svg viewBox="0 0 10 6" class="header__chevron icon-caret" fill="none" stroke="currentColor">
        <path d="M1 1L5 5L9 1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div
      id="MegaMenu-Content-chapters"
      class="mega-menu__content mega-menu__content--chapters color-{{ section.settings.menu_color_scheme | default: 'scheme-1' }} gradient motion-reduce global-settings-popup"
      tabindex="-1"
    >
      <div class="mega-in mega6 page-width">
        <!-- Column 1: All Chapters -->
        <div class="mega-col mega-col--chapters">
          <h3 class="mega-heading">
            <span class="mega-dot mega-dot--crimson"></span>ALL CHAPTERS
          </h3>
          <ul class="mega-list mega-list--regions" role="list">
            {%- if chapters_links != blank and chapters_links.size > 0 -%}
              {%- for chap in chapters_links -%}
                {%- assign chap_title_down = chap.title | downcase -%}
                {%- assign dot_color = '#B08D57' -%}
                {%- assign is_soon = false -%}
                {%- if chap_title_down contains 'north east' or chap_title_down contains 'northeast' -%}
                  {%- assign dot_color = '#8A2B3D' -%}
                  {%- assign is_soon = true -%}
                {%- elsif chap_title_down contains 'east' -%}
                  {%- assign dot_color = '#7A8063' -%}
                {%- elsif chap_title_down contains 'west' or chap_title_down contains 'central' -%}
                  {%- assign dot_color = '#6B2230' -%}
                {%- elsif chap_title_down contains 'north' -%}
                  {%- assign dot_color = '#B08D57' -%}
                {%- elsif chap_title_down contains 'south' -%}
                  {%- assign dot_color = '#2D4F3B' -%}
                {%- endif -%}

                {%- if chap_title_down contains 'all chapter' or chap_title_down contains 'view all' -%}
                  <li class="mega-view-all">
                    <a href="{{ chap.url }}" class="mega-all-link">{{ chap.title | escape }}</a>
                  </li>
                {%- else -%}
                  <li>
                    <a href="{{ chap.url }}" class="mega-region-link">
                      <span class="mega-dot" style="background: {{ dot_color }};"></span>
                      <span class="mega-region-name">{{ chap.title | escape }}</span>
                      {%- if is_soon -%}<span class="mega-ct-soon">Soon</span>{%- endif -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <!-- Default regional preview if menu not populated yet in admin -->
              <li>
                <a href="/pages/east-india" class="mega-region-link">
                  <span class="mega-dot" style="background:#7A8063;"></span>
                  <span class="mega-region-name">East India</span>
                </a>
              </li>
              <li>
                <a href="/pages/west-central-india" class="mega-region-link">
                  <span class="mega-dot" style="background:#6B2230;"></span>
                  <span class="mega-region-name">West &amp; Central India</span>
                </a>
              </li>
              <li>
                <a href="/pages/north-india" class="mega-region-link">
                  <span class="mega-dot" style="background:#B08D57;"></span>
                  <span class="mega-region-name">North India</span>
                </a>
              </li>
              <li>
                <a href="/pages/south-india" class="mega-region-link">
                  <span class="mega-dot" style="background:#2D4F3B;"></span>
                  <span class="mega-region-name">South India</span>
                </a>
              </li>
              <li>
                <a href="/pages/north-east-india" class="mega-region-link">
                  <span class="mega-dot" style="background:#8A2B3D;"></span>
                  <span class="mega-region-name">North East India</span>
                  <span class="mega-ct-soon">Soon</span>
                </a>
              </li>
              <li class="mega-view-all">
                <a href="/pages/chapters" class="mega-all-link">View All Chapters</a>
              </li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 2: Collections -->
        <div class="mega-col mega-col--collections">
          <h3 class="mega-heading">
            <span class="mega-dot mega-dot--gold"></span>COLLECTIONS
          </h3>
          <ul class="mega-cm-list" role="list">
            {%- if collections_links != blank and collections_links.size > 0 -%}
              {%- for col in collections_links -%}
                {%- assign col_handle = col.title | handle -%}
                <li>
                  <a
                    href="{{ col.url }}"
                    class="mega-cm-link{% if forloop.first %} hot{% endif %}"
                    data-cprev="{{ col_handle }}"
                    data-title="{{ col.title | upcase }}"
                    data-url="{{ col.url }}"
                  >
                    <span class="cm-nm">{{ col.title | escape }}</span>
                    <span class="cm-ar" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                      </svg>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            {%- else -%}
              <!-- Default collections fallback -->
              <li>
                <a
                  href="/collections/heritage"
                  class="mega-cm-link hot"
                  data-cprev="heritage"
                  data-title="HERITAGE"
                  data-sub="Sarees and sets from the five regional chapters."
                  data-url="/collections/heritage"
                >
                  <span class="cm-nm">Heritage</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
              <li>
                <a
                  href="/pages/contemporary"
                  class="mega-cm-link"
                  data-cprev="contemporary"
                  data-title="CONTEMPORARY"
                  data-sub="Many looms, one wardrobe. Shirts, dresses and everyday sets."
                  data-url="/pages/contemporary"
                >
                  <span class="cm-nm">Contemporary</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
              <li>
                <a
                  href="/collections/men"
                  class="mega-cm-link"
                  data-cprev="men"
                  data-title="MEN"
                  data-sub="Shirts, jackets and bundis in handwoven cloth."
                  data-url="/collections/men"
                >
                  <span class="cm-nm">Men</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
              <li>
                <a
                  href="/collections/women"
                  class="mega-cm-link"
                  data-cprev="women"
                  data-title="WOMEN"
                  data-sub="Sarees, dresses and brocade, from many looms."
                  data-url="/collections/women"
                >
                  <span class="cm-nm">Women</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
              <li>
                <a
                  href="/pages/kids"
                  class="mega-cm-link"
                  data-cprev="kids"
                  data-title="KIDS"
                  data-sub="Sibling sets and festive lehengas, soft on skin."
                  data-url="/pages/kids"
                >
                  <span class="cm-nm">Kids</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
              <li>
                <a
                  href="/pages/pet"
                  class="mega-cm-link"
                  data-cprev="pet"
                  data-title="PETS"
                  data-sub="Woven comforts for every companion. Bandanas, coats and mats."
                  data-url="/pages/pet"
                >
                  <span class="cm-nm">Pets</span>
                  <span class="cm-ar" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.8"/>
                    </svg>
                  </span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 3: Featured Preview Card -->
        <div class="mega-col mega-col--feature">
          <a class="cm-feature" id="MegaPreviewCard" href="{{ section.settings.mega_promo_link | default: '/collections/heritage' }}" aria-label="Featured Collection">
            <div class="cm-img on" data-cimg="heritage" style="background-image: url('{{ 'mega-heritage.webp' | asset_url }}');"></div>
            <div class="cm-img" data-cimg="contemporary" style="background-image: url('{{ 'mega-contemporary.webp' | asset_url }}');"></div>
            <div class="cm-img" data-cimg="men" style="background-image: url('{{ 'mega-men.webp' | asset_url }}');"></div>
            <div class="cm-img" data-cimg="women" style="background-image: url('{{ 'mega-women.webp' | asset_url }}');"></div>
            <div class="cm-img" data-cimg="kids" style="background-image: url('{{ 'mega-kids.webp' | asset_url }}');"></div>
            <div class="cm-img" data-cimg="pet" style="background-image: url('{{ 'mega-pet.webp' | asset_url }}');"></div>
            <div class="cm-cap">
              <b id="MegaPreviewHeading">{{ section.settings.mega_promo_heading | default: 'HERITAGE' }}</b>
              <span id="MegaPreviewSubtitle">{{ section.settings.mega_promo_subtext | default: 'Sarees and sets from the five regional chapters.' }}</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </details>
</header-menu>
