{% doc %}
  Renders the House of Kala Katha Chapters dropdown sub menu.
  Completely streamlined without the collections / image preview columns,
  showing the regional chapters and All Chapters link on hover or click.

  @param {object} section - The current header section context.
  @param {object} [link] - The Chapters link from the main menu (optional).
{% enddoc %}

{%- liquid
  # Determine chapters links from Admin navigation or fallback to regional chapters
  assign chapters_links = blank
  if link and link.links != blank
    assign chapters_links = link.links
  elsif linklists['chapters'].links.size > 0
    assign chapters_links = linklists['chapters'].links
  endif
-%}

<header-menu class="header-menu--chapters">
  <details id="Details-HeaderMenu-chapters" class="mega-menu mega-menu--chapters">
    <summary
      id="HeaderMenu-chapters"
      class="header__menu-item list-menu__item link focus-inset"
      aria-expanded="false"
    >
      <span class="header__menu-pill-text">{{ link.title | default: 'Chapters' | escape }}</span>
      <svg viewBox="0 0 10 6" class="header__chevron icon-caret" fill="none" stroke="currentColor">
        <path d="M1 1L5 5L9 1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div
      id="MegaMenu-Content-chapters"
      class="mega-menu__content mega-menu__content--chapters color-{{ section.settings.menu_color_scheme | default: 'scheme-1' }} gradient motion-reduce global-settings-popup"
      tabindex="-1"
    >
      <div class="chapters-dropdown-inner">
        <div class="chapters-dropdown-header">
          <a href="/pages/culture" class="mega-heading-link">
            <span class="mega-dot mega-dot--crimson"></span>ALL CHAPTERS
          </a>
        </div>
        <ul class="mega-list mega-list--regions" role="list">
          {%- if chapters_links != blank and chapters_links.size > 0 -%}
            {%- for chap in chapters_links -%}
              {%- assign chap_title_down = chap.title | downcase -%}
              {%- assign dot_color = '#B08D57' -%}
              {%- assign is_soon = false -%}
              {%- if chap_title_down contains 'north east' or chap_title_down contains 'northeast' -%}
                {%- assign dot_color = '#8A2B3D' -%}
                {%- assign is_soon = true -%}
              {%- elsif chap_title_down contains 'east' -%}
                {%- assign dot_color = '#7A8063' -%}
              {%- elsif chap_title_down contains 'west' or chap_title_down contains 'central' -%}
                {%- assign dot_color = '#6B2230' -%}
              {%- elsif chap_title_down contains 'north' -%}
                {%- assign dot_color = '#B08D57' -%}
              {%- elsif chap_title_down contains 'south' -%}
                {%- assign dot_color = '#2D4F3B' -%}
              {%- endif -%}

              {%- if chap_title_down contains 'all chapter' or chap_title_down contains 'view all' -%}
                <li class="mega-view-all">
                  <a href="{{ chap.url }}" class="mega-all-link">{{ chap.title | escape }}</a>
                </li>
              {%- else -%}
                <li>
                  <a href="{{ chap.url }}" class="mega-region-link">
                    <span class="mega-dot" style="background: {{ dot_color }};"></span>
                    <span class="mega-region-name">{{ chap.title | escape }}</span>
                    {%- if is_soon -%}<span class="mega-ct-soon">Soon</span>{%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Default regional preview if menu not populated yet in admin -->
            <li>
              <a href="/pages/east-india" class="mega-region-link">
                <span class="mega-dot" style="background:#7A8063;"></span>
                <span class="mega-region-name">East India</span>
              </a>
            </li>
            <li>
              <a href="/pages/west-central-india" class="mega-region-link">
                <span class="mega-dot" style="background:#6B2230;"></span>
                <span class="mega-region-name">West &amp; Central India</span>
              </a>
            </li>
            <li>
              <a href="/pages/north-india" class="mega-region-link">
                <span class="mega-dot" style="background:#B08D57;"></span>
                <span class="mega-region-name">North India</span>
              </a>
            </li>
            <li>
              <a href="/pages/south-india" class="mega-region-link">
                <span class="mega-dot" style="background:#2D4F3B;"></span>
                <span class="mega-region-name">South India</span>
              </a>
            </li>
            <li>
              <a href="/pages/north-east-india" class="mega-region-link">
                <span class="mega-dot" style="background:#8A2B3D;"></span>
                <span class="mega-region-name">North East India</span>
                <span class="mega-ct-soon">Soon</span>
              </a>
            </li>
            <li class="mega-view-all">
              <a href="/pages/culture" class="mega-all-link">View All Chapters</a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </details>
</header-menu>
