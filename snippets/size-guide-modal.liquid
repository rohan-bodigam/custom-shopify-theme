{% comment %}
  House of Kala Katha - Dual Size Guide Modal (Women's Size Chart & Men's Size Guide)
  Includes both interactive tables and the high-resolution reference chart images.
{% endcomment %}

{%- liquid
  assign is_men = false

  # 1. Product Metafields
  assign made_for = product.metafields.custom.made_for | downcase
  if made_for contains 'men'
    unless made_for contains 'women'
      assign is_men = true
    endunless
  endif

  # 2. Product Collections
  for col in product.collections
    assign col_name = col.title | downcase
    if col_name == 'men' or col_name contains "men's" or col_name contains 'mens' or col.handle contains 'men'
      assign is_men = true
    endif
  endfor

  # 3. Product Tags
  for t in product.tags
    assign t_lower = t | downcase
    if t_lower == 'men' or t_lower == 'mens' or t_lower == "men's" or t_lower contains 'kurta' or t_lower contains 'dhoti' or t_lower contains 'pancha' or t_lower contains 'sherwani'
      assign is_men = true
    endif
  endfor

  # 4. Product Type
  assign p_type = product.type | downcase
  if p_type contains 'men' or p_type contains 'kurta' or p_type contains 'dhoti' or p_type contains 'pancha' or p_type contains 'sherwani' or p_type contains 'bundi'
    assign is_men = true
  endif

  # 5. Product Title
  assign p_title = product.title | downcase
  if p_title contains 'dhoti' or p_title contains 'pancha' or p_title contains 'kurta' or p_title contains 'bundi' or p_title contains "men's" or p_title contains 'mens'
    assign is_men = true
  endif
-%}

<style>
  body.hokk-modal-locked {
    overflow: hidden !important;
    touch-action: none !important;
  }

  /* Modal Overlay - Hidden by default */
  .hokk-size-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 9999999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 16px !important;
    background: rgba(23, 23, 23, 0.72) !important;
    backdrop-filter: blur(5px) !important;
    -webkit-backdrop-filter: blur(5px) !important;
  }

  .hokk-size-modal.is-open {
    display: flex !important;
  }

  .hokk-size-modal__backdrop {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  /* Modal Dialog Box */
  .hokk-size-modal__dialog {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 660px;
    max-height: 90vh;
    background: #FAF6F0;
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(197, 168, 128, 0.35);
  }

  /* Close Button */
  .hokk-size-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 30;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.12);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }

  .hokk-size-modal__close:hover {
    background: #4A1525;
    color: #FFFFFF;
    transform: scale(1.06);
  }

  /* Top Gender Switcher */
  .hokk-size-modal__gender-bar {
    display: flex;
    background: #ECE4D6;
    border-bottom: 1px solid #DFD4C2;
    padding: 5px;
    border-radius: 12px 12px 0 0;
    padding-right: 56px; /* Space for close button */
  }

  .hokk-gender-tab {
    flex: 1;
    padding: 10px 14px;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7A6F62;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;
    white-space: nowrap;
    text-align: center;
  }

  .hokk-gender-tab.is-active {
    background: #FFFFFF;
    color: #4A1525;
    box-shadow: 0 2px 8px rgba(74, 21, 37, 0.1);
  }

  /* Sub-tabs / View Toggle (Image vs Table) */
  .hokk-view-switcher {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 10px 20px 0;
    background: #FAF6F0;
  }

  .hokk-view-tab {
    background: #EFE7DA;
    border: 1px solid #DCD1C0;
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #665D52;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hokk-view-tab.is-active {
    background: #4A1525;
    border-color: #4A1525;
    color: #FFFFFF;
  }

  /* Image View Container */
  .hokk-sg-image-view {
    display: none;
    padding: 14px;
    text-align: center;
    background: #FAF6F0;
  }

  .hokk-sg-image-view.is-active {
    display: block;
  }

  .hokk-sg-image-view img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    display: block;
    margin: 0 auto;
  }

  /* Pane Management */
  .hokk-size-pane {
    display: none;
  }

  .hokk-size-pane.is-active {
    display: block;
  }

  /* Diamond Border Patterns */
  .hokk-sg-diamonds {
    text-align: center;
    background: #4A1525;
    color: #C5A880;
    font-size: 7px;
    letter-spacing: 3px;
    line-height: 1.4;
    padding: 5px 8px;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
  }

  .hokk-sg-diamonds--bottom {
    background: transparent;
    color: #C5A880;
    margin-top: 18px;
  }

  /* ==========================================================================
     1. WOMEN'S SIZE CHART (Screenshot 1 Styling)
     ========================================================================== */

  .hokk-wsg-header {
    background: #4A1525;
    color: #FFFFFF;
    text-align: center;
    padding: 24px 20px 20px;
  }

  .hokk-wsg-eyebrow {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C5A880;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .hokk-wsg-title {
    font-family: var(--font-heading-family, 'Playfair Display', Georgia, serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 6px;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .hokk-wsg-subtitle {
    display: block;
    font-size: 0.95rem;
    color: #E0CDAF;
    font-style: italic;
    font-weight: 300;
  }

  .hokk-wsg-body {
    padding: 24px;
    background: #FAF6F0;
  }

  .hokk-wsg-headline-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .hokk-wsg-body-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #3A1420;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Table Wrapping & Base Styles */
  .hokk-sg-table-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 8px;
  }

  .hokk-wsg-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid #4A1525;
    border-radius: 8px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .hokk-wsg-table thead tr {
    background: #4A1525;
  }

  .hokk-wsg-table thead th {
    color: #FFFFFF;
    padding: 12px 14px;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    border: none;
  }

  .hokk-wsg-table tbody tr:nth-child(odd) {
    background: #F5EEE5;
  }

  .hokk-wsg-table tbody tr:nth-child(even) {
    background: #FFFFFF;
  }

  .hokk-wsg-table tbody td {
    padding: 10px 14px;
    text-align: center;
    font-size: 0.9rem;
    color: #2A2A2A;
    border-bottom: 1px solid rgba(74, 21, 37, 0.06);
    font-variant-numeric: tabular-nums;
  }

  .hokk-wsg-table tbody td.cell-size {
    font-weight: 800;
    color: #4A1525;
    font-size: 0.95rem;
  }

  .hokk-wsg-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* How to Measure Card */
  .hokk-wsg-measure-card {
    margin-top: 20px;
    background: #F0E7DB;
    border-radius: 10px;
    padding: 18px 20px;
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: center;
    border: 1px solid rgba(74, 21, 37, 0.08);
  }

  .hokk-wsg-figure {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hokk-wsg-mannequin {
    width: 100%;
    max-width: 100px;
    height: auto;
    display: block;
  }

  .hokk-wsg-instructions-title {
    font-family: var(--font-heading-family, 'Playfair Display', Georgia, serif);
    font-size: 1.4rem;
    color: #3A1420;
    margin: 0 0 10px;
    font-weight: 500;
  }

  .hokk-wsg-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hokk-wsg-points li {
    font-size: 0.85rem;
    color: #3A1420;
    line-height: 1.45;
    display: block;
  }

  .hokk-wsg-points .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
  }

  .hokk-wsg-points .dot--bust {
    background: #8B264A;
  }

  .hokk-wsg-points .dot--waist {
    background: #9E7634;
  }

  .hokk-wsg-points .dot--hips {
    background: #2B6655;
  }

  .hokk-wsg-points strong {
    font-weight: 700;
    color: #3A1420;
  }

  .hokk-wsg-points p {
    margin: 2px 0 0 14px;
    color: #665;
    font-size: 0.8rem;
  }

  /* ==========================================================================
     2. MEN'S SIZE GUIDE (Screenshot 2 Styling)
     ========================================================================== */

  .hokk-msg-tabs {
    display: flex;
    gap: 24px;
    border-bottom: 1px solid #E5E0D8;
    padding: 16px 24px 0;
    background: #FAF6F0;
  }

  .hokk-msg-tab {
    background: none;
    border: none;
    padding: 8px 0 12px;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8C8478;
    cursor: pointer;
    position: relative;
    transition: color 0.2s;
  }

  .hokk-msg-tab.is-active {
    color: #171717;
  }

  .hokk-msg-tab.is-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: #6B2230;
  }

  .hokk-msg-subpane {
    padding: 22px 24px 24px;
    display: none;
  }

  .hokk-msg-subpane.is-active {
    display: block;
  }

  .hokk-msg-intro {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #4A4641;
    margin: 0 0 18px;
  }

  .hokk-msg-controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .hokk-toggle-group {
    display: inline-flex;
    border: 1px solid #D6CEC1;
    border-radius: 4px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .hokk-toggle-group--small .hokk-toggle-btn {
    padding: 4px 10px;
    font-size: 0.68rem;
  }

  .hokk-toggle-btn {
    background: #FFFFFF;
    border: none;
    padding: 6px 14px;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #555047;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hokk-toggle-btn.is-active {
    background: #171717;
    color: #FFFFFF;
  }

  .hokk-msg-section {
    margin-bottom: 24px;
  }

  .hokk-msg-section:last-child {
    margin-bottom: 0;
  }

  .hokk-msg-section-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #555047;
    margin: 0 0 10px;
  }

  .hokk-msg-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    background: #FFFFFF;
    border: 1px solid #E5DFD4;
    border-radius: 6px;
    overflow: hidden;
  }

  .hokk-msg-table th,
  .hokk-msg-table td {
    padding: 10px 12px;
    text-align: center;
    border-bottom: 1px solid #EFEAE1;
    border-right: 1px solid #F5F1E8;
    font-variant-numeric: tabular-nums;
  }

  .hokk-msg-table th {
    background: #F7F3EA;
    font-weight: 700;
    color: #171717;
    font-size: 0.84rem;
  }

  .hokk-msg-table td.row-label {
    text-align: left;
    font-weight: 600;
    color: #242220;
    background: #FAF7F0;
    width: 25%;
  }

  .hokk-msg-table tr:last-child td {
    border-bottom: none;
  }

  .hokk-msg-table td:last-child,
  .hokk-msg-table th:last-child {
    border-right: none;
  }

  /* Measuring Guides Grid */
  .hokk-msg-measure-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .hokk-measure-item {
    background: #FFFFFF;
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid #E5DFD4;
  }

  .hokk-measure-item h4 {
    margin: 0 0 6px;
    font-size: 0.9rem;
    color: #6B2230;
    font-weight: 700;
  }

  .hokk-measure-item p {
    margin: 0;
    font-size: 0.82rem;
    color: #555047;
    line-height: 1.45;
  }

  /* FAQs List */
  .hokk-faqs-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hokk-faq-item {
    background: #FFFFFF;
    padding: 14px 18px;
    border-radius: 8px;
    border: 1px solid #E5DFD4;
  }

  .hokk-faq-item h4 {
    margin: 0 0 6px;
    font-size: 0.88rem;
    color: #171717;
    font-weight: 700;
  }

  .hokk-faq-item p {
    margin: 0;
    font-size: 0.82rem;
    color: #555047;
    line-height: 1.5;
  }

  /* ==========================================================================
     Mobile Responsive Adjustments (< 600px)
     ========================================================================== */
  @media screen and (max-width: 600px) {
    .hokk-size-modal {
      padding: 8px !important;
      align-items: flex-end !important;
    }

    .hokk-size-modal__dialog {
      max-height: 88vh;
      border-radius: 14px 14px 0 0;
    }

    .hokk-size-modal__gender-bar {
      padding-right: 48px;
    }

    .hokk-gender-tab {
      font-size: 0.74rem;
      padding: 8px 4px;
    }

    .hokk-wsg-header {
      padding: 18px 14px 14px;
    }

    .hokk-wsg-title {
      font-size: 1.75rem;
    }

    .hokk-wsg-body {
      padding: 16px 14px;
    }

    .hokk-wsg-measure-card {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 14px;
    }

    .hokk-wsg-figure {
      max-height: 110px;
    }

    .hokk-msg-tabs {
      gap: 14px;
      padding: 12px 14px 0;
    }

    .hokk-msg-tab {
      font-size: 0.75rem;
      padding-bottom: 8px;
    }

    .hokk-msg-subpane {
      padding: 16px 14px;
    }

    .hokk-msg-table th,
    .hokk-msg-table td,
    .hokk-wsg-table th,
    .hokk-wsg-table td {
      padding: 8px 6px;
      font-size: 0.78rem;
    }

    .hokk-msg-table td.row-label {
      width: 30%;
      font-size: 0.76rem;
    }
  }
</style>

<div id="hokkSizeModal" class="hokk-size-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="hokk-size-modal__backdrop" data-close-modal onclick="window.hokkCloseSizeGuide && window.hokkCloseSizeGuide(event)"></div>
  <div class="hokk-size-modal__dialog" role="document">
    <button
      type="button"
      class="hokk-size-modal__close"
      data-close-modal
      aria-label="Close size guide"
      onclick="window.hokkCloseSizeGuide && window.hokkCloseSizeGuide(event)"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {% comment %} Top Gender Switcher {% endcomment %}
    <div class="hokk-size-modal__gender-bar">
      <button
        type="button"
        class="hokk-gender-tab{% unless is_men %} is-active{% endunless %}"
        data-target="women"
      >
        Women’s Size Chart
      </button>
      <button
        type="button"
        class="hokk-gender-tab{% if is_men %} is-active{% endif %}"
        data-target="men"
      >
        Men’s Size Guide
      </button>
    </div>

    {% comment %} ========================================================= {% endcomment %}
    {% comment %} 1. WOMEN'S SIZE CHART (Screenshot 1 Reference)           {% endcomment %}
    {% comment %} ========================================================= {% endcomment %}
    <div id="hokkSizePaneWomen" class="hokk-size-pane{% unless is_men %} is-active{% endunless %}">
      {% comment %} View Mode Switcher: Interactive Table vs Graphic Chart {% endcomment %}
      <div class="hokk-view-switcher">
        <button type="button" class="hokk-view-tab is-active" data-view-target="women-table">Interactive Table</button>
        <button type="button" class="hokk-view-tab" data-view-target="women-image">View Original Chart</button>
      </div>

      {% comment %} 1.A Interactive HTML Table {% endcomment %}
      <div id="hokkWomenTableView" class="hokk-sg-table-view">
        {% comment %} Top decorative diamond pattern {% endcomment %}
        <div class="hokk-sg-diamonds">
          <span>◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆</span>
        </div>

        {% comment %} Maroon Brand Header Banner {% endcomment %}
        <div class="hokk-wsg-header">
          <span class="hokk-wsg-eyebrow">HOUSE OF KALA KATHA</span>
          <h2 class="hokk-wsg-title">Women’s Size Chart</h2>
          <span class="hokk-wsg-subtitle">Contemporary Collection</span>
        </div>

        {% comment %} Bottom decorative diamond pattern {% endcomment %}
        <div class="hokk-sg-diamonds">
          <span>◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆</span>
        </div>

        {% comment %} Body Container {% endcomment %}
        <div class="hokk-wsg-body">
          <div class="hokk-wsg-headline-row">
            <h3 class="hokk-wsg-body-heading">Body measurements in <span class="hokk-wsg-current-unit">inches</span></h3>
            <div class="hokk-toggle-group hokk-toggle-group--small">
              <button type="button" class="hokk-toggle-btn is-active" data-unit="in">INCHES</button>
              <button type="button" class="hokk-toggle-btn" data-unit="cm">CM</button>
            </div>
          </div>

          {% comment %} Women's Measurements Table {% endcomment %}
          <div class="hokk-sg-table-wrap">
            <table class="hokk-wsg-table">
              <thead>
                <tr>
                  <th>SIZE</th>
                  <th>BUST</th>
                  <th>WAIST</th>
                  <th>HIPS</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="cell-size">XS</td>
                  <td data-in="32–33" data-cm="81–84">32–33</td>
                  <td data-in="23–24" data-cm="58–61">23–24</td>
                  <td data-in="34–35" data-cm="86–89">34–35</td>
                </tr>
                <tr>
                  <td class="cell-size">S</td>
                  <td data-in="34–35" data-cm="86–89">34–35</td>
                  <td data-in="25–26" data-cm="63–66">25–26</td>
                  <td data-in="36–37" data-cm="91–94">36–37</td>
                </tr>
                <tr>
                  <td class="cell-size">M</td>
                  <td data-in="36–38" data-cm="91–96">36–38</td>
                  <td data-in="27–28" data-cm="68–71">27–28</td>
                  <td data-in="38–39" data-cm="96–99">38–39</td>
                </tr>
