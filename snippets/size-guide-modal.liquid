<script>
  (function() {
    function initSizeGuideModal() {
      const modal = document.getElementById('hokkSizeModal');
      const openBtn = document.getElementById('openSizeGuideBtn');
      if (!modal) return;

      const closeButtons = modal.querySelectorAll('[data-close-modal]');
      const genderTabs = modal.querySelectorAll('.hokk-gender-tab');
      const paneWomen = document.getElementById('hokkSizePaneWomen');
      const paneMen = document.getElementById('hokkSizePaneMen');

      function openModal() {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('hokk-modal-locked');
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('hokk-modal-locked');
      }

      if (openBtn) {
        openBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          openModal();
        });
      }

      closeButtons.forEach(btn => {
        btn.addEventListener('click', closeModal);
      });

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          closeModal();
        }
      });

      // Gender Switcher Tabs
      genderTabs.forEach(tab => {
        tab.addEventListener('click', function() {
          genderTabs.forEach(t => t.classList.remove('is-active'));
          this.classList.add('is-active');

          const target = this.dataset.target;
          if (target === 'women') {
            paneWomen.classList.add('is-active');
            paneMen.classList.remove('is-active');
          } else {
            paneWomen.classList.remove('is-active');
            paneMen.classList.add('is-active');
          }
        });
      });

      // Women's unit toggle (Inches <-> CM)
      const wUnitButtons = paneWomen.querySelectorAll('.hokk-toggle-btn[data-unit]');
      const wCurrentUnitText = paneWomen.querySelector('.hokk-wsg-current-unit');
      const wCells = paneWomen.querySelectorAll('td[data-in]');

      wUnitButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          wUnitButtons.forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');
          const unit = this.dataset.unit;
          if (wCurrentUnitText) wCurrentUnitText.textContent = unit === 'cm' ? 'centimetres' : 'inches';

          wCells.forEach(cell => {
            cell.textContent = unit === 'cm' ? cell.dataset.cm : cell.dataset.in;
          });
        });
      });

      // Men's sub-navigation tabs (Size Guide | How to Measure | FAQs)
      const menTabs = paneMen.querySelectorAll('.hokk-msg-tab');
      const menSubGuide = document.getElementById('hokkMenSubGuide');
      const menSubMeasure = document.getElementById('hokkMenSubMeasure');
      const menSubFaqs = document.getElementById('hokkMenSubFaqs');

      menTabs.forEach(tab => {
        tab.addEventListener('click', function() {
          menTabs.forEach(t => t.classList.remove('is-active'));
          this.classList.add('is-active');

          const target = this.dataset.menTab;
          if (menSubGuide) menSubGuide.classList.toggle('is-active', target === 'guide');
          if (menSubMeasure) menSubMeasure.classList.toggle('is-active', target === 'measure');
          if (menSubFaqs) menSubFaqs.classList.toggle('is-active', target === 'faqs');
        });
      });

      // Men's Unit Toggle (Inches vs CM)
      const mUnitButtons = paneMen.querySelectorAll('#hokkMenUnitToggle .hokk-toggle-btn');
      const mFitButtons = paneMen.querySelectorAll('#hokkMenFitToggle .hokk-toggle-btn');
      let currentMenUnit = 'in';
      let currentMenFit = 'garment';

      function updateMenTables() {
        const tables = paneMen.querySelectorAll('.hokk-msg-table');
        tables.forEach(table => {
          const cells = table.querySelectorAll('td[data-in]');
          cells.forEach(cell => {
            if (currentMenFit === 'body' && cell.dataset.bodyIn) {
              cell.textContent = currentMenUnit === 'cm' ? cell.dataset.bodyCm : cell.dataset.bodyIn;
            } else {
              cell.textContent = currentMenUnit === 'cm' ? cell.dataset.cm : cell.dataset.in;
            }
          });
        });
      }

      mUnitButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          mUnitButtons.forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');
          currentMenUnit = this.dataset.unit;
          updateMenTables();
        });
      });

      mFitButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          mFitButtons.forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');
          currentMenFit = this.dataset.fit;
          updateMenTables();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSizeGuideModal);
    } else {
      initSizeGuideModal();
    }
  })();
</script>
