{% comment %}
  House of Kala Katha - Dual Size Guide Modal (Women's Size Chart & Men's Size Guide)
  Auto-detects gender from product metadata, collections, tags, or product type.
{% endcomment %}

{%- liquid
  assign is_men = false

  # 1. Product Metafields
  assign made_for = product.metafields.custom.made_for | downcase
  if made_for contains 'men' and made_for contains 'women' == false
    assign is_men = true
  endif

  # 2. Product Collections
  for col in product.collections
    assign col_name = col.title | downcase
    if col_name == 'men' or col_name contains "men's" or col_name contains 'mens' or col.handle contains 'men'
      assign is_men = true
    endif
  endfor

  # 3. Product Tags
  for t in product.tags
    assign t_lower = t | downcase
    if t_lower == 'men' or t_lower == 'mens' or t_lower == "men's" or t_lower contains 'kurta' or t_lower contains 'dhoti' or t_lower contains 'pancha' or t_lower contains 'sherwani'
      assign is_men = true
    endif
  endfor

  # 4. Product Type
  assign p_type = product.type | downcase
  if p_type contains 'men' or p_type contains 'kurta' or p_type contains 'dhoti' or p_type contains 'pancha' or p_type contains 'sherwani' or p_type contains 'bundi'
    assign is_men = true
  endif

  # 5. Product Title
  assign p_title = product.title | downcase
  if p_title contains 'dhoti' or p_title contains 'pancha' or p_title contains 'kurta' or p_title contains 'bundi' or p_title contains "men's" or p_title contains 'mens'
    assign is_men = true
  endif
-%}

